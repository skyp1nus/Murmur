{
  "$description": "Murmur design tokens (ElevenLabs-inspired warm editorial style). Source of truth for Avalonia resources.",
  "color": {
    "canvas": "#fdfcfc",
    "surface": "#f5f3f1",
    "stone": "#ebe8e4",
    "ink": "#000000",
    "graphite": "#44403b",
    "smoke": "#777169",
    "ash": "#a59f97",
    "buttonBorder": "#e5e5e5",
    "accentViolet": "#0447ff",
    "accentEmber": "#ff4704"
  },
  "accentUsage": "accentViolet and accentEmber are for the recording orb and icons only — never buttons, links, text or borders.",
  "font": {
    "display": { "family": "Inter", "weight": 300, "letterSpacingEm": -0.02 },
    "body": { "family": "Inter", "weights": [400, 500], "letterSpacingEm": 0.01 },
    "mono": { "family": "Geist Mono", "weight": 400, "size": 13, "lineHeight": 1.69 }
  },
  "typeScale": {
    "caption": { "size": 10, "lineHeight": 1.6 },
    "bodySm": { "size": 14, "lineHeight": 1.5 },
    "body": { "size": 16, "lineHeight": 1.5 },
    "subheading": { "size": 18, "lineHeight": 1.6 },
    "bodyLg": { "size": 20, "lineHeight": 1.35 },
    "headingSm": { "size": 32, "lineHeight": 1.13 },
    "heading": { "size": 36, "lineHeight": 1.17 },
    "display": { "size": 48, "lineHeight": 1.08 }
  },
  "spacing": [4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 96],
  "radius": {
    "input": 4,
    "small": 8,
    "card": 20,
    "cardLarge": 24,
    "pill": 9999
  },
  "border": { "hairline": { "width": 1, "color": "stone" } },
  "shadow": {
    "subtle": "0 0 1px rgba(0,0,0,0.4), 0 1px 1px rgba(0,0,0,0.04), 0 2px 4px rgba(0,0,0,0.04)"
  }
}
