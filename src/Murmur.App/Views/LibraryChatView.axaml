<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Murmur.App.ViewModels"
             xmlns:views="using:Murmur.App.Views"
             x:Class="Murmur.App.Views.LibraryChatView"
             x:DataType="vm:LibraryChatViewModel">

  <!-- The Ask AI page of the canvas: the scope pills and the model chip are in the top bar, the page is the conversation of the chat in view. -->
  <views:ConversationView DataContext="{Binding Chat}" />
</UserControl>
