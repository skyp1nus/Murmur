<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Murmur.App.ViewModels"
        xmlns:views="using:Murmur.App.Views"
        x:Class="Murmur.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="Murmur"
        Icon="/Assets/murmur.ico"
        Width="{StaticResource Size.WindowWidth}"
        Height="{StaticResource Size.WindowHeight}"
        MinWidth="{StaticResource Size.WindowMinWidth}"
        MinHeight="{StaticResource Size.WindowMinHeight}">

  <!-- Navigation: the shell exposes the current page view model; templates are keyed by its type (no reflection). -->
  <Window.DataTemplates>
    <DataTemplate DataType="vm:LibraryViewModel">
      <views:LibraryView />
    </DataTemplate>
    <DataTemplate DataType="vm:RecordingViewModel">
      <views:RecordingView />
    </DataTemplate>
    <DataTemplate DataType="vm:SessionViewModel">
      <views:SessionView />
    </DataTemplate>
    <DataTemplate DataType="vm:LibraryChatViewModel">
      <views:LibraryChatView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="vm:SidebarViewModel">
      <views:SidebarView />
    </DataTemplate>
    <DataTemplate DataType="vm:OnboardingViewModel">
      <views:OnboardingView />
    </DataTemplate>
    <DataTemplate DataType="vm:StatusBarViewModel">
      <views:StatusBarView />
    </DataTemplate>

    <!-- The top bar's two sides: a screen puts any of these (or its own template, added here) in TopBar.Leading / TopBar.Trailing. -->
    <DataTemplate DataType="vm:BreadcrumbViewModel">
      <views:BreadcrumbView />
    </DataTemplate>
    <DataTemplate DataType="vm:HotkeyHintViewModel">
      <views:HotkeyHintView />
    </DataTemplate>
    <DataTemplate DataType="vm:SessionActionsViewModel">
      <views:SessionActionsView />
    </DataTemplate>
    <DataTemplate DataType="vm:ChatScopeViewModel">
      <views:ChatScopeView />
    </DataTemplate>
    <DataTemplate DataType="vm:ChatModelChipViewModel">
      <views:ChatModelChipView />
    </DataTemplate>
  </Window.DataTemplates>

  <Grid ColumnDefinitions="Auto,*">
    <!-- The left navigation on every main screen; null (nothing shown) during the onboarding. -->
    <ContentControl Grid.Column="0"
                    VerticalContentAlignment="Stretch"
                    Content="{Binding Sidebar}" />

    <Grid x:Name="ContentArea"
          Grid.Column="1"
          RowDefinitions="Auto,*,Auto">
      <!-- The 48 px top bar of the main screens -->
      <Border Grid.Row="0"
              IsVisible="{Binding !IsOnboarding}">
        <views:TopBarView DataContext="{Binding TopBar}" />
      </Border>

      <!-- The page. Pages not yet redrawn after the canvas keep the 48 px inset of the old frame (PageUsesFrameInset). -->
      <ContentControl Grid.Row="1"
                      Classes="page"
                      Classes.fullWindow="{Binding IsOnboarding}"
                      Classes.inset="{Binding PageUsesFrameInset}"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch"
                      Content="{Binding CurrentPage}" />

      <!-- The 28 px status bar under every page; nothing when the shell has none. -->
      <ContentControl Grid.Row="2"
                      HorizontalContentAlignment="Stretch"
                      Content="{Binding StatusBar}" />

      <!-- Files dragged over the window (#69): over the whole content area, never in the way of the pointer. -->
      <views:DropOverlayView Grid.Row="0"
                             Grid.RowSpan="3"
                             DataContext="{Binding DropOverlay}" />
    </Grid>
  </Grid>
</Window>
