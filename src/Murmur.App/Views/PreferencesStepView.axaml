<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Murmur.App.ViewModels"
             xmlns:res="using:Murmur.App.Resources"
             x:Class="Murmur.App.Views.PreferencesStepView"
             x:DataType="vm:PreferencesStepViewModel">

  <!-- Step 4: one card with four rows; every change is saved at once, like in the Settings. -->
  <StackPanel HorizontalAlignment="Stretch"
              Spacing="{StaticResource Space.32}">

    <StackPanel Spacing="{StaticResource Space.12}"
                HorizontalAlignment="Center">
      <TextBlock Classes="heading onbHeadline"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 Text="{Binding Title}" />
      <TextBlock Classes="body"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource Brush.Smoke}"
                 Text="{Binding Subtitle}" />
    </StackPanel>

    <Border Classes="panel"
            MaxWidth="{StaticResource Size.OnbPreferencesWidth}"
            HorizontalAlignment="Stretch">
      <StackPanel>

        <!-- Transcription language: only "Auto-detect" for now. -->
        <Grid x:Name="LanguageRow"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="{StaticResource Space.24}"
              Margin="{StaticResource Inset.Row}">
          <StackPanel VerticalAlignment="Center"
                      Spacing="{StaticResource Space.4}">
            <TextBlock Classes="body"
                       FontWeight="{StaticResource FontWeight.BodyMedium}"
                       Text="{x:Static res:Strings.Onb4_Language}" />
            <TextBlock Classes="bodySm"
                       Foreground="{DynamicResource Brush.Smoke}"
                       Text="{x:Static res:Strings.Onb4_LanguageText}" />
          </StackPanel>
          <ComboBox x:Name="LanguageBox"
                    Grid.Column="1"
                    Width="{StaticResource Size.OnbPickerWidth}"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding Languages}"
                    SelectedIndex="0" />
        </Grid>

        <Border Classes="divider" />

        <!-- Recordings folder: the path, the free space of its drive and "Change". -->
        <Grid x:Name="FolderRow"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="{StaticResource Space.24}"
              Margin="{StaticResource Inset.Row}">
          <StackPanel VerticalAlignment="Center"
                      Spacing="{StaticResource Space.4}">
            <TextBlock Classes="body"
                       FontWeight="{StaticResource FontWeight.BodyMedium}"
                       Text="{x:Static res:Strings.Onb4_Folder}" />
            <TextBlock x:Name="FolderPath"
                       Classes="mono"
                       Foreground="{DynamicResource Brush.Graphite}"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding Storage.EffectivePath}" />
            <TextBlock Classes="note"
                       Foreground="{DynamicResource Brush.Graphite}"
                       IsVisible="{Binding Storage.HasError}"
                       Text="{Binding Storage.Error}" />
          </StackPanel>
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="{StaticResource Space.12}"
                      VerticalAlignment="Center">
            <TextBlock x:Name="FolderFreeSpace"
                       Classes="mono"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Smoke}"
                       IsVisible="{Binding HasFreeSpace}"
                       Text="{Binding FreeSpaceText}" />
            <Button x:Name="ChangeFolderButton"
                    Classes="outline compact"
                    Content="{x:Static res:Strings.Storage_Change}"
                    Command="{Binding Storage.ChangeCommand}" />
          </StackPanel>
        </Grid>

        <StackPanel x:Name="HotkeySection"
                    IsVisible="{Binding HasHotkey}">
          <Border Classes="divider" />

          <!-- Start / stop hotkey: the row text is the canvas wording; clicking the field starts the capture of a new combination. -->
          <Grid x:Name="HotkeyRow"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="{StaticResource Space.24}"
                Margin="{StaticResource Inset.Row}">
            <StackPanel VerticalAlignment="Center"
                        Spacing="{StaticResource Space.4}">
              <TextBlock Classes="body"
                         FontWeight="{StaticResource FontWeight.BodyMedium}"
                         Text="{x:Static res:Strings.Onb4_Hotkey}" />
              <TextBlock Classes="bodySm"
                         Foreground="{DynamicResource Brush.Smoke}"
                         Text="{x:Static res:Strings.Onb4_HotkeyText}" />
              <TextBlock Classes="note"
                         Foreground="{DynamicResource Brush.Graphite}"
                         IsVisible="{Binding HotkeyRow.HasError}"
                         Text="{Binding HotkeyRow.Error}" />
              <TextBlock Classes="note"
                         IsVisible="{Binding HotkeyRow.ShowRegistrationNote}"
                         Text="{Binding HotkeyRow.RegistrationNote}" />
            </StackPanel>
            <Button x:Name="HotkeyField"
                    Grid.Column="1"
                    Classes="hotkeyField"
                    Classes.capturing="{Binding HotkeyRow.IsCapturing}"
                    Command="{Binding HotkeyRow.CaptureCommand}">
              <Panel>
                <ItemsControl x:Name="HotkeyCaps"
                              VerticalAlignment="Center"
                              IsVisible="{Binding ShowCaps}"
                              ItemsSource="{Binding Caps}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal"
                                  Spacing="{StaticResource Space.8}" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HotkeyCap">
                      <StackPanel Orientation="Horizontal"
                                  Spacing="{StaticResource Space.8}">
                        <Border Classes="cap">
                          <TextBlock Classes="mono"
                                     Text="{Binding Text}" />
                        </Border>
                        <TextBlock Classes="mono"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Smoke}"
                                   IsVisible="{Binding HasPlus}"
                                   Text="+" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="bodySm"
                           Margin="{StaticResource Inset.HotkeyText}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Smoke}"
                           IsVisible="{Binding ShowNone}"
                           Text="{x:Static res:Strings.Hotkeys_None}" />
                <Grid ColumnDefinitions="*,Auto"
                      Margin="{StaticResource Inset.HotkeyText}"
                      IsVisible="{Binding HotkeyRow.IsCapturing}">
                  <TextBlock Classes="bodySm"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.Smoke}"
                             Text="{x:Static res:Strings.Onb4_PressShortcut}" />
                  <TextBlock Grid.Column="1"
                             Classes="mono"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.Smoke}"
                             Text="{x:Static res:Strings.Onb4_EscToCancel}" />
                </Grid>
              </Panel>
            </Button>
          </Grid>
        </StackPanel>

        <Border Classes="divider" />

        <!-- Record the screen by default -->
        <Grid x:Name="ScreenRow"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="{StaticResource Space.24}"
              Margin="{StaticResource Inset.Row}">
          <StackPanel VerticalAlignment="Center"
                      Spacing="{StaticResource Space.4}">
            <TextBlock Classes="body"
                       FontWeight="{StaticResource FontWeight.BodyMedium}"
                       Text="{x:Static res:Strings.Onb4_Screen}" />
            <TextBlock Classes="bodySm"
                       Foreground="{DynamicResource Brush.Smoke}"
                       Text="{x:Static res:Strings.Onb4_ScreenText}" />
            <TextBlock Classes="note"
                       IsVisible="{Binding Devices.ScreenUnavailable}"
                       Text="{x:Static res:Strings.Devices_ScreenUnavailable}" />
          </StackPanel>
          <ToggleButton x:Name="ScreenToggle"
                        Grid.Column="1"
                        Classes="switch"
                        IsEnabled="{Binding Devices.ScreenAvailable}"
                        IsChecked="{Binding Devices.ScreenByDefault, Mode=TwoWay}"
                        AutomationProperties.Name="{x:Static res:Strings.Onb4_Screen}" />
        </Grid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
