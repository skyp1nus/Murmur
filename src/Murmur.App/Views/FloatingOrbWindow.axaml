<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Murmur.App.ViewModels"
        xmlns:controls="using:Murmur.App.Controls"
        x:Class="Murmur.App.Views.FloatingOrbWindow"
        x:DataType="vm:FloatingOrbViewModel"
        Title="Murmur"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">

  <!--
    The floating recorder orb (#46), Idea1Autopilot.dc.html "Idea 1 / Floating recorder (interactive)": the 44 px circle with the
    28 px orb at the right, the pill of buttons to its left (a click on the circle opens it) and the chip "Marked 12:41" under it
    (or above it at the bottom of the screen). The window keeps one size: the code behind reserves the pill's column and a chip row
    above and below the circle, so opening the pill or the chip never resizes or moves the native window (no flicker). Clicks on the
    transparent rest go through to the window below: the platform style limits input to the shapes that are shown. No elapsed-time
    readout on the orb; its motion runs on the compositor (FloatingOrbDisc).
  -->

  <Grid x:Name="Root"
        Margin="{StaticResource FloatingOrb.ShadowMargin}"
        RowDefinitions="Auto,Auto,Auto"
        ColumnDefinitions="Auto,Auto">

    <Border x:Name="Pill"
            Classes="orbPill"
            Grid.Row="1"
            Grid.Column="0"
            VerticalAlignment="Center"
            Margin="{StaticResource FloatingOrb.PillMargin}"
            IsVisible="{Binding IsPillOpen}">
      <StackPanel Orientation="Horizontal"
                  Spacing="{StaticResource Space.2}">
        <Button x:Name="MarkButton"
                Classes="orbTool"
                Command="{Binding MarkCommand}"
                ToolTip.Tip="{Binding MarkLabel}"
                AutomationProperties.Name="{Binding MarkLabel}">
          <controls:IconControl Width="{StaticResource FloatingOrb.MarkIcon}"
                                Height="{StaticResource FloatingOrb.MarkIcon}"
                                Data="{StaticResource Icon.Mark}"
                                Stroke="1.7" />
        </Button>
        <Button x:Name="PauseButton"
                Classes="orbTool"
                Command="{Binding PauseResumeCommand}"
                ToolTip.Tip="{Binding PauseLabel}"
                AutomationProperties.Name="{Binding PauseLabel}">
          <Panel>
            <controls:IconControl Width="{StaticResource FloatingOrb.PauseIcon}"
                                  Height="{StaticResource FloatingOrb.PauseIcon}"
                                  Data="{StaticResource FloatingOrb.Pause}"
                                  IsFilled="True"
                                  IsVisible="{Binding !IsPaused}" />
            <controls:IconControl Width="{StaticResource FloatingOrb.PauseIcon}"
                                  Height="{StaticResource FloatingOrb.PauseIcon}"
                                  Data="{StaticResource FloatingOrb.Resume}"
                                  IsFilled="True"
                                  IsVisible="{Binding IsPaused}" />
          </Panel>
        </Button>
        <Button x:Name="StopButton"
                Classes="orbTool stop"
                Command="{Binding StopCommand}"
                ToolTip.Tip="{Binding StopLabel}"
                AutomationProperties.Name="{Binding StopLabel}">
          <controls:IconControl Width="{StaticResource FloatingOrb.StopIcon}"
                                Height="{StaticResource FloatingOrb.StopIcon}"
                                Data="{StaticResource FloatingOrb.Stop}"
                                IsFilled="True" />
        </Button>
        <Button x:Name="OpenButton"
                Classes="orbTool quiet"
                Command="{Binding OpenCommand}"
                ToolTip.Tip="{Binding OpenLabel}"
                AutomationProperties.Name="{Binding OpenLabel}">
          <controls:IconControl Width="{StaticResource FloatingOrb.OpenIcon}"
                                Height="{StaticResource FloatingOrb.OpenIcon}"
                                Data="{StaticResource FloatingOrb.OpenGlyph}" />
        </Button>
      </StackPanel>
    </Border>

    <Border x:Name="Circle"
            Classes="orbCircle"
            Grid.Row="1"
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            ToolTip.Tip="{Binding StateLabel}"
            AutomationProperties.Name="{Binding StateLabel}">
      <Panel Width="{StaticResource FloatingOrb.Orb}"
             Height="{StaticResource FloatingOrb.Orb}">
        <!-- The orb turns once in 9 s and a ring goes out every 3 s while recording (one 15 Hz timer, only while it moves); still otherwise. -->
        <controls:FloatingOrbDisc x:Name="Disc"
                                  Width="{StaticResource FloatingOrb.Orb}"
                                  Height="{StaticResource FloatingOrb.Orb}"
                                  IsActive="{Binding IsSpinning}" />
        <Ellipse x:Name="PausedWash"
                 Classes="orbPausedWash"
                 IsVisible="{Binding IsPaused}" />
      </Panel>
    </Border>

    <Border x:Name="Chip"
            Classes="orbChip"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Right"
            Margin="{StaticResource FloatingOrb.ChipMargin}"
            IsVisible="{Binding IsChipShown}">
      <StackPanel Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Spacing="{StaticResource Space.6}">
        <controls:IconControl Width="{StaticResource FloatingOrb.ChipIcon}"
                              Height="{StaticResource FloatingOrb.ChipIcon}"
                              VerticalAlignment="Center"
                              Data="{StaticResource Icon.Mark}"
                              IsFilled="True" />
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource Space.3}">
          <TextBlock Classes="orbChipText"
                     VerticalAlignment="Center"
                     Text="{Binding ChipLabel}" />
          <TextBlock x:Name="ChipTimeText"
                     Classes="orbChipText orbMono"
                     VerticalAlignment="Center"
                     Text="{Binding ChipTime}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
