<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Murmur.App.ViewModels"
             xmlns:controls="using:Murmur.App.Controls"
             ClipToBounds="False"
             x:Class="Murmur.App.Views.WelcomeStepView"
             x:DataType="vm:WelcomeStepViewModel">

  <!-- Step 1: the animated orb, the headline and the promise that everything stays on this computer. -->
  <StackPanel Classes="onbWelcome"
              HorizontalAlignment="Center">
    <controls:GlassOrbControl x:Name="WelcomeOrb"
                              Classes="welcome"
                              HorizontalAlignment="Center"
                              IsActive="True" />
    <StackPanel Spacing="{StaticResource Onb.Space.WelcomeText}"
                HorizontalAlignment="Center">
      <TextBlock Classes="display"
                 Margin="{StaticResource Inset.OnbDisplayLift}"
                 Padding="{StaticResource Inset.OnbDescender}"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 Text="{Binding Title}" />
      <TextBlock Classes="onbSub"
                 Text="{Binding Subtitle}" />
    </StackPanel>
  </StackPanel>
</UserControl>
