<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Murmur.App.ViewModels"
             xmlns:res="using:Murmur.App.Resources"
             xmlns:controls="using:Murmur.App.Controls"
             x:Class="Murmur.App.Views.SidebarView"
             x:DataType="vm:SidebarViewModel">

  <!-- The left navigation of the canvas: wordmark, New recording (the Recording pill while recording), pages, the context list, the offline note. -->
  <Border Classes="sidebar">
    <DockPanel LastChildFill="True">

      <!-- Offline note (not on the Settings screen of the canvas) -->
      <Border DockPanel.Dock="Bottom"
              Classes="offline"
              VerticalAlignment="Bottom"
              IsVisible="{Binding ShowOffline}">
        <StackPanel Spacing="{StaticResource Space.6}">
          <StackPanel Orientation="Horizontal"
                      Spacing="{StaticResource Space.8}">
            <controls:IconControl Width="{StaticResource Size.OfflineIcon}"
                                  Height="{StaticResource Size.OfflineIcon}"
                                  Data="{StaticResource Icon.Shield}" />
            <TextBlock Classes="t13 medium"
                       VerticalAlignment="Center"
                       Text="{x:Static res:Strings.Nav_OfflineTitle}" />
          </StackPanel>
          <TextBlock Classes="note12"
                     Text="{Binding OfflineText}" />
        </StackPanel>
      </Border>

      <StackPanel DockPanel.Dock="Top"
                  Spacing="{StaticResource Space.24}">

        <!-- Wordmark -->
        <StackPanel Orientation="Horizontal"
                    Spacing="{StaticResource Space.10}"
                    Margin="{StaticResource Inset.Wordmark}">
          <controls:OrbDisc Width="{StaticResource Size.WordmarkOrb}"
                            Height="{StaticResource Size.WordmarkOrb}"
                            VerticalAlignment="Center" />
          <TextBlock Classes="wordmark"
                     VerticalAlignment="Center"
                     Text="Murmur" />
        </StackPanel>

        <!-- New recording, or the pill that leads back to the recording that runs -->
        <Panel>
          <Button Classes="side"
                  IsVisible="{Binding ShowNewRecording}"
                  Command="{Binding NewRecordingCommand}">
            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource Space.10}">
              <Ellipse Width="{StaticResource Space.8}"
                       Height="{StaticResource Space.8}"
                       VerticalAlignment="Center"
                       Fill="{DynamicResource Brush.Canvas}" />
              <TextBlock Classes="t14"
                         Foreground="{DynamicResource Brush.Canvas}"
                         Text="{x:Static res:Strings.Library_NewRecording}" />
            </StackPanel>
          </Button>
          <Button Classes="side recording"
                  IsVisible="{Binding IsRecordingActive}"
                  Command="{Binding ShowRecordingCommand}">
            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource Space.10}">
              <controls:OrbDisc Width="{StaticResource Size.PillOrb}"
                                Height="{StaticResource Size.PillOrb}"
                                VerticalAlignment="Center" />
              <TextBlock Classes="t14"
                         Foreground="{DynamicResource Brush.Ink}"
                         Text="{x:Static res:Strings.Nav_Recording}" />
            </StackPanel>
          </Button>
        </Panel>

        <!-- Pages -->
        <StackPanel Spacing="{StaticResource Space.2}">
          <Button Classes="nav"
                  Classes.on="{Binding IsLibrary}"
                  Command="{Binding ShowLibraryCommand}">
            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource Space.10}">
              <controls:IconControl Width="{StaticResource Size.NavIcon}"
                                    Height="{StaticResource Size.NavIcon}"
                                    Data="{StaticResource Icon.Library}" />
              <TextBlock Classes="t14"
                         Foreground="{Binding $parent[ContentPresenter].Foreground}"
                         Text="{x:Static res:Strings.Nav_Library}" />
            </StackPanel>
          </Button>
          <Button Classes="nav"
                  Classes.on="{Binding IsChat}"
                  IsVisible="{Binding CanAskAi}"
                  Command="{Binding ShowChatCommand}">
            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource Space.10}">
              <controls:IconControl Width="{StaticResource Size.NavIcon}"
                                    Height="{StaticResource Size.NavIcon}"
                                    Data="{StaticResource Icon.Ai}" />
              <TextBlock Classes="t14"
                         Foreground="{Binding $parent[ContentPresenter].Foreground}"
                         Text="{x:Static res:Strings.Common_AskAi}" />
            </StackPanel>
          </Button>
          <Button Classes="nav"
                  Classes.on="{Binding IsSettings}"
                  Command="{Binding ShowSettingsCommand}">
            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource Space.10}">
              <controls:IconControl Width="{StaticResource Size.NavIcon}"
                                    Height="{StaticResource Size.NavIcon}"
                                    Data="{StaticResource Icon.Settings}" />
              <TextBlock Classes="t14"
                         Foreground="{Binding $parent[ContentPresenter].Foreground}"
                         Text="{x:Static res:Strings.Nav_Settings}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>

      <!-- Recent recordings / chats / sections of the settings: takes the room between the pages and the offline note and scrolls when it has more rows than room. -->
      <ScrollViewer Margin="{StaticResource Margin.SidebarList}"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    IsVisible="{Binding HasEntries}">
        <StackPanel Spacing="{StaticResource Space.2}">
          <TextBlock Classes="t12 muted"
                     Margin="{StaticResource Margin.NavTitle}"
                     Text="{Binding ContextTitle}" />
          <ItemsControl ItemsSource="{Binding Entries}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="{StaticResource Space.2}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SidebarEntry">
                <Panel>
                  <!-- A row that only opens something (recent recordings, settings sections) -->
                  <Button Classes="nav sub"
                          Classes.on="{Binding IsActive}"
                          IsVisible="{Binding !CanManage}"
                          Command="{Binding OpenCommand}">
                    <TextBlock Classes="t13"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{Binding $parent[ContentPresenter].Foreground}"
                               Text="{Binding Title}" />
                  </Button>

                  <!-- A chat: the same pill with Rename and Delete in its context menu, and an inline editor while it is renamed -->
                  <Panel IsVisible="{Binding CanManage}">
                    <Button Classes="nav sub"
                            Classes.on="{Binding IsActive}"
                            IsVisible="{Binding IsNotEditing}"
                            Command="{Binding OpenCommand}">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="{x:Static res:Strings.Chat_RenameChat}"
                                    IsVisible="{Binding CanRename}"
                                    Command="{Binding BeginRenameCommand}" />
                          <MenuItem Header="{x:Static res:Strings.Chat_DeleteChat}"
                                    IsVisible="{Binding CanDelete}"
                                    Command="{Binding DeleteCommand}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <TextBlock Classes="t13"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{Binding $parent[ContentPresenter].Foreground}"
                                 Text="{Binding Title}" />
                    </Button>
                    <controls:RenameBox Classes="chatRename"
                                        IsVisible="{Binding IsEditing}"
                                        AutomationProperties.Name="{x:Static res:Strings.Chat_RenameChat}"
                                        Text="{Binding EditText, Mode=TwoWay}"
                                        Finished="OnRenameFinished">
                      <controls:RenameBox.KeyBindings>
                        <KeyBinding Gesture="Enter"
                                    Command="{Binding CommitRenameCommand}" />
                        <KeyBinding Gesture="Escape"
                                    Command="{Binding CancelRenameCommand}" />
                      </controls:RenameBox.KeyBindings>
                    </controls:RenameBox>
                  </Panel>
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
