<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Murmur.App.ViewModels"
             xmlns:res="using:Murmur.App.Resources"
             xmlns:controls="using:Murmur.App.Controls"
             xmlns:views="using:Murmur.App.Views"
             x:Class="Murmur.App.Views.SessionView"
             x:DataType="vm:SessionViewModel">

  <!--
    The recording of the canvas (Session.dc.html / SessionDark.dc.html), in the page area below the top bar: the title and the
    facts under it, then the video and the player on the left, the tabs Transcript / Summary / Ask AI on the right. Colours, type,
    spacing and radii are tokens; what is declared here are the sizes of this screen's own components and its styles (every class
    starts with "session", so none of them collides with the shared styles).
  -->

  <UserControl.Resources>
    <ResourceDictionary>
      <!-- Layout of the canvas page: 960 wide at most, columns of 380 and 420 that wrap below 820. -->
      <x:Double x:Key="Session.PageMaxWidth">960</x:Double>
      <x:Double x:Key="Session.LeftBasis">380</x:Double>
      <x:Double x:Key="Session.RightBasis">420</x:Double>
      <x:Double x:Key="Session.MinRightHeight">520</x:Double>
      <Thickness x:Key="Session.PagePadding">24,16,24,32</Thickness>
      <Thickness x:Key="Session.ShortcutsMargin">0,8,0,0</Thickness>

      <!-- Component sizes. -->
      <x:Double x:Key="Session.Avatar">24</x:Double>
      <x:Double x:Key="Session.Play">32</x:Double>
      <x:Double x:Key="Session.PlayIcon">13</x:Double>
      <x:Double x:Key="Session.Small">28</x:Double>
      <x:Double x:Key="Session.Tab">28</x:Double>
      <x:Double x:Key="Session.TabDot">5</x:Double>
      <x:Double x:Key="Session.TabIcon">13</x:Double>
      <x:Double x:Key="Session.Check">14</x:Double>
      <x:Double x:Key="Session.WaveformHeight">48</x:Double>
      <x:Double x:Key="Session.VideoIcon">22</x:Double>
      <x:Double x:Key="Session.VideoIconStroke">1.4</x:Double>
      <x:Double x:Key="Session.DimmedOpacity">0.4</x:Double>
      <x:Double x:Key="Session.StatusWidth">480</x:Double>
      <!-- The playhead sticks out 3 px above and below the 42 px of bars. -->
      <Thickness x:Key="Session.WaveformMargin">0,-3</Thickness>
      <!-- The canvas lines are 20.15 px and its rows add up to 2 px more than the whole-pixel lines of the app over the 14 lines of the demo; one pixel down
           splits that drift between the first and the last row (fitted at 100 % scale). -->
      <Thickness x:Key="Session.TranscriptShift">0,1,0,0</Thickness>
      <Thickness x:Key="Session.RowGap">0,0,0,2</Thickness>
      <Thickness x:Key="Session.RowPadding">10,8</Thickness>
      <Thickness x:Key="Session.TimePadding">5,0</Thickness>
      <Thickness x:Key="Session.VideoMargin">10</Thickness>
      <!-- The chapter strip sits 8 px below the facts (the header stack adds its 6 px gap; 14 px in all, like the canvas's column). -->
      <Thickness x:Key="Session.ChapterMargin">0,8,0,0</Thickness>

      <!-- Filled glyphs of the play button (24 x 24 grid, like the canvas SVGs). -->
      <StreamGeometry x:Key="Session.PlayGlyph">M8 5v14l11-7z</StreamGeometry>
      <StreamGeometry x:Key="Session.PauseGlyph">M7 5h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z M15 5h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z</StreamGeometry>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Type of the canvas. Every step is a token step; a button's text has no tracking (a form control does not inherit it). -->
    <Style Selector="TextBlock.sessionTitle">
      <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.Display}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.PageTitle}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.PageTitle}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.PageTitle}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>
    <Style Selector="TextBlock.sessionMeta">
      <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.Body}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.SmallTight}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.Small}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
    </Style>
    <Style Selector="TextBlock.sessionMeta.mono">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.Mono}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.MonoRow}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.MonoRow}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.MonoRow}" />
    </Style>
    <Style Selector="TextBlock.sessionLabel">
      <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.Body}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.SmallTight}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.Small}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
    </Style>
    <Style Selector="TextBlock.sessionNote">
      <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.Body}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.Small}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.Small}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.sessionBody">
      <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.Body}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Meta}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.Meta}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.Meta}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.sessionOverview">
      <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.Body}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Message}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.Message}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.Message}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.sessionCardTitle">
      <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Meta}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.MetaTight}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.Meta}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- The line under the summary: 11 px. -->
    <Style Selector="TextBlock.sessionFoot">
      <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.Body}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Tag}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.Tag}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.Tag}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- 12 px / 500 without tracking: the text of the tabs. -->
    <Style Selector="TextBlock.sessionTabText">
      <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.SmallTight}" />
      <Setter Property="LetterSpacing" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 12 px / 500 without tracking: You and Others. -->
    <Style Selector="TextBlock.sessionSmallText">
      <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.SmallTight}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.SmallTight}" />
      <Setter Property="LetterSpacing" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.sessionSmallText.mono">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.Mono}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.MonoSmall}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.MonoSmall}" />
    </Style>
    <Style Selector="TextBlock.sessionName">
      <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.SmallTight}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.Small}" />
    </Style>
    <Style Selector="TextBlock.sessionTime">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.Mono}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.MonoSmall}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.MonoSmall}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.MonoSmall}" />
    </Style>
    <Style Selector="TextBlock.sessionAvatarText">
      <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.Caption}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.Caption}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.sessionChipText">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.Mono}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.MonoSmall}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.MonoSmall}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.MonoSmall}" />
    </Style>

    <!-- The page scrolls in a small window: its scroll bar keeps to the palette. -->
    <Style Selector="ScrollBar RepeatButton">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
    </Style>

    <!-- Pills with a hairline on the Canvas: the tabs, You / Others / speed (28). -->
    <Style Selector="Button.sessionPill, ToggleButton.sessionPill">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Height" Value="{StaticResource Session.Small}" />
      <Setter Property="Padding" Value="{StaticResource Inset.Suggestion}" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.ButtonBorder}" />
      <Setter Property="BorderThickness" Value="{StaticResource Hairline.Thickness}" />
    </Style>
    <Style Selector="Button.sessionPill:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.sessionPill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FillHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.ButtonBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>
    <Style Selector="Button.sessionPill:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.sessionPill:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FillPressed}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.ButtonBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>
    <Style Selector="Button.sessionPill:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.sessionPill:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stone}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ash}" />
    </Style>
    <Style Selector="ToggleButton.sessionPill.filter">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
    </Style>
    <Style Selector="ToggleButton.sessionPill.filter:checked">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>
    <Style Selector="ToggleButton.sessionPill.filter /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stone}" />
    </Style>
    <Style Selector="ToggleButton.sessionPill.filter:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.ButtonBorder}" />
    </Style>
    <!-- Fluent fills a checked toggle with the system accent; here checked is the same Canvas pill (the tab has its dot). -->
    <Style Selector="ToggleButton.sessionPill:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.ButtonBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>
    <Style Selector="ToggleButton.sessionPill:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FillHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.ButtonBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>
    <Style Selector="ToggleButton.sessionPill:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FillPressed}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.ButtonBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>
    <Style Selector="ToggleButton.sessionPill:checked:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stone}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ash}" />
    </Style>
    <Style Selector="ToggleButton.sessionPill.filter:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FillHover}" />
    </Style>
    <Style Selector="ToggleButton.sessionPill.tab">
      <Setter Property="Height" Value="{StaticResource Session.Tab}" />
      <Setter Property="Padding" Value="{StaticResource Inset.Compact}" />
    </Style>

    <!-- The black play button. -->
    <Style Selector="Button.sessionPlay">
      <Setter Property="Width" Value="{StaticResource Session.Play}" />
      <Setter Property="Height" Value="{StaticResource Session.Play}" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Canvas}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.sessionPlay:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.InkHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Canvas}" />
    </Style>
    <Style Selector="Button.sessionPlay:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Smoke}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Canvas}" />
    </Style>
    <Style Selector="Button.sessionPlay:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Ash}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Canvas}" />
    </Style>

    <!-- The tab's dot (the active one has it). -->
    <Style Selector="Ellipse.sessionDot">
      <Setter Property="Width" Value="{StaticResource Session.TabDot}" />
      <Setter Property="Height" Value="{StaticResource Session.TabDot}" />
      <Setter Property="Fill" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Cards: the player (hairline), the video (Surface) are in the shared styles; these are the summary's. -->
    <Style Selector="Border.sessionPlayer">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
      <Setter Property="BorderThickness" Value="{StaticResource Hairline.Thickness}" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
      <Setter Property="Padding" Value="{StaticResource Inset.CardList}" />
    </Style>
    <Style Selector="Border.sessionSurface">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
      <Setter Property="Padding" Value="{StaticResource Inset.Card}" />
    </Style>
    <Style Selector="Border.sessionOutline">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
      <Setter Property="BorderThickness" Value="{StaticResource Hairline.Thickness}" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
      <Setter Property="Padding" Value="{StaticResource Inset.Card}" />
    </Style>

    <!-- The size chip over the video: Canvas at 90 %, 10 px from the corner, 3 x 8 px inside. -->
    <Style Selector="Panel.videoChip">
      <Setter Property="Margin" Value="{StaticResource Session.VideoMargin}" />
    </Style>
    <Style Selector="Panel.videoChip > TextBlock.sessionChipText">
      <Setter Property="Margin" Value="{StaticResource Inset.SessionChip}" />
    </Style>

    <!-- A line of the transcript: transparent, Surface under the pointer and for the current one, dimmed when its track is off. -->
    <Style Selector="Button.sessionRow">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="{StaticResource Session.RowPadding}" />
      <Setter Property="Margin" Value="{StaticResource Session.RowGap}" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>
    <Style Selector="Button.sessionRow /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.sessionRow:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.sessionRow:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.sessionRow.current /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>
    <Style Selector="Button.sessionRow.dimmed">
      <Setter Property="Opacity" Value="{StaticResource Session.DimmedOpacity}" />
    </Style>
    <Style Selector="Button.sessionRow controls|TranscriptTextControl">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Graphite}" />
    </Style>
    <Style Selector="Button.sessionRow.current controls|TranscriptTextControl">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>
    <Style Selector="controls|TranscriptTextControl.sessionText">
      <Setter Property="FontSize" Value="{StaticResource FontSize.MessageLine}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.MessageLine}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.MessageLine}" />
      <Setter Property="MarkBrush" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="MarkForeground" Value="{DynamicResource Brush.Canvas}" />
      <Setter Property="MarkCornerRadius" Value="{StaticResource Radius.Input}" />
      <!-- Follow along: the spoken word is white on an Ink chip (radius 4), the rest of the line still to be said is Ash. -->
      <Setter Property="HighlightBrush" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="HighlightBorderBrush" Value="{x:Null}" />
      <Setter Property="HighlightForeground" Value="{DynamicResource Brush.Canvas}" />
      <Setter Property="UpcomingForeground" Value="{DynamicResource Brush.Ash}" />
      <Setter Property="HighlightPadding" Value="{StaticResource Size.WordChipPadding}" />
    </Style>

    <!-- "Follow along" in the transcript header: 12 px Graphite beside the switch. -->
    <Style Selector="TextBlock.followAlongLabel">
      <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.Body}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.Small}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.Small}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Graphite}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The avatar of a speaker: the ink for the microphone, Stone for the other side. -->
    <Style Selector="Border.sessionAvatar">
      <Setter Property="Width" Value="{StaticResource Session.Avatar}" />
      <Setter Property="Height" Value="{StaticResource Session.Avatar}" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Stone}" />
    </Style>
    <Style Selector="Border.sessionAvatar > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>
    <Style Selector="Border.sessionAvatar.me">
      <Setter Property="Background" Value="{DynamicResource Brush.Ink}" />
    </Style>
    <Style Selector="Border.sessionAvatar.me > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Canvas}" />
    </Style>

    <!-- The time of a line: Geist Mono in Smoke on a 6 px rounded box, Stone under the pointer; Ink on the current line. -->
    <Style Selector="Button.sessionTime">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="{StaticResource Session.TimePadding}" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Kbd}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.sessionTime /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
    </Style>
    <Style Selector="Button.sessionTime:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.sessionTime:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FillPressed}" />
    </Style>
    <Style Selector="Button.sessionRow.current Button.sessionTime /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>

    <!-- A chip of the summary: the time an item cites, a pill on Surface (Stone in the dark theme) that plays from there. -->
    <Style Selector="Button.sessionChip">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="{StaticResource Inset.Key}" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{DynamicResource Brush.FillHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.sessionChip /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FillHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>
    <Style Selector="Button.sessionChip:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.sessionChip:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FillPressed}" />
    </Style>
    <Style Selector="Border.sessionChipLabel">
      <Setter Property="Padding" Value="{StaticResource Inset.Key}" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
      <Setter Property="Background" Value="{DynamicResource Brush.FillHover}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- The checkbox of an action item: Ink when checked. -->
    <Style Selector="CheckBox.sessionCheck">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="PART_Box"
                  Width="{StaticResource Session.Check}"
                  Height="{StaticResource Session.Check}"
                  CornerRadius="{StaticResource Radius.Input}"
                  Background="Transparent"
                  BorderBrush="{DynamicResource Brush.Ash}"
                  BorderThickness="{StaticResource Hairline.Thickness}">
            <controls:IconControl x:Name="PART_Tick"
                                  Width="{StaticResource Size.SmallIcon}"
                                  Height="{StaticResource Size.SmallIcon}"
                                  Stroke="2.2"
                                  IsVisible="False"
                                  TextElement.Foreground="{DynamicResource Brush.Canvas}"
                                  Data="{StaticResource Icon.Check}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="CheckBox.sessionCheck:checked /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ink}" />
    </Style>
    <Style Selector="CheckBox.sessionCheck:checked /template/ controls|IconControl#PART_Tick">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="controls|WaveformControl">
      <Setter Property="WaveBrush" Value="{DynamicResource Brush.DashedBorder}" />
      <Setter Property="PlayedBrush" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="PlayheadBrush" Value="{DynamicResource Brush.Ink}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">
    <ScrollViewer x:Name="PageScroller"
                  Grid.Row="0"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Border MaxWidth="{StaticResource Session.PageMaxWidth}"
              Padding="{StaticResource Session.PagePadding}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top">
        <controls:SessionPagePanel x:Name="Page"
                                   ColumnSpacing="{StaticResource Space.20}"
                                   RowSpacing="{StaticResource Space.20}"
                                   LeftBasis="{StaticResource Session.LeftBasis}"
                                   RightBasis="{StaticResource Session.RightBasis}"
                                   MinRightHeight="{StaticResource Session.MinRightHeight}">

          <!-- Title and the facts under it -->
          <StackPanel Spacing="{StaticResource Space.6}">
            <TextBlock Classes="sessionTitle"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding Title}" />
            <!-- parity-only: the canvas packs the fractional-width runs of this line without rounding; layout rounding widens each run and "Parakeet TDT v3" lands 2.3 px right. -->
            <ItemsControl Classes="sessionMetaList"
                          UseLayoutRounding="False"
                          ItemsSource="{Binding Meta}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="{StaticResource Space.6}" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MetaPart">
                  <TextBlock Classes="sessionMeta"
                             Classes.mono="{Binding IsMono}"
                             Classes.dot="{Binding IsSeparator}"
                             Text="{Binding Text}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="sessionNote"
                       IsVisible="{Binding HasActionMessage}"
                       Text="{Binding ActionMessage}" />
            <!-- Chapters of a long recording; hidden (no space) while there are none. -->
            <views:ChapterStripView Margin="{StaticResource Session.ChapterMargin}"
                                    IsVisible="{Binding HasChapters}" />
          </StackPanel>

          <!-- Left: the video and the player -->
          <StackPanel Spacing="{StaticResource Space.12}">
            <Border x:Name="VideoPanel"
                    Classes="videoPanel"
                    IsVisible="{Binding HasVideo}">
              <controls:AspectRatioBox>
                <Panel>
                  <controls:VideoSurface x:Name="Video"
                                         Player="{Binding VideoPlayer}"
                                         Active="{Binding IsVideoOpen}"
                                         Revision="{Binding VideoRevision}" />
                  <StackPanel x:Name="VideoPlaceholder"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Spacing="{StaticResource Space.8}"
                              IsVisible="{Binding ShowVideoPlaceholder}">
                    <controls:IconControl Width="{StaticResource Session.VideoIcon}"
                                          Height="{StaticResource Session.VideoIcon}"
                                          HorizontalAlignment="Center"
                                          Stroke="{StaticResource Session.VideoIconStroke}"
                                          TextElement.Foreground="{DynamicResource Brush.Smoke}"
                                          Data="{StaticResource Icon.Screen}" />
                    <TextBlock Classes="sessionLabel"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{Binding VideoPlaceholderText}" />
                  </StackPanel>
                  <Panel x:Name="VideoChip"
                         Classes="videoChip"
                         IsVisible="{Binding IsVideoOpen}">
                    <Border Classes="videoChipBackground" />
                    <TextBlock Classes="sessionChipText videoChipText"
                               Text="{Binding VideoInfoText}" />
                  </Panel>
                </Panel>
              </controls:AspectRatioBox>
            </Border>

            <Border Classes="sessionPlayer">
              <StackPanel Spacing="{StaticResource Space.12}">
                <!-- Bookmark flags (#59): a band over the waveform, there only while the recording has bookmarks. -->
                <controls:BookmarkFlagsControl x:Name="BookmarkFlags"
                                               IsVisible="{Binding HasBookmarks}"
                                               Flags="{Binding BookmarkFlags}" />
                <controls:WaveformControl x:Name="Waveform"
                                          Height="{StaticResource Session.WaveformHeight}"
                                          Margin="{StaticResource Session.WaveformMargin}"
                                          Peaks="{Binding Peaks}"
                                          Fraction="{Binding PositionFraction}" />
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="{StaticResource Space.10}">
                  <Button Grid.Column="0"
                          Classes="sessionPlay"
                          AutomationProperties.Name="{Binding PlayPauseLabel}"
                          IsEnabled="{Binding CanPlay}"
                          Command="{Binding PlayPauseCommand}">
                    <Viewbox Width="{StaticResource Session.PlayIcon}"
                             Height="{StaticResource Session.PlayIcon}">
                      <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource Session.PlayGlyph}"
                              Fill="{Binding $parent[Button].Foreground}"
                              IsVisible="{Binding !IsPlaying}" />
                        <Path Data="{StaticResource Session.PauseGlyph}"
                              Fill="{Binding $parent[Button].Foreground}"
                              IsVisible="{Binding IsPlaying}" />
                      </Canvas>
                    </Viewbox>
                  </Button>
                  <TextBlock Grid.Column="1"
                             Classes="sessionMeta mono"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource Brush.Ink}">
                    <Run Text="{Binding PositionText, StringFormat='{}{0} '}" /><Run Text="{Binding DurationText, StringFormat='/ {0}'}" Foreground="{DynamicResource Brush.Smoke}" />
                  </TextBlock>
                  <!--
                    The canvas gap is 4 px. The pills are 43.78, 60.67 and 35.2 px wide in the canvas; layout rounding rounds each of them (and its text)
                    up to whole pixels, which makes the group about 2 px wider than the canvas's. There is no margin or border to remove, so the gap
                    gives the 2 px back: the group ends where the canvas's does (fitted at 100 % scale).
                  -->
                  <StackPanel Grid.Column="2"
                              Orientation="Horizontal"
                              Spacing="{StaticResource Space.2}">
                    <ToggleButton Classes="sessionPill filter"
                                  IsEnabled="{Binding CanMuteTracks}"
                                  IsChecked="{Binding YouOn, Mode=TwoWay}"
                                  ToolTip.Tip="{x:Static res:Strings.Session_YouTip}">
                      <TextBlock Classes="sessionSmallText"
                                 Text="{x:Static res:Strings.Segment_Me}" />
                    </ToggleButton>
                    <ToggleButton Classes="sessionPill filter"
                                  IsEnabled="{Binding CanMuteTracks}"
                                  IsChecked="{Binding OthersOn, Mode=TwoWay}"
                                  ToolTip.Tip="{x:Static res:Strings.Session_OthersTip}">
                      <TextBlock Classes="sessionSmallText"
                                 Text="{x:Static res:Strings.Segment_Others}" />
                    </ToggleButton>
                    <Button Classes="sessionPill"
                            Command="{Binding CycleSpeedCommand}"
                            ToolTip.Tip="{x:Static res:Strings.Session_SpeedTip}">
                      <TextBlock Classes="sessionSmallText mono"
                                 LetterSpacing="0"
                                 Text="{Binding SpeedText}" />
                    </Button>
                  </StackPanel>
                </Grid>
                <TextBlock Classes="sessionNote"
                           IsVisible="{Binding HasPlayerError}"
                           Text="{Binding PlayerError}" />
              </StackPanel>
            </Border>

            <!-- Bookmarks (#59): hidden, with no space, when the recording has no bookmark store (the design demo). -->
            <views:BookmarksCardView IsVisible="{Binding ShowBookmarksCard}" />
          </StackPanel>

          <!-- Right: the tabs and what they show -->
          <Grid RowDefinitions="Auto,*"
                RowSpacing="{StaticResource Space.12}">
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="{StaticResource Space.4}">
              <ToggleButton Classes="sessionPill tab"
                            IsChecked="{Binding IsTranscriptTab, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal"
                            Spacing="{StaticResource Space.6}">
                  <Ellipse Classes="sessionDot"
                           IsVisible="{Binding $parent[ToggleButton].IsChecked}" />
                  <TextBlock Classes="sessionTabText"
                             Text="{x:Static res:Strings.Session_TabTranscript}" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton Classes="sessionPill tab"
                            IsChecked="{Binding IsSummaryTab, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal"
                            Spacing="{StaticResource Space.6}">
                  <Ellipse Classes="sessionDot"
                           IsVisible="{Binding $parent[ToggleButton].IsChecked}" />
                  <TextBlock Classes="sessionTabText"
                             Text="{x:Static res:Strings.Session_TabSummary}" />
                </StackPanel>
              </ToggleButton>
              <ToggleButton Classes="sessionPill tab"
                            IsChecked="{Binding IsAskTab, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal"
                            Spacing="{StaticResource Space.6}">
                  <Ellipse Classes="sessionDot"
                           IsVisible="{Binding $parent[ToggleButton].IsChecked}" />
                  <controls:IconControl Width="{StaticResource Session.TabIcon}"
                                        Height="{StaticResource Session.TabIcon}"
                                        Data="{StaticResource Icon.Ai}" />
                  <TextBlock Classes="sessionTabText"
                             LetterSpacing="{StaticResource LetterSpacing.Small}"
                             Text="{x:Static res:Strings.Common_AskAi}" />
                </StackPanel>
              </ToggleButton>
            </StackPanel>

            <!-- Transcript: the search box, then the virtualised list of lines (or a card that says why there is none) -->
            <Grid Grid.Row="1"
                  RowDefinitions="Auto,*"
                  RowSpacing="{StaticResource Space.8}"
                  IsVisible="{Binding IsTranscriptTab}">
              <!-- The speaker chips (hidden, no space, while nothing can be renamed), then the search box. -->
              <StackPanel Grid.Row="0"
                          Spacing="{StaticResource Space.8}">
                <!-- The header (Idea4Transcript.dc.html): the chips on the left, "Follow along" and its switch on the right. -->
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="{StaticResource Space.10}">
                  <Grid.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                      <Binding Path="ShowSpeakerChips" />
                      <Binding Path="ShowFollowAlongSwitch" />
                    </MultiBinding>
                  </Grid.IsVisible>
                  <views:SpeakerChipsView Grid.Column="0"
                                          IsVisible="{Binding ShowSpeakerChips}" />
                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              Spacing="{StaticResource Space.6}"
                              VerticalAlignment="Center"
                              IsVisible="{Binding ShowFollowAlongSwitch}">
                    <TextBlock Classes="followAlongLabel"
                               Text="{x:Static res:Strings.Session_FollowAlong}" />
                    <ToggleButton x:Name="FollowAlongSwitch"
                                  Classes="switch"
                                  AutomationProperties.Name="{x:Static res:Strings.Session_FollowAlong}"
                                  IsChecked="{Binding FollowAlong, Mode=TwoWay}" />
                  </StackPanel>
                </Grid>
                <Border Classes="searchBox"
                        IsVisible="{Binding ShowTranscriptList}">
                  <Grid ColumnDefinitions="Auto,*"
                        ColumnSpacing="{StaticResource Space.8}">
                    <controls:IconControl Grid.Column="0"
                                          Width="{StaticResource Size.SearchIcon}"
                                          Height="{StaticResource Size.SearchIcon}"
                                          TextElement.Foreground="{DynamicResource Brush.Smoke}"
                                          Data="{StaticResource Icon.Search}" />
                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Classes="bare"
                             AutomationProperties.Name="{x:Static res:Strings.Session_SearchPlaceholder}"
                             PlaceholderText="{x:Static res:Strings.Session_SearchPlaceholder}"
                             Text="{Binding SearchText, Mode=TwoWay}">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding NextHitCommand}" />
                        <KeyBinding Gesture="Shift+Enter" Command="{Binding PreviousHitCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                  </Grid>
                </Border>
              </StackPanel>

              <ScrollViewer x:Name="TranscriptScroller"
                            Grid.Row="1"
                            Margin="{StaticResource Session.TranscriptShift}"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            IsVisible="{Binding ShowTranscriptList}">
                <ItemsControl x:Name="Transcript"
                              ItemsSource="{Binding Segments}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SegmentViewModel">
                      <!-- A row of the list: the line and, under it, the bookmark pills of its span (#59); a pill is a row of its own, so no word moves. -->
                      <StackPanel>
                        <ItemsControl IsVisible="{Binding HasMarksBefore}"
                                      ItemsSource="{Binding MarksBefore}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BookmarkViewModel">
                              <views:BookmarkPillView />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="sessionRow"
                                Classes.current="{Binding IsCurrent}"
                                Classes.dimmed="{Binding IsDimmed}"
                                Command="{Binding SeekCommand}">
                          <Grid ColumnDefinitions="Auto,*"
                                ColumnSpacing="{StaticResource Space.10}">
                            <Border Grid.Column="0"
                                    Classes="sessionAvatar"
                                    Classes.me="{Binding IsMe}"
                                    VerticalAlignment="Top">
                              <TextBlock Classes="sessionAvatarText"
                                         Text="{Binding Initial}" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Spacing="{StaticResource Space.2}">
                              <StackPanel Orientation="Horizontal"
                                          Spacing="{StaticResource Space.8}">
                                <TextBlock Classes="sessionName"
                                           VerticalAlignment="Center"
                                           Text="{Binding SpeakerLabel}" />
                                <Button Classes="sessionTime"
                                        Command="{Binding SeekCommand}">
                                  <TextBlock Classes="sessionTime"
                                             Text="{Binding TimeText}" />
                                </Button>
                              </StackPanel>
                              <controls:TranscriptTextControl Classes="sessionText"
                                                              Text="{Binding Text}"
                                                              WordStarts="{Binding WordStarts}"
                                                              WordLengths="{Binding WordLengths}"
                                                              ActiveWord="{Binding VisibleWord}"
                                                              HighlightTerm="{Binding HighlightTerm}"
                                                              Command="{Binding SeekWordCommand}" />
                            </StackPanel>
                          </Grid>
                        </Button>
                        <ItemsControl IsVisible="{Binding HasMarksAfter}"
                                      ItemsSource="{Binding MarksAfter}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BookmarkViewModel">
                              <views:BookmarkPillView />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <!-- State card: loading, progress, install hint, error, empty -->
              <Border Grid.Row="0"
                      Grid.RowSpan="2"
                      Classes="card"
                      Width="{StaticResource Session.StatusWidth}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsVisible="{Binding ShowStatusCard}">
                <StackPanel Spacing="{StaticResource Space.16}">
                  <TextBlock Classes="subheading"
                             FontWeight="{StaticResource FontWeight.BodyMedium}"
                             TextWrapping="Wrap"
                             Text="{Binding StatusTitle}" />
                  <TextBlock Classes="body"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource Brush.Graphite}"
                             Text="{Binding StatusText}" />
                  <ProgressBar Minimum="0"
                               Maximum="100"
                               Value="{Binding ProgressValue}"
                               IsVisible="{Binding ShowProgress}" />
                  <TextBlock Classes="mono"
                             Foreground="{DynamicResource Brush.Smoke}"
                             IsVisible="{Binding ShowProgress}"
                             Text="{Binding ProgressText}" />
                  <Button Classes="primary"
                          HorizontalAlignment="Left"
                          Content="{Binding RetryLabel}"
                          IsVisible="{Binding CanRetry}"
                          Command="{Binding RetryCommand}" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- Summary: the empty state, progress, the three cards, or why it failed -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding IsSummaryTab}">
              <StackPanel Spacing="{StaticResource Space.12}">

                <Border Classes="sessionSurface"
                        IsVisible="{Binding ShowSummaryEmpty}">
                  <StackPanel Spacing="{StaticResource Space.10}">
                    <TextBlock Classes="sessionCardTitle"
                               Text="{x:Static res:Strings.Session_SummaryEmptyTitle}" />
                    <TextBlock Classes="sessionNote"
                               Text="{x:Static res:Strings.Session_SummaryEmptyText}" />
                    <TextBlock Classes="sessionNote"
                               Foreground="{DynamicResource Brush.Graphite}"
                               IsVisible="{Binding HasSummaryNotice}"
                               Text="{Binding SummaryNotice}" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="{StaticResource Space.8}">
                      <Button Classes="primary compact"
                              HorizontalAlignment="Left"
                              Content="{x:Static res:Strings.Session_SummarySummarize}"
                              IsEnabled="{Binding CanSummarize}"
                              Command="{Binding SummarizeCommand}" />
                      <Button Classes="outline compact"
                              Content="{x:Static res:Strings.Chat_CheckAgain}"
                              IsVisible="{Binding SummaryNeedsModels}"
                              Command="{Binding Chat.RefreshAvailabilityCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Border Classes="sessionSurface"
                        IsVisible="{Binding ShowSummaryWorking}">
                  <StackPanel Spacing="{StaticResource Space.10}">
                    <TextBlock Classes="sessionCardTitle"
                               Text="{x:Static res:Strings.Session_SummaryWorking}" />
                    <TextBlock Classes="sessionNote"
                               Text="{x:Static res:Strings.Session_SummaryWorkingText}" />
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding SummaryProgress}" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0"
                                 Classes="sessionMeta mono"
                                 VerticalAlignment="Center"
                                 Text="{Binding SummaryProgressText}" />
                      <Button Grid.Column="1"
                              Classes="outline compact"
                              Content="{x:Static res:Strings.Common_Stop}"
                              Command="{Binding CancelSummaryRunCommand}" />
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Classes="sessionSurface"
                        IsVisible="{Binding ShowSummaryFailed}">
                  <StackPanel Spacing="{StaticResource Space.10}">
                    <TextBlock Classes="sessionCardTitle"
                               Text="{x:Static res:Strings.Session_SummaryFailedTitle}" />
                    <TextBlock Classes="sessionNote"
                               Foreground="{DynamicResource Brush.Graphite}"
                               Text="{Binding SummaryError}" />
                    <Button Classes="primary compact"
                            HorizontalAlignment="Left"
                            Content="{x:Static res:Strings.Session_TryAgain}"
                            IsEnabled="{Binding CanSummarize}"
                            Command="{Binding SummarizeCommand}" />
                  </StackPanel>
                </Border>

                <StackPanel Spacing="{StaticResource Space.12}"
                            IsVisible="{Binding ShowSummaryReady}">
                  <Border Classes="sessionSurface">
                    <StackPanel Spacing="{StaticResource Space.6}">
                      <TextBlock Classes="sessionLabel"
                                 Text="{x:Static res:Strings.Session_SummaryOverview}" />
                      <TextBlock Classes="sessionOverview"
                                 Text="{Binding SummaryOverview}" />
                    </StackPanel>
                  </Border>

                  <Border Classes="sessionOutline"
                          IsVisible="{Binding HasKeyPoints}">
                    <StackPanel Spacing="{StaticResource Space.10}">
                      <TextBlock Classes="sessionLabel"
                                 Text="{x:Static res:Strings.Session_SummaryKeyPoints}" />
                      <ItemsControl ItemsSource="{Binding KeyPoints}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Spacing="{StaticResource Space.10}" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SummaryItemViewModel">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="{StaticResource Space.10}">
                              <TextBlock Grid.Column="0"
                                         Classes="sessionBody"
                                         Text="{Binding Text}" />
                              <Button Grid.Column="1"
                                      Classes="sessionChip"
                                      IsVisible="{Binding HasTime}"
                                      Command="{Binding PlayCommand}">
                                <TextBlock Classes="sessionChipText"
                                           Text="{Binding TimeText}" />
                              </Button>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Border Classes="sessionOutline"
                          IsVisible="{Binding HasActionItems}">
                    <StackPanel Spacing="{StaticResource Space.10}">
                      <TextBlock Classes="sessionLabel"
                                 Text="{x:Static res:Strings.Session_SummaryActionItems}" />
                      <ItemsControl ItemsSource="{Binding ActionItems}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Spacing="{StaticResource Space.10}" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SummaryItemViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="{StaticResource Space.10}">
                              <CheckBox Grid.Column="0"
                                        Classes="sessionCheck"
                                        VerticalAlignment="Top"
                                        IsChecked="{Binding IsDone, Mode=TwoWay}" />
                              <TextBlock Grid.Column="1"
                                         Classes="sessionBody"
                                         Text="{Binding Text}" />
                              <Button Grid.Column="2"
                                      Classes="sessionChip"
                                      IsVisible="{Binding HasTime}"
                                      Command="{Binding PlayCommand}">
                                <TextBlock Classes="sessionChipText"
                                           Text="{Binding TimeText}" />
                              </Button>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Classes="sessionFoot"
                               VerticalAlignment="Center"
                               Text="{Binding SummaryFooter}" />
                    <Button Grid.Column="1"
                            Classes="outline compact"
                            Content="{x:Static res:Strings.Session_SummaryRegenerate}"
                            IsEnabled="{Binding CanSummarize}"
                            Command="{Binding SummarizeCommand}" />
                  </Grid>
                  <TextBlock Classes="sessionNote"
                             Foreground="{DynamicResource Brush.Graphite}"
                             IsVisible="{Binding HasSummaryNotice}"
                             Text="{Binding SummaryNotice}" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>

            <!-- "Ask AI" tab: chat about this recording; chips seek the player -->
            <Panel Grid.Row="1"
                   IsVisible="{Binding IsAskTab}">
              <views:ConversationView DataContext="{Binding Chat}" />
            </Panel>
          </Grid>
        </controls:SessionPagePanel>
      </Border>
    </ScrollViewer>

  <!-- The keyboard shortcuts (#61), under the page like the mockup's footer; the design demo scene hides it (ShowShortcuts = false). -->
  <views:ShortcutsBar Grid.Row="1"
                      Margin="{StaticResource Session.ShortcutsMargin}"
                      IsVisible="{Binding ShowShortcuts}" />
  </Grid>
</UserControl>
