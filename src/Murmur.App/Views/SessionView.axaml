<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Murmur.App.ViewModels"
             xmlns:res="using:Murmur.App.Resources"
             xmlns:controls="using:Murmur.App.Controls"
             xmlns:views="using:Murmur.App.Views"
             x:Class="Murmur.App.Views.SessionView"
             x:DataType="vm:SessionViewModel">

  <UserControl.Resources>
    <!-- Width of the player column and height of the waveform (layout sizes of this screen, not design tokens). -->
    <x:Double x:Key="Session.PlayerWidth">340</x:Double>
    <!-- With the screen recording the player column is as wide as the mockup's player section (flex-basis 480). -->
    <x:Double x:Key="Session.PlayerWidthVideo">480</x:Double>
    <x:Double x:Key="Session.WaveformHeight">96</x:Double>
    <x:Double x:Key="Session.StatusWidth">480</x:Double>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*"
        RowSpacing="{StaticResource Space.24}">

    <!-- Header -->
    <Grid Grid.Row="0"
          ColumnDefinitions="Auto,*"
          ColumnSpacing="{StaticResource Space.24}">
      <Button Grid.Column="0"
              Classes="outline"
              VerticalAlignment="Center"
              Content="{x:Static res:Strings.Common_Back}"
              Command="{Binding BackCommand}" />
      <StackPanel Grid.Column="1"
                  VerticalAlignment="Center">
        <TextBlock Classes="headingSm"
                   TextTrimming="CharacterEllipsis"
                   Text="{Binding Title}" />
        <TextBlock Classes="bodySm"
                   Foreground="{DynamicResource Brush.Smoke}"
                   Text="{Binding DateText}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1"
          ColumnSpacing="{StaticResource Space.24}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Player (left): the screen recording above the waveform card -->
      <StackPanel Grid.Column="0"
                  Classes="player"
                  Classes.video="{Binding HasVideo}"
                  VerticalAlignment="Top"
                  Spacing="{StaticResource Space.16}">
        <StackPanel.Styles>
          <Style Selector="StackPanel.player">
            <Setter Property="Width" Value="{StaticResource Session.PlayerWidth}" />
          </Style>
          <Style Selector="StackPanel.player.video">
            <Setter Property="Width" Value="{StaticResource Session.PlayerWidthVideo}" />
          </Style>
        </StackPanel.Styles>

        <Border x:Name="VideoPanel"
                Classes="videoPanel"
                IsVisible="{Binding HasVideo}">
          <Panel>
            <controls:VideoSurface x:Name="Video"
                                   Player="{Binding VideoPlayer}"
                                   Active="{Binding IsVideoOpen}"
                                   Revision="{Binding VideoRevision}" />
            <StackPanel x:Name="VideoPlaceholder"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="{StaticResource Space.8}"
                        IsVisible="{Binding ShowVideoPlaceholder}">
              <controls:IconControl Width="{StaticResource Size.VideoIcon}"
                                    Height="{StaticResource Size.VideoIcon}"
                                    HorizontalAlignment="Center"
                                    TextElement.Foreground="{DynamicResource Brush.Smoke}"
                                    Data="{StaticResource Icon.Screen}" />
              <TextBlock Classes="bodySm"
                         HorizontalAlignment="Center"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource Brush.Smoke}"
                         Text="{Binding VideoPlaceholderText}" />
            </StackPanel>
            <Border x:Name="VideoChip"
                    Classes="videoChip"
                    IsVisible="{Binding IsVideoOpen}">
              <TextBlock Classes="mono"
                         Text="{Binding VideoInfoText}" />
            </Border>
          </Panel>
        </Border>

        <Border Classes="card"
                Padding="{StaticResource Inset.24}">
          <StackPanel Spacing="{StaticResource Space.16}">
            <controls:WaveformControl x:Name="Waveform"
                                      Height="{StaticResource Session.WaveformHeight}"
                                      Peaks="{Binding Peaks}"
                                      Fraction="{Binding PositionFraction}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0"
                         Classes="mono"
                         Text="{Binding PositionText}" />
              <TextBlock Grid.Column="1"
                         Classes="mono"
                         Foreground="{DynamicResource Brush.Smoke}"
                         Text="{Binding DurationText}" />
            </Grid>
            <Button Classes="primary"
                    HorizontalAlignment="Center"
                    Content="{Binding PlayPauseLabel}"
                    IsEnabled="{Binding CanPlay}"
                    Command="{Binding PlayPauseCommand}" />
            <TextBlock Classes="bodySm"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Smoke}"
                       IsVisible="{Binding HasPlayerError}"
                       Text="{Binding PlayerError}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Tabs and content (right) -->
      <Grid Grid.Column="1"
            RowDefinitions="Auto,*"
            RowSpacing="{StaticResource Space.16}">
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="{StaticResource Space.8}">
          <ToggleButton Classes="pill"
                        Content="{x:Static res:Strings.Session_TabTranscript}"
                        IsChecked="{Binding IsTranscriptTab, Mode=TwoWay}" />
          <ToggleButton Classes="pill"
                        Content="{x:Static res:Strings.Session_TabSummary}"
                        IsChecked="{Binding IsSummaryTab, Mode=TwoWay}" />
          <ToggleButton Classes="pill"
                        Content="{x:Static res:Strings.Common_AskAi}"
                        IsChecked="{Binding IsAskTab, Mode=TwoWay}" />
        </StackPanel>

        <!-- Transcript: virtualised list of segments -->
        <Border Grid.Row="1"
                Classes="card transcript"
                IsVisible="{Binding ShowTranscriptList}">
          <ScrollViewer x:Name="TranscriptScroller"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Transcript"
                          ItemsSource="{Binding Segments}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SegmentViewModel">
                  <StackPanel Margin="{StaticResource Inset.12}"
                              Spacing="{StaticResource Space.4}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="{StaticResource Space.8}">
                      <TextBlock Classes="speaker"
                                 VerticalAlignment="Center"
                                 Text="{Binding SpeakerLabel}" />
                      <Button Classes="chip"
                              Content="{Binding TimeText}"
                              Command="{Binding SeekCommand}" />
                    </StackPanel>
                    <controls:TranscriptTextControl Text="{Binding Text}"
                                                    WordStarts="{Binding WordStarts}"
                                                    WordLengths="{Binding WordLengths}"
                                                    ActiveWord="{Binding ActiveWord}"
                                                    Command="{Binding SeekWordCommand}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <!-- State card: loading, progress, install hint, error, empty -->
        <Border Grid.Row="1"
                Classes="card"
                Width="{StaticResource Session.StatusWidth}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding ShowStatusCard}">
          <StackPanel Spacing="{StaticResource Space.16}">
            <TextBlock Classes="subheading"
                       FontWeight="{StaticResource FontWeight.BodyMedium}"
                       TextWrapping="Wrap"
                       Text="{Binding StatusTitle}" />
            <TextBlock Classes="body"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Graphite}"
                       Text="{Binding StatusText}" />
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Value="{Binding ProgressValue}"
                         IsVisible="{Binding ShowProgress}" />
            <TextBlock Classes="mono"
                       Foreground="{DynamicResource Brush.Smoke}"
                       IsVisible="{Binding ShowProgress}"
                       Text="{Binding ProgressText}" />
            <Button Classes="primary"
                    HorizontalAlignment="Left"
                    Content="{Binding RetryLabel}"
                    IsVisible="{Binding CanRetry}"
                    Command="{Binding RetryCommand}" />
          </StackPanel>
        </Border>

        <!-- Placeholders for phase 3 -->
        <Border Grid.Row="1"
                Classes="card"
                Width="{StaticResource Session.StatusWidth}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding ShowSummary}">
          <StackPanel Spacing="{StaticResource Space.12}">
            <TextBlock Classes="subheading"
                       FontWeight="{StaticResource FontWeight.BodyMedium}"
                       Text="{x:Static res:Strings.Session_TabSummary}" />
            <TextBlock Classes="body"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Graphite}"
                       Text="{x:Static res:Strings.Session_SummaryPlaceholder}" />
          </StackPanel>
        </Border>
        <!-- "Ask AI" tab: chat about this session; chips seek the player -->
        <Panel Grid.Row="1"
               IsVisible="{Binding ShowAsk}">
          <views:ChatView DataContext="{Binding Chat}" />
        </Panel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
