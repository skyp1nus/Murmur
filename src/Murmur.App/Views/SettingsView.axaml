<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Murmur.App.ViewModels"
             xmlns:res="using:Murmur.App.Resources"
             xmlns:controls="using:Murmur.App.Controls"
             x:Class="Murmur.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <!--
    The Settings page of the canvas (Settings.dc.html / SettingsDark.dc.html), in the page area below the top bar: a column of at
    most 980 px with 32 px at the sides (16 above, 96 below), the title, then the sections as two columns (title and explanation |
    controls) with a hairline between them: Models (the list and the Acceleration card), Devices, Storage, Hotkeys, About. The
    sections the canvas has no room for (theme, languages, recording defaults, the introduction) follow as "Preferences".
    Everything the canvas does not draw stays out of the drawn state: row actions show on hover or focus, notes and counts sit
    in the left column under the explanation, errors appear only when there is one.
    Colours, fonts, type, spacing and radii are tokens; below are only the sizes of this page's own components.
  -->

  <UserControl.Resources>
    <ResourceDictionary>
      <Thickness x:Key="Settings.PagePadding">32,16,32,96</Thickness>
      <Thickness x:Key="Settings.RowPadding">20,18</Thickness>
      <Thickness x:Key="Settings.HotkeyPadding">20,14</Thickness>
      <Thickness x:Key="Settings.CardPadding">20,18</Thickness>
      <Thickness x:Key="Settings.ChipPadding">12,0</Thickness>
      <Thickness x:Key="Settings.ButtonPadding">14,0</Thickness>
      <Thickness x:Key="Settings.FieldButtonPadding">16,0</Thickness>
      <Thickness x:Key="Settings.BadgePadding">8,2</Thickness>
      <Thickness x:Key="Settings.ProgressMargin">0,5,0,0</Thickness>
      <Thickness x:Key="Settings.TitleGap">0,0,0,3</Thickness>
      <Thickness x:Key="Settings.SideNotes">0,10,0,0</Thickness>
      <Thickness x:Key="Settings.NoteGap">0,4,0,0</Thickness>
      <Thickness x:Key="Settings.SizeGap">0,0,8,0</Thickness>
      <!-- Another 48 px before the sections the canvas does not have: the board ends 96 px below the About card, so none of them shows on it. -->
      <Thickness x:Key="Settings.ExtraGap">0,48,0,0</Thickness>
      <Thickness x:Key="Settings.CardDetails">0,14,0,0</Thickness>
      <x:Double x:Key="Settings.Icon15">15</x:Double>
      <x:Double x:Key="Settings.Icon16">16</x:Double>
      <x:Double x:Key="Settings.Chip">30</x:Double>
      <x:Double x:Key="Settings.Button">36</x:Double>
      <x:Double x:Key="Settings.FieldButton">40</x:Double>
      <x:Double x:Key="Settings.Keycap">32</x:Double>
      <x:Double x:Key="Settings.Segment">32</x:Double>
      <x:Double x:Key="Settings.AboutOrb">56</x:Double>
      <x:Double x:Key="Settings.FieldMinWidth">260</x:Double>
      <x:Double x:Key="Settings.CardWrap">460</x:Double>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Section title and explanation (left column) -->
    <Style Selector="TextBlock.settingsTitle">
      <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.SubheadingTight}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.SubheadingTight}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.SubheadingTight}" />
    </Style>
    <Style Selector="TextBlock.settingsText">
      <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Message}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.Message}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.Message}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The About card: "Murmur" in the display weight, the licence lines below -->
    <Style Selector="TextBlock.aboutTitle">
      <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.Display}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.AboutTitle}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.AboutTitle}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.AboutTitle}" />
    </Style>
    <Style Selector="TextBlock.credit">
      <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.MetaRelaxed}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.MetaRelaxed}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.MetaRelaxed}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Graphite}" />
    </Style>

    <!-- Rows -->
    <Style Selector="TextBlock.settingsRowTitle">
      <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.RowTitleTight}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.RowTitleTight}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.RowTitleTight}" />
    </Style>
    <Style Selector="TextBlock.settingsMeta">
      <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.MetaTight}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.MetaTight}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.MetaTight}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.settingsMeta.graphite">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Graphite}" />
    </Style>
    <Style Selector="TextBlock.settingsLabel">
      <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.MetaTight}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.MetaTight}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.MetaTight}" />
    </Style>
    <Style Selector="TextBlock.settingsBody">
      <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.BodySmTight}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.BodySmTight}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.BodySmTight}" />
    </Style>
    <Style Selector="TextBlock.settingsMono">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.Mono}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.MonoSmall}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.MonoSmall}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.MonoSmall}" />
    </Style>
    <Style Selector="TextBlock.settingsPath">
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.Mono}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.MonoRow}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.MonoRow}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.MonoRow}" />
    </Style>

    <!-- A row of a bordered list: hairline above every row but the first -->
    <Style Selector="Border.settingsRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="{StaticResource Settings.RowPadding}" />
    </Style>
    <Style Selector="Border.settingsRow.hotkey">
      <Setter Property="Padding" Value="{StaticResource Settings.HotkeyPadding}" />
    </Style>
    <Style Selector="ItemsControl.rows ContentPresenter:nth-child(1n+2) > Border.settingsRow">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
      <Setter Property="BorderThickness" Value="{StaticResource Hairline.Top}" />
    </Style>

    <!-- "Installed" -->
    <Style Selector="Border.settingsChip">
      <Setter Property="Height" Value="{StaticResource Settings.Chip}" />
      <Setter Property="Padding" Value="{StaticResource Settings.ChipPadding}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.settingsChip TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.SmallTight}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.SmallTight}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.SmallTight}" />
    </Style>

    <!-- "Default" -->
    <Style Selector="Border.settingsBadge">
      <Setter Property="Padding" Value="{StaticResource Settings.BadgePadding}" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.ButtonBorder}" />
      <Setter Property="BorderThickness" Value="{StaticResource Hairline.Thickness}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.settingsBadge TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Tag}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.Tag}" />
      <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.Tag}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Graphite}" />
    </Style>

    <!-- Outline pill buttons of the page: 36 px (rows) or 40 px (the storage row), 13 px label without tracking -->
    <Style Selector="Button.outline.settingsButton">
      <Setter Property="Height" Value="{StaticResource Settings.Button}" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="{StaticResource Settings.ButtonPadding}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Meta}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.outline.settingsButton.field">
      <Setter Property="Height" Value="{StaticResource Settings.FieldButton}" />
      <Setter Property="Padding" Value="{StaticResource Settings.FieldButtonPadding}" />
    </Style>
    <Style Selector="Button.outline.settingsButton.quiet">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Graphite}" />
    </Style>
    <Style Selector="Button.outline.settingsButton.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <!-- The label is a TextBlock (an icon may sit beside it): it takes the colour of the button's state itself -->
    <Style Selector="Button.outline.settingsButton TextBlock">
      <Setter Property="LetterSpacing" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>
    <Style Selector="Button.outline.settingsButton.quiet TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Graphite}" />
    </Style>
    <Style Selector="Button.outline.settingsButton:pointerover.quiet TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>
    <Style Selector="Button.outline.settingsButton:disabled TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ash}" />
    </Style>

    <!-- Hotkey caps: 32 px tall, 12 px Geist Mono -->
    <Style Selector="Button.keycap.settingsKeycap">
      <Setter Property="Height" Value="{StaticResource Settings.Keycap}" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="{StaticResource Settings.ChipPadding}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.MonoSmall}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- The path of the recordings folder -->
    <Style Selector="Border.settingsField">
      <Setter Property="Height" Value="{StaticResource Size.Field}" />
      <Setter Property="Padding" Value="{StaticResource Inset.Input}" />
      <Setter Property="Background" Value="{DynamicResource Brush.OnbField}" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Input}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
      <Setter Property="BorderThickness" Value="{StaticResource Hairline.Thickness}" />
      <Setter Property="MinWidth" Value="{StaticResource Settings.FieldMinWidth}" />
    </Style>

    <!-- The Acceleration card and its segmented control -->
    <Style Selector="Border.settingsCard">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
      <Setter Property="Padding" Value="{StaticResource Settings.CardPadding}" />
    </Style>
    <Style Selector="Border.settingsSegments">
      <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
      <Setter Property="BorderThickness" Value="{DynamicResource Settings.SegmentBorder}" />
      <Setter Property="Padding" Value="{StaticResource Inset.4}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.settingsSegment">
      <Setter Property="Height" Value="{StaticResource Settings.Segment}" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="{StaticResource Inset.Toggle}" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Graphite}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.Meta}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.settingsSegment TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Graphite}" />
      <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
      <Setter Property="FontSize" Value="{StaticResource FontSize.MetaTight}" />
      <Setter Property="LineHeight" Value="{StaticResource LineHeight.MetaTight}" />
      <Setter Property="LetterSpacing" Value="0" />
    </Style>
    <Style Selector="Button.settingsSegment:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>
    <Style Selector="Button.settingsSegment.on TextBlock, Button.settingsSegment.on:pointerover TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Canvas}" />
    </Style>
    <Style Selector="Button.settingsSegment:disabled TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ash}" />
    </Style>
    <Style Selector="Button.settingsSegment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.FillHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>
    <Style Selector="Button.settingsSegment.on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Canvas}" />
    </Style>
    <Style Selector="Button.settingsSegment.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.InkHover}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Canvas}" />
    </Style>
    <Style Selector="Button.settingsSegment:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ash}" />
    </Style>

    <!-- Model rows: the actions of an installed row (Make default, Remove) show in place of its size and status while the pointer or the focus is in the row -->
    <Style Selector="StackPanel.settingsActions.reveal">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.settingsModel:pointerover StackPanel.settingsActions.reveal, Border.settingsModel:focus-within StackPanel.settingsActions.reveal, Border.settingsModel.confirming StackPanel.settingsActions.reveal">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="Border.settingsModel:pointerover StackPanel.settingsRest.reveal, Border.settingsModel:focus-within StackPanel.settingsRest.reveal, Border.settingsModel.confirming StackPanel.settingsRest.reveal">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="StackPanel.settingsTitleRow.withProgress">
      <Setter Property="Margin" Value="{StaticResource Settings.TitleGap}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer x:Name="Scroller"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <Border x:Name="Page"
            MaxWidth="{StaticResource Size.SettingsMaxWidth}"
            HorizontalAlignment="Stretch"
            Padding="{StaticResource Settings.PagePadding}">
      <StackPanel Spacing="{StaticResource Space.48}">

        <TextBlock Classes="pageTitle"
                   Text="{x:Static res:Strings.Settings_Title}" />

        <!-- Models -->
        <controls:ResponsivePairPanel x:Name="ModelsSection"
                                      IsVisible="{Binding HasModels}"
                                      LeftWidth="{StaticResource Size.SettingsSide}"
                                      WrapBelow="{StaticResource Size.SettingsWrap}"
                                      ColumnSpacing="{StaticResource Space.40}"
                                      RowSpacing="{StaticResource Space.24}">
          <StackPanel Spacing="{StaticResource Space.6}">
            <TextBlock Classes="settingsTitle"
                       Text="{x:Static res:Strings.Settings_ModelsTitle}" />
            <TextBlock Classes="settingsText"
                       Text="{x:Static res:Strings.Settings_ModelsText}" />
            <StackPanel Margin="{StaticResource Settings.SideNotes}"
                        Spacing="{StaticResource Space.6}">
              <TextBlock Classes="settingsMeta"
                         IsVisible="{Binding Models.HasAiNote}"
                         Text="{x:Static res:Strings.Models_AiNote}" />
              <TextBlock Classes="settingsMeta"
                         IsVisible="{Binding Models.HasFreeSpace}"
                         Text="{Binding Models.FreeSpaceText}" />
              <TextBlock Classes="settingsMeta"
                         Text="{Binding Models.FolderText}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="{StaticResource Space.16}">
            <Border Classes="panel">
              <ItemsControl Classes="rows"
                            ItemsSource="{Binding Models.Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ModelRowViewModel">
                    <Border Classes="settingsRow settingsModel"
                            Classes.confirming="{Binding IsConfirmingRemove}">
                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="{StaticResource Space.16}">
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Spacing="{StaticResource Space.3}">
                          <StackPanel Classes="settingsTitleRow"
                                      Classes.withProgress="{Binding ShowProgress}"
                                      Orientation="Horizontal"
                                      Spacing="{StaticResource Space.8}">
                            <TextBlock Classes="settingsRowTitle"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Name}" />
                            <Border Classes="settingsBadge"
                                    IsVisible="{Binding HasBadge}">
                              <TextBlock Text="{Binding BadgeText}" />
                            </Border>
                          </StackPanel>
                          <TextBlock Classes="settingsMeta"
                                     Text="{Binding Description}" />
                          <StackPanel Orientation="Horizontal"
                                      Margin="{StaticResource Settings.ProgressMargin}"
                                      Spacing="{StaticResource Space.10}"
                                      IsVisible="{Binding ShowProgress}">
                            <ProgressBar Width="{StaticResource Size.ProgressWidth}"
                                         Height="{StaticResource Size.Progress}"
                                         VerticalAlignment="Center"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding Percent}" />
                            <TextBlock Classes="settingsMono"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Graphite}"
                                       Text="{Binding PercentText}" />
                            <TextBlock Classes="settingsMono"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Smoke}"
                                       Text="{Binding TransferText}" />
                          </StackPanel>
                          <TextBlock Classes="settingsMeta graphite"
                                     IsVisible="{Binding IsQueued}"
                                     Text="{Binding QueuedText}" />
                          <TextBlock Classes="settingsMeta graphite"
                                     IsVisible="{Binding HasError}"
                                     Text="{Binding Error}" />
                        </StackPanel>

                        <!-- Size and status; an installed row shows its actions here while the pointer or the focus is in the row. -->
                        <Panel Grid.Column="1"
                               VerticalAlignment="Center">
                          <StackPanel Classes="settingsRest"
                                      Classes.reveal="{Binding IsInstalled}"
                                      HorizontalAlignment="Right"
                                      Orientation="Horizontal"
                                      Spacing="{StaticResource Space.16}">
                            <TextBlock Classes="settingsMono"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Smoke}"
                                       IsVisible="{Binding IsInstalled}"
                                       Text="{Binding SizeText}" />
                            <Border Classes="settingsChip"
                                    IsVisible="{Binding IsInstalled}">
                              <StackPanel Orientation="Horizontal"
                                          Spacing="{StaticResource Space.6}">
                                <controls:IconControl Width="{StaticResource Size.SmallIcon}"
                                                      Height="{StaticResource Size.SmallIcon}"
                                                      Data="{StaticResource Icon.Check}" />
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding InstalledText}" />
                              </StackPanel>
                            </Border>
                          </StackPanel>
                          <StackPanel Classes="settingsActions"
                                      Classes.reveal="{Binding IsInstalled}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Orientation="Horizontal"
                                      Spacing="{StaticResource Space.8}">
                            <TextBlock Classes="settingsMono"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Smoke}"
                                       Margin="{StaticResource Settings.SizeGap}"
                                       IsVisible="{Binding ShowSizeBesideActions}"
                                       Text="{Binding SizeText}" />
                            <Button Classes="outline settingsButton"
                                    IsVisible="{Binding ShowMakeDefault}"
                                    Command="{Binding MakeDefaultCommand}">
                              <TextBlock Text="{x:Static res:Strings.Models_MakeDefault}" />
                            </Button>
                            <Button Classes="outline settingsButton"
                                    IsVisible="{Binding ShowRemove}"
                                    Command="{Binding RequestRemoveCommand}">
                              <TextBlock Text="{x:Static res:Strings.Models_Remove}" />
                            </Button>
                            <Button Classes="outline settingsButton"
                                    IsVisible="{Binding IsConfirmingRemove}"
                                    Command="{Binding ConfirmRemoveCommand}">
                              <TextBlock Text="{x:Static res:Strings.Models_RemoveConfirm}" />
                            </Button>
                            <Button Classes="outline settingsButton"
                                    IsVisible="{Binding IsConfirmingRemove}"
                                    Command="{Binding CancelRemoveCommand}">
                              <TextBlock Text="{x:Static res:Strings.Models_Cancel}" />
                            </Button>
                            <Button Classes="outline settingsButton"
                                    IsVisible="{Binding ShowInstall}"
                                    Command="{Binding InstallCommand}">
                              <StackPanel Orientation="Horizontal"
                                          Spacing="{StaticResource Space.8}">
                                <controls:IconControl Width="{StaticResource Settings.Icon15}"
                                                      Height="{StaticResource Settings.Icon15}"
                                                      Data="{StaticResource Icon.Download}" />
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding InstallLabel}" />
                              </StackPanel>
                            </Button>
                            <Button Classes="outline settingsButton"
                                    IsVisible="{Binding ShowCancel}"
                                    Command="{Binding CancelCommand}">
                              <TextBlock Text="{x:Static res:Strings.Models_Cancel}" />
                            </Button>
                          </StackPanel>
                        </Panel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

            <!-- Acceleration (D-042): CPU / Vulkan / CUDA, the runtime download and the reason a GPU build does not run -->
            <Border x:Name="AccelerationCard"
                    Classes="settingsCard"
                    IsVisible="{Binding HasModels}">
              <StackPanel DataContext="{Binding Acceleration}"
                          x:DataType="vm:AccelerationSettingsViewModel">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="{StaticResource Space.16}">
                  <StackPanel Grid.Column="0"
                              VerticalAlignment="Center"
                              Spacing="{StaticResource Space.3}">
                    <TextBlock Classes="settingsBody"
                               FontWeight="{StaticResource FontWeight.BodyMedium}"
                               Text="{x:Static res:Strings.Accel_Title}" />
                    <TextBlock Classes="settingsMeta"
                               Text="{x:Static res:Strings.Accel_Text}" />
                  </StackPanel>
                  <Border Grid.Column="1"
                          Classes="settingsSegments">
                    <ItemsControl x:Name="AccelerationOptions"
                                  ItemsSource="{Binding Options}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"
                                      Spacing="{StaticResource Space.4}" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccelerationOptionViewModel">
                          <Button Classes="settingsSegment"
                                  Classes.on="{Binding IsSelected}"
                                  IsEnabled="{Binding IsAvailable}"
                                  ToolTip.Tip="{Binding Tooltip}"
                                  ToolTip.ShowOnDisabled="True"
                                  AutomationProperties.Name="{Binding Label}"
                                  AutomationProperties.HelpText="{Binding Tooltip}"
                                  Command="{Binding ChooseCommand}">
                            <TextBlock Text="{Binding Label}" />
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </Grid>

                <!-- Only while there is something to say: a note, the download with its progress, an error -->
                <StackPanel Margin="{StaticResource Settings.CardDetails}"
                            Spacing="{StaticResource Space.10}"
                            IsVisible="{Binding HasDetails}">
                  <TextBlock Classes="settingsMeta graphite"
                             IsVisible="{Binding HasNote}"
                             Text="{Binding NoteText}" />
                  <StackPanel Orientation="Horizontal"
                              Spacing="{StaticResource Space.10}"
                              IsVisible="{Binding IsDownloading}">
                    <ProgressBar Width="{StaticResource Size.ProgressWidth}"
                                 Height="{StaticResource Size.Progress}"
                                 VerticalAlignment="Center"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding Percent}" />
                    <TextBlock Classes="settingsMono"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Graphite}"
                               Text="{Binding PercentText}" />
                    <TextBlock Classes="settingsMono"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Smoke}"
                               Text="{Binding TransferText}" />
                    <Button Classes="outline settingsButton"
                            Command="{Binding CancelDownloadCommand}">
                      <TextBlock Text="{x:Static res:Strings.Models_Cancel}" />
                    </Button>
                  </StackPanel>
                  <TextBlock Classes="settingsMeta graphite"
                             IsVisible="{Binding HasError}"
                             Text="{Binding Error}" />
                  <Button x:Name="AccelerationDownload"
                          Classes="outline settingsButton"
                          HorizontalAlignment="Left"
                          IsVisible="{Binding CanDownload}"
                          Command="{Binding DownloadCommand}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="{StaticResource Space.8}">
                      <controls:IconControl Width="{StaticResource Settings.Icon15}"
                                            Height="{StaticResource Settings.Icon15}"
                                            Data="{StaticResource Icon.Download}" />
                      <TextBlock VerticalAlignment="Center"
                                 Text="{x:Static res:Strings.Models_Install}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </controls:ResponsivePairPanel>

        <Border Classes="divider"
                IsVisible="{Binding HasModels}" />

        <!-- Devices -->
        <controls:ResponsivePairPanel x:Name="DevicesSection"
                                      LeftWidth="{StaticResource Size.SettingsSide}"
                                      WrapBelow="{StaticResource Size.SettingsWrap}"
                                      ColumnSpacing="{StaticResource Space.40}"
                                      RowSpacing="{StaticResource Space.24}">
          <StackPanel Spacing="{StaticResource Space.6}">
            <TextBlock Classes="settingsTitle"
                       Text="{x:Static res:Strings.Settings_DevicesTitle}" />
            <TextBlock Classes="settingsText"
                       Text="{x:Static res:Strings.Settings_DevicesText}" />
            <StackPanel Margin="{StaticResource Settings.SideNotes}"
                        Spacing="{StaticResource Space.6}">
              <TextBlock Classes="settingsMeta"
                         IsVisible="{Binding Devices.ScreenAvailable}"
                         Text="{x:Static res:Strings.Devices_ScreenNote}" />
              <TextBlock Classes="settingsMeta"
                         IsVisible="{Binding Devices.ScreenUnavailable}"
                         Text="{x:Static res:Strings.Devices_ScreenUnavailable}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="{StaticResource Space.16}">
            <StackPanel Spacing="{StaticResource Space.6}">
              <TextBlock Classes="settingsLabel"
                         Text="{x:Static res:Strings.Common_Microphone}" />
              <ComboBox x:Name="MicrophoneBox"
                        Classes="onb"
                        ItemsSource="{Binding Devices.Microphones}"
                        SelectedItem="{Binding Devices.SelectedMicrophone, Mode=TwoWay}"
                        IsEnabled="{Binding Devices.MicrophoneAvailable}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChoiceItem">
                    <TextBlock Classes="settingsBody"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Spacing="{StaticResource Space.6}">
              <TextBlock Classes="settingsLabel"
                         Text="{x:Static res:Strings.Recording_SystemAudio}" />
              <ComboBox x:Name="SystemAudioBox"
                        Classes="onb"
                        ItemsSource="{Binding Devices.SystemDevices}"
                        SelectedItem="{Binding Devices.SelectedSystemDevice, Mode=TwoWay}"
                        IsEnabled="{Binding Devices.SystemAudioAvailable}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChoiceItem">
                    <TextBlock Classes="settingsBody"
                               Text="{Binding LoopbackName}"
                               TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Spacing="{StaticResource Space.6}">
              <TextBlock Classes="settingsLabel"
                         Text="{x:Static res:Strings.Devices_Screen}" />
              <ComboBox x:Name="DisplayBox"
                        Classes="onb"
                        ItemsSource="{Binding Devices.Displays}"
                        SelectedItem="{Binding Devices.SelectedDisplay, Mode=TwoWay}"
                        IsEnabled="{Binding Devices.ScreenAvailable}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChoiceItem">
                    <TextBlock Classes="settingsBody"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <TextBlock Classes="settingsMeta graphite"
                       IsVisible="{Binding Devices.HasError}"
                       Text="{Binding Devices.Error}" />
          </StackPanel>
        </controls:ResponsivePairPanel>

        <Border Classes="divider" />

        <!-- Storage -->
        <controls:ResponsivePairPanel x:Name="StorageSection"
                                      LeftWidth="{StaticResource Size.SettingsSide}"
                                      WrapBelow="{StaticResource Size.SettingsWrap}"
                                      ColumnSpacing="{StaticResource Space.40}"
                                      RowSpacing="{StaticResource Space.24}">
          <StackPanel Spacing="{StaticResource Space.6}">
            <TextBlock Classes="settingsTitle"
                       Text="{x:Static res:Strings.Settings_StorageTitle}" />
            <TextBlock Classes="settingsText"
                       Text="{x:Static res:Strings.Settings_StorageText}" />
          </StackPanel>
          <StackPanel VerticalAlignment="Center"
                      Spacing="{StaticResource Space.12}">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="{StaticResource Space.12}">
              <Border Grid.Column="0"
                      Classes="settingsField"
                      ToolTip.Tip="{x:Static res:Strings.Storage_Note}">
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="{StaticResource Space.10}">
                  <controls:IconControl Grid.Column="0"
                                        Width="{StaticResource Settings.Icon16}"
                                        Height="{StaticResource Settings.Icon16}"
                                        Data="{StaticResource Icon.Folder}"
                                        TextElement.Foreground="{DynamicResource Brush.Smoke}" />
                  <TextBlock x:Name="RecordingsPath"
                             Grid.Column="1"
                             Classes="settingsPath"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             Text="{Binding Storage.EffectivePath}" />
                  <TextBlock Grid.Column="2"
                             Classes="settingsMeta"
                             VerticalAlignment="Center"
                             IsVisible="{Binding Storage.IsDefaultFolder}"
                             Text="{x:Static res:Strings.Storage_Default}" />
                </Grid>
              </Border>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="{StaticResource Space.12}">
              <Button x:Name="ChangeFolderButton"
                      Classes="outline settingsButton field"
                      Command="{Binding Storage.ChangeCommand}">
                <TextBlock Text="{x:Static res:Strings.Storage_Change}" />
              </Button>
              <Button x:Name="OpenFolderButton"
                      Classes="outline settingsButton field quiet"
                      Command="{Binding Storage.OpenCommand}">
                <TextBlock Text="{x:Static res:Strings.Storage_Open}" />
              </Button>
              <Button Classes="outline settingsButton field"
                      IsVisible="{Binding Storage.CanReset}"
                      Command="{Binding Storage.ResetCommand}">
                <TextBlock Text="{x:Static res:Strings.Storage_Reset}" />
              </Button>
              </StackPanel>
            </Grid>
            <TextBlock Classes="settingsMeta graphite"
                       IsVisible="{Binding Storage.HasError}"
                       Text="{Binding Storage.Error}" />
          </StackPanel>
        </controls:ResponsivePairPanel>

        <Border Classes="divider" />

        <!-- Hotkeys -->
        <controls:ResponsivePairPanel x:Name="HotkeysSection"
                                      LeftWidth="{StaticResource Size.SettingsSide}"
                                      WrapBelow="{StaticResource Size.SettingsWrap}"
                                      ColumnSpacing="{StaticResource Space.40}"
                                      RowSpacing="{StaticResource Space.24}">
          <StackPanel Spacing="{StaticResource Space.6}">
            <TextBlock Classes="settingsTitle"
                       Text="{x:Static res:Strings.Settings_HotkeysTitle}" />
            <TextBlock Classes="settingsText"
                       Text="{x:Static res:Strings.Settings_HotkeysText}" />
          </StackPanel>
          <StackPanel Spacing="{StaticResource Space.12}">
            <Border Classes="panel">
              <ItemsControl Classes="rows"
                            ItemsSource="{Binding Hotkeys.Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HotkeyRowViewModel">
                    <Border Classes="settingsRow hotkey">
                      <Grid ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="{StaticResource Space.12}">
                        <TextBlock Grid.Column="0"
                                   Classes="settingsBody"
                                   VerticalAlignment="Center"
                                   Text="{Binding Label}" />
                        <Button Grid.Column="1"
                                Classes="keycap settingsKeycap"
                                Classes.capturing="{Binding IsCapturing}"
                                Content="{Binding DisplayText}"
                                Command="{Binding CaptureCommand}" />
                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Margin="{StaticResource Settings.NoteGap}"
                                   Classes="settingsMeta"
                                   IsVisible="{Binding IsCapturing}"
                                   Text="{Binding Hint}" />
                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Margin="{StaticResource Settings.NoteGap}"
                                   Classes="settingsMeta graphite"
                                   IsVisible="{Binding HasError}"
                                   Text="{Binding Error}" />
                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Margin="{StaticResource Settings.NoteGap}"
                                   Classes="settingsMeta"
                                   IsVisible="{Binding ShowRegistrationNote}"
                                   Text="{Binding RegistrationNote}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <TextBlock Classes="settingsMeta graphite"
                       IsVisible="{Binding Hotkeys.HasError}"
                       Text="{Binding Hotkeys.Error}" />
          </StackPanel>
        </controls:ResponsivePairPanel>

        <Border Classes="divider" />

        <!-- About -->
        <controls:ResponsivePairPanel x:Name="AboutSection"
                                      LeftWidth="{StaticResource Size.SettingsSide}"
                                      WrapBelow="{StaticResource Size.SettingsWrap}"
                                      ColumnSpacing="{StaticResource Space.40}"
                                      RowSpacing="{StaticResource Space.24}">
          <StackPanel Spacing="{StaticResource Space.6}">
            <TextBlock Classes="settingsTitle"
                       Text="{x:Static res:Strings.Settings_AboutTitle}" />
            <TextBlock Classes="settingsText"
                       Text="{x:Static res:Strings.Settings_AboutText}" />
          </StackPanel>
          <StackPanel Spacing="{StaticResource Space.10}">
          <Border Classes="well">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="{StaticResource Space.20}">
              <controls:OrbDisc Glow="True"
                                Width="{StaticResource Settings.AboutOrb}"
                                Height="{StaticResource Settings.AboutOrb}"
                                VerticalAlignment="Top" />
              <StackPanel Grid.Column="1"
                          Spacing="{StaticResource Space.8}">
                <StackPanel Orientation="Horizontal"
                            Spacing="{StaticResource Space.10}">
                  <TextBlock Classes="aboutTitle"
                             Text="Murmur" />
                  <TextBlock x:Name="VersionText"
                             Classes="settingsMono"
                             VerticalAlignment="Bottom"
                             Foreground="{DynamicResource Brush.Smoke}"
                             Text="{Binding About.Version}" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Classes="credit"
                             Text="{Binding About.License}" />
                  <TextBlock Classes="credit"
                             Text="{Binding About.ParakeetCredit}" />
                  <TextBlock Classes="credit"
                             Text="{Binding About.GoogleCredit}" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
          <TextBlock Classes="settingsMeta"
                     Text="{Binding About.OtherCredits}" />
          </StackPanel>
        </controls:ResponsivePairPanel>

        <Border Classes="divider"
                Margin="{StaticResource Settings.ExtraGap}" />

        <!-- Preferences: what the canvas has no room for (after the drawn sections, so the board is unchanged) -->
        <controls:ResponsivePairPanel x:Name="AppearanceSection"
                                      LeftWidth="{StaticResource Size.SettingsSide}"
                                      WrapBelow="{StaticResource Size.SettingsWrap}"
                                      ColumnSpacing="{StaticResource Space.40}"
                                      RowSpacing="{StaticResource Space.24}">
          <StackPanel Spacing="{StaticResource Space.6}">
            <TextBlock Classes="settingsTitle"
                       Text="{x:Static res:Strings.Settings_AppearanceTitle}" />
            <TextBlock Classes="settingsText"
                       Text="{x:Static res:Strings.Settings_AppearanceText}" />
          </StackPanel>
          <StackPanel Spacing="{StaticResource Space.24}">
            <StackPanel Spacing="{StaticResource Space.8}">
              <TextBlock Classes="settingsLabel"
                         Text="{x:Static res:Strings.Appearance_Theme}" />
              <StackPanel Orientation="Horizontal"
                          Spacing="{StaticResource Space.8}">
                <ToggleButton x:Name="ThemeLight"
                              Classes="pill"
                              Content="{x:Static res:Strings.Appearance_ThemeLight}"
                              IsChecked="{Binding Appearance.IsLight, Mode=TwoWay}" />
                <ToggleButton x:Name="ThemeDark"
                              Classes="pill"
                              Content="{x:Static res:Strings.Appearance_ThemeDark}"
                              IsChecked="{Binding Appearance.IsDark, Mode=TwoWay}" />
                <ToggleButton x:Name="ThemeSystem"
                              Classes="pill"
                              Content="{x:Static res:Strings.Appearance_ThemeSystem}"
                              IsChecked="{Binding Appearance.IsSystem, Mode=TwoWay}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Spacing="{StaticResource Space.8}">
              <TextBlock Classes="settingsLabel"
                         Text="{x:Static res:Strings.Appearance_Language}" />
              <StackPanel Orientation="Horizontal"
                          Spacing="{StaticResource Space.8}">
                <ToggleButton x:Name="LanguageUk"
                              Classes="pill"
                              Content="{x:Static res:Strings.Appearance_LanguageUk}"
                              IsChecked="{Binding Appearance.IsUkrainian, Mode=TwoWay}" />
                <ToggleButton x:Name="LanguageEn"
                              Classes="pill"
                              Content="{x:Static res:Strings.Appearance_LanguageEn}"
                              IsChecked="{Binding Appearance.IsEnglish, Mode=TwoWay}" />
              </StackPanel>
              <TextBlock Classes="settingsMeta"
                         IsVisible="{Binding Appearance.NeedsRestart}"
                         Text="{x:Static res:Strings.Appearance_RestartNote}" />
            </StackPanel>
            <StackPanel Spacing="{StaticResource Space.6}">
              <TextBlock Classes="settingsLabel"
                         Text="{x:Static res:Strings.Onb4_Language}" />
              <ComboBox x:Name="TranscriptionLanguageBox"
                        Classes="onb"
                        ItemsSource="{Binding Appearance.TranscriptionLanguages}"
                        SelectedIndex="0"
                        IsEnabled="False">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Classes="settingsBody"
                               Text="{Binding}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="settingsMeta"
                         Text="{x:Static res:Strings.Onb4_LanguageText}" />
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="{StaticResource Space.16}"
                  IsVisible="{Binding Devices.ScreenAvailable}">
              <StackPanel Grid.Column="0"
                          VerticalAlignment="Center"
                          Spacing="{StaticResource Space.3}">
                <TextBlock Classes="settingsLabel"
                           Text="{x:Static res:Strings.Devices_ScreenByDefault}" />
                <TextBlock Classes="settingsMeta"
                           Text="{x:Static res:Strings.Devices_ScreenByDefaultText}" />
              </StackPanel>
              <ToggleButton Grid.Column="1"
                            x:Name="ScreenByDefaultToggle"
                            Classes="pill"
                            VerticalAlignment="Center"
                            Content="{Binding Devices.ScreenByDefaultLabel}"
                            IsChecked="{Binding Devices.ScreenByDefault, Mode=TwoWay}" />
            </Grid>
            <StackPanel Spacing="{StaticResource Space.8}">
              <TextBlock Classes="settingsLabel"
                         Text="{x:Static res:Strings.Appearance_Onboarding}" />
              <Button x:Name="RestartOnboardingButton"
                      Classes="outline settingsButton"
                      HorizontalAlignment="Left"
                      Command="{Binding Appearance.RestartOnboardingCommand}">
                <TextBlock Text="{x:Static res:Strings.Appearance_OnboardingRestart}" />
              </Button>
              <TextBlock Classes="settingsMeta"
                         IsVisible="{Binding Appearance.OnboardingOpensNow}"
                         Text="{x:Static res:Strings.Appearance_OnboardingDone}" />
              <TextBlock Classes="settingsMeta"
                         x:Name="OnboardingDeferredNote"
                         IsVisible="{Binding Appearance.OnboardingDeferred}"
                         Text="{x:Static res:Strings.Appearance_OnboardingDeferred}" />
            </StackPanel>
            <TextBlock Classes="settingsMeta graphite"
                       IsVisible="{Binding Appearance.HasError}"
                       Text="{Binding Appearance.Error}" />
          </StackPanel>
        </controls:ResponsivePairPanel>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
