<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Murmur.App.ViewModels"
             xmlns:res="using:Murmur.App.Resources"
             xmlns:controls="using:Murmur.App.Controls"
             ClipToBounds="False"
             x:Class="Murmur.App.Views.ModelsStepView"
             x:DataType="vm:ModelsStepViewModel">

  <!-- Step 3: the required transcription model downloads by itself; the AI model is chosen. -->
  <StackPanel Classes="onbStep"
              HorizontalAlignment="Stretch">

    <StackPanel Spacing="{StaticResource Space.12}"
                HorizontalAlignment="Center">
      <TextBlock Classes="onbH1"
                 Text="{Binding Title}" />
      <TextBlock Classes="onbSub"
                 Text="{Binding Subtitle}" />
    </StackPanel>

    <!-- No model manager (designer, tests): nothing to download. -->
    <TextBlock Classes="onbNote"
               HorizontalAlignment="Center"
               IsVisible="{Binding IsUnavailable}"
               Text="{x:Static res:Strings.Onb3_Unavailable}" />

    <StackPanel MaxWidth="{StaticResource Size.OnbModelsWidth}"
                HorizontalAlignment="Stretch"
                Spacing="{StaticResource Space.14}"
                IsVisible="{Binding IsAvailable}">

      <!-- Required: transcription -->
      <Border x:Name="RequiredCard"
              Classes="panel"
              Padding="{StaticResource Margin.OnbModel}">
        <StackPanel Spacing="{StaticResource Space.14}">
          <Grid ColumnDefinitions="*,Auto"
                ColumnSpacing="{StaticResource Space.16}">
            <StackPanel Spacing="{StaticResource Space.3}"
                        VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal"
                          Spacing="{StaticResource Space.8}">
                <TextBlock Classes="onbTitle"
                           VerticalAlignment="Center"
                           Text="{x:Static res:Strings.Onb3_Transcription}" />
                <Border Classes="onbTagBox">
                  <TextBlock Classes="onbTag"
                             Foreground="{DynamicResource Brush.Graphite}"
                             Text="{x:Static res:Strings.Onb3_Required}" />
                </Border>
              </StackPanel>
              <TextBlock Classes="onbNote"
                         Text="{x:Static res:Strings.Onb3_TranscriptionText}" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="{StaticResource Space.12}"
                        VerticalAlignment="Center">
              <TextBlock Classes="onbMono"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.Graphite}"
                         Text="{Binding RequiredSizeText}" />
              <Border Classes="onbStatus"
                      IsVisible="{Binding IsRequiredReady}">
                <StackPanel Orientation="Horizontal"
                            Spacing="{StaticResource Space.6}">
                  <controls:IconControl Width="{StaticResource Size.OnbCheck}"
                                        Height="{StaticResource Size.OnbCheck}"
                                        Stroke="{StaticResource Onb.Stroke.Check}"
                                        Data="{StaticResource Icon.Check}" />
                  <TextBlock Classes="onbLabelMedium"
                             VerticalAlignment="Center"
                             Text="{x:Static res:Strings.Onb3_Ready}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
          <ProgressBar x:Name="RequiredProgress"
                       Height="{StaticResource Size.Progress}"
                       Minimum="0"
                       Maximum="100"
                       Value="{Binding RequiredPercent}" />
          <Grid ColumnDefinitions="*,Auto"
                IsVisible="{Binding !IsRequiredReady}">
            <TextBlock Classes="onbNote"
                       Text="{Binding RequiredStatusText}" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="{StaticResource Space.12}">
              <TextBlock Classes="onbMono"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.Smoke}"
                         Text="{Binding RequiredTransferText}" />
              <Button x:Name="RetryRequiredButton"
                      Classes="outline compact"
                      IsVisible="{Binding IsRequiredFailed}"
                      Content="{x:Static res:Strings.Models_Retry}"
                      Command="{Binding RetryRequiredCommand}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Optional: the AI assistant -->
      <Grid ColumnDefinitions="*,Auto"
            Margin="{StaticResource Margin.OnbCardLabel}">
        <TextBlock Classes="onbNoteMedium"
                   Text="{x:Static res:Strings.Onb3_AiTitle}" />
        <TextBlock Grid.Column="1"
                   Classes="onbNote"
                   Text="{x:Static res:Strings.Onb3_AiText}" />
      </Grid>

      <ItemsControl x:Name="AiChoices"
                    ItemsSource="{Binding Choices}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1"
                         ColumnSpacing="{StaticResource Space.14}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AiChoiceViewModel">
            <Button Classes="choice"
                    Classes.on="{Binding IsSelected}"
                    IsEnabled="{Binding IsEnabled}"
                    Command="{Binding SelectCommand}">
              <Grid ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="{StaticResource Space.14}">
                <Border Classes="radio"
                        Classes.on="{Binding IsSelected}">
                  <Ellipse />
                </Border>
                <StackPanel Grid.Column="1"
                            Spacing="{StaticResource Space.4}">
                  <TextBlock Classes="onbTitle"
                             TextWrapping="Wrap"
                             Text="{Binding Name}" />
                  <TextBlock Classes="onbNote"
                             Text="{Binding Description}" />
                  <ProgressBar Height="{StaticResource Size.Progress}"
                               Margin="{StaticResource Margin.OnbCardExtra}"
                               Minimum="0"
                               Maximum="100"
                               Value="{Binding Percent}"
                               IsVisible="{Binding ShowProgress}" />
                  <TextBlock Classes="onbLabel"
                             Margin="{StaticResource Margin.OnbCardExtra}"
                             IsVisible="{Binding HasStatus}"
                             Text="{Binding StatusText}" />
                  <Border Classes="onbStatus inCard"
                          Margin="{StaticResource Margin.OnbCardExtra}"
                          HorizontalAlignment="Left"
                          IsVisible="{Binding IsInstalled}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="{StaticResource Space.6}">
                      <controls:IconControl Width="{StaticResource Size.OnbCheck}"
                                            Height="{StaticResource Size.OnbCheck}"
                                            Stroke="{StaticResource Onb.Stroke.Check}"
                                            Data="{StaticResource Icon.Check}" />
                      <TextBlock Classes="onbLabelMedium"
                                 VerticalAlignment="Center"
                                 Text="{x:Static res:Strings.Onb3_Ready}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Classes="onbMono"
                           Foreground="{DynamicResource Brush.Graphite}"
                           Text="{Binding SizeText}" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid ColumnDefinitions="Auto,*"
            ColumnSpacing="{StaticResource Space.16}"
            Margin="{StaticResource Margin.OnbOptionRow}">
        <Button x:Name="SkipAiButton"
                Classes="option"
                HorizontalAlignment="Left"
                Margin="{StaticResource Margin.OnbOptionPull}"
                Command="{Binding SkipAiCommand}">
          <StackPanel Orientation="Horizontal"
                      Spacing="{StaticResource Space.10}">
            <Border Classes="radio"
                    Classes.on="{Binding SkipAiSelected}"
                    Margin="{StaticResource Margin.OnbRadioFlat}"
                    VerticalAlignment="Center">
              <Ellipse />
            </Border>
            <TextBlock Classes="onbBodyMedium"
                       VerticalAlignment="Center"
                       Text="{x:Static res:Strings.Onb3_SkipAi}" />
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource Space.4}">
          <TextBlock x:Name="BackgroundNote"
                     Classes="onbNote"
                     HorizontalAlignment="Right"
                     IsVisible="{Binding ShowBackgroundNote}"
                     Text="{x:Static res:Strings.Onb3_Background}"
                     ToolTip.Tip="{Binding FreeSpaceTip}" />
          <StackPanel x:Name="AllDoneNote"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="{StaticResource Space.6}"
                      IsVisible="{Binding AllDone}">
            <controls:IconControl Width="{StaticResource Size.OnbNoteCheck}"
                                  Height="{StaticResource Size.OnbNoteCheck}"
                                  Stroke="{StaticResource Onb.Stroke.NoteCheck}"
                                  TextElement.Foreground="{DynamicResource Brush.Graphite}"
                                  Data="{StaticResource Icon.Check}" />
            <TextBlock Classes="onbNote"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Graphite}"
                       Text="{x:Static res:Strings.Onb3_AllDone}" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <TextBlock Classes="onbNote"
                 Foreground="{DynamicResource Brush.Graphite}"
                 IsVisible="{Binding HasSpaceMessage}"
                 Text="{Binding SpaceMessage}" />
    </StackPanel>
  </StackPanel>
</UserControl>
