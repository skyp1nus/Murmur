<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Murmur.App.ViewModels"
             xmlns:res="using:Murmur.App.Resources"
             xmlns:controls="using:Murmur.App.Controls"
             x:Class="Murmur.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

  <!--
    The Library page of the canvas (Main.dc.html) as one virtualised list (an items control in a scroll viewer), so the whole page scrolls like the canvas does and a long
    library only builds the rows on screen: the fixed blocks first (heading with the two cards, Recordings with its search box, the
    filters), then the day headings with their rows, the search results, or the empty card.
  -->
  <ItemsControl x:Name="Page"
                Classes="library"
                ItemsSource="{Binding Entries}">
    <ItemsControl.Template>
      <ControlTemplate>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                          Margin="{TemplateBinding Padding}" />
        </ScrollViewer>
      </ControlTemplate>
    </ItemsControl.Template>
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <VirtualizingStackPanel />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.DataTemplates>

      <!-- What are we recording today? + the two cards -->
      <DataTemplate DataType="vm:LibraryHeroEntry">
        <StackPanel DataContext="{Binding Library}"
                    x:DataType="vm:LibraryViewModel"
                    Margin="{StaticResource Margin.HeroTop}"
                    Spacing="{StaticResource Space.24}">
          <TextBlock Classes="pageTitle"
                     TextWrapping="Wrap"
                     Text="{x:Static res:Strings.Library_Heading}" />

          <controls:AutoFitPanel MinColumnWidth="{StaticResource Size.CardMinWidth}"
                                 Spacing="{StaticResource Space.16}">

            <!-- New recording -->
            <Border Classes="heroCard">
              <Grid ColumnDefinitions="Auto,*"
                    ColumnSpacing="{StaticResource Space.28}">
                <Panel Grid.Column="0"
                       Width="{StaticResource Size.HeroOrb}"
                       Height="{StaticResource Size.HeroOrb}"
                       VerticalAlignment="Center">
                  <controls:OrbDisc Glow="True" />
                  <Border Width="{StaticResource Size.HeroPlate}"
                          Height="{StaticResource Size.HeroPlate}"
                          CornerRadius="{StaticResource Radius.Pill}"
                          Background="{DynamicResource Brush.OrbPlate}"
                          BoxShadow="{StaticResource Shadow.Subtle}">
                    <Ellipse Width="{StaticResource Size.HeroDot}"
                             Height="{StaticResource Size.HeroDot}"
                             Fill="{DynamicResource Brush.OrbDot}" />
                  </Border>
                </Panel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="{StaticResource Space.16}">
                  <StackPanel Spacing="{StaticResource Space.6}">
                    <TextBlock Classes="cardTitle"
                               Text="{x:Static res:Strings.Library_NewRecording}" />
                    <TextBlock Classes="paragraph"
                               Text="{x:Static res:Strings.Library_RecordingCardText}" />
                  </StackPanel>

                  <WrapPanel ItemSpacing="{StaticResource Space.8}"
                             LineSpacing="{StaticResource Space.8}">
                    <ToggleButton Classes="source"
                                  IsChecked="{Binding Microphone, Mode=TwoWay}"
                                  IsEnabled="{Binding MicrophoneAvailable}">
                      <StackPanel Orientation="Horizontal"
                                  Spacing="{StaticResource Space.8}">
                        <controls:IconControl Width="{StaticResource Size.ToggleIcon}"
                                              Height="{StaticResource Size.ToggleIcon}"
                                              Data="{StaticResource Icon.Mic}" />
                        <TextBlock Classes="t13 plain"
                                   Foreground="{Binding $parent[ContentPresenter].Foreground}"
                                   Text="{x:Static res:Strings.Common_Microphone}" />
                      </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="source"
                                  IsChecked="{Binding SystemAudio, Mode=TwoWay}"
                                  IsEnabled="{Binding SystemAudioAvailable}">
                      <StackPanel Orientation="Horizontal"
                                  Spacing="{StaticResource Space.8}">
                        <controls:IconControl Width="{StaticResource Size.ToggleIcon}"
                                              Height="{StaticResource Size.ToggleIcon}"
                                              Data="{StaticResource Icon.Speaker}" />
                        <TextBlock Classes="t13 plain"
                                   Foreground="{Binding $parent[ContentPresenter].Foreground}"
                                   Text="{x:Static res:Strings.Recording_SystemAudio}" />
                      </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="source"
                                  IsChecked="{Binding Screen, Mode=TwoWay}"
                                  IsEnabled="{Binding ScreenAvailable}">
                      <Panel>
                        <!-- Off: the canvas draws a dashed outline (a border cannot dash); it covers the whole button, padding included. -->
                        <Rectangle Classes="dashedOutline"
                                   IsVisible="{Binding !$parent[ToggleButton].IsChecked}" />
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="{StaticResource Space.8}">
                          <controls:IconControl Width="{StaticResource Size.ToggleIcon}"
                                                Height="{StaticResource Size.ToggleIcon}"
                                                Data="{StaticResource Icon.Screen}" />
                          <TextBlock Classes="t13 plain"
                                     Foreground="{Binding $parent[ContentPresenter].Foreground}"
                                     Text="{x:Static res:Strings.Common_Screen}" />
                        </StackPanel>
                      </Panel>
                    </ToggleButton>
                  </WrapPanel>

                  <StackPanel Orientation="Horizontal"
                              Spacing="{StaticResource Space.12}">
                    <Button Classes="start"
                            Command="{Binding StartRecordingCommand}"
                            Content="{x:Static res:Strings.Recording_Start}" />
                    <TextBlock Classes="monoMeta muted"
                               VerticalAlignment="Center"
                               IsVisible="{Binding HasRecordHotkey}"
                               Text="{Binding RecordHotkeyText}" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Ask your library -->
            <Border Classes="heroCard"
                    IsVisible="{Binding CanAskAll}">
              <Grid RowDefinitions="Auto,*,Auto,*,Auto">
                <StackPanel Grid.Row="0"
                            Spacing="{StaticResource Space.6}">
                  <TextBlock Classes="cardTitle"
                             Text="{x:Static res:Strings.Library_AskAll}" />
                  <TextBlock Classes="paragraph"
                             Text="{x:Static res:Strings.Library_AskCardText}" />
                </StackPanel>

                <Border Grid.Row="2"
                        Classes="askBox"
                        Margin="{StaticResource Margin.AskBox}">
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="{StaticResource Space.8}">
                    <TextBox Grid.Column="0"
                             Classes="bare ask"
                             AutomationProperties.Name="{x:Static res:Strings.Library_AskLabel}"
                             PlaceholderText="{x:Static res:Strings.Library_AskPlaceholder}"
                             Text="{Binding AskQuestion, Mode=TwoWay}">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter"
                                    Command="{Binding AskCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1"
                            Classes="start send"
                            AutomationProperties.Name="{x:Static res:Strings.Library_AskSend}"
                            Command="{Binding AskCommand}">
                      <controls:IconControl Width="{StaticResource Size.NavIcon}"
                                            Height="{StaticResource Size.NavIcon}"
                                            Data="{StaticResource Icon.ArrowUp}" />
                    </Button>
                  </Grid>
                </Border>

                <ItemsControl Grid.Row="4"
                              ItemsSource="{Binding Suggestions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel ItemSpacing="{StaticResource Space.8}"
                                 LineSpacing="{StaticResource Space.8}" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Button Classes="suggestion"
                              Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).AskSuggestionCommand}"
                              CommandParameter="{Binding}">
                        <TextBlock Classes="t13"
                                   Foreground="{Binding $parent[ContentPresenter].Foreground}"
                                   Text="{Binding}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>
          </controls:AutoFitPanel>
        </StackPanel>
      </DataTemplate>

      <!-- Recordings + the search box -->
      <DataTemplate DataType="vm:LibraryHeaderEntry">
        <Grid DataContext="{Binding Library}"
              x:DataType="vm:LibraryViewModel"
              Margin="{StaticResource Margin.RecordingsTop}"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="{StaticResource Space.16}">
          <TextBlock Grid.Column="0"
                     Classes="cardTitle"
                     VerticalAlignment="Center"
                     Text="{x:Static res:Strings.Library_RecordingsTitle}" />
          <Border Grid.Column="1"
                  Classes="searchBox"
                  Width="{StaticResource Size.SearchBoxWidth}">
            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="{StaticResource Space.10}">
              <controls:IconControl Grid.Column="0"
                                    Width="{StaticResource Size.SearchIcon}"
                                    Height="{StaticResource Size.SearchIcon}"
                                    TextElement.Foreground="{DynamicResource Brush.Smoke}"
                                    Data="{StaticResource Icon.Search}" />
              <TextBox Grid.Column="1"
                       Classes="bare"
                       AutomationProperties.Name="{x:Static res:Strings.Library_SearchLabel}"
                       PlaceholderText="{x:Static res:Strings.Library_SearchPlaceholder}"
                       Text="{Binding SearchText, Mode=TwoWay}" />
            </Grid>
          </Border>
        </Grid>
      </DataTemplate>

      <!-- Date filters -->
      <DataTemplate DataType="vm:LibraryFiltersEntry">
        <WrapPanel DataContext="{Binding Library}"
                   x:DataType="vm:LibraryViewModel"
                   Margin="{StaticResource Margin.FiltersTop}"
                   ItemSpacing="{StaticResource Space.6}"
                   LineSpacing="{StaticResource Space.6}"
                   AutomationProperties.Name="{x:Static res:Strings.Library_FilterLabel}">
          <Button Classes="filter"
                  Classes.on="{Binding IsAllFilter}"
                  Command="{Binding SetFilterCommand}"
                  CommandParameter="{x:Static vm:LibraryFilter.All}">
            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource Space.8}">
              <Ellipse Classes="chipDot"
                       IsVisible="{Binding IsAllFilter}" />
              <TextBlock Classes="t13 plain"
                         Foreground="{Binding $parent[ContentPresenter].Foreground}"
                         Text="{x:Static res:Strings.Library_FilterAll}" />
            </StackPanel>
          </Button>
          <Button Classes="filter"
                  Classes.on="{Binding IsTodayFilter}"
                  Command="{Binding SetFilterCommand}"
                  CommandParameter="{x:Static vm:LibraryFilter.Today}">
            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource Space.8}">
              <Ellipse Classes="chipDot"
                       IsVisible="{Binding IsTodayFilter}" />
              <TextBlock Classes="t13 plain"
                         Foreground="{Binding $parent[ContentPresenter].Foreground}"
                         Text="{x:Static res:Strings.Library_FilterToday}" />
            </StackPanel>
          </Button>
          <Button Classes="filter"
                  Classes.on="{Binding IsWeekFilter}"
                  Command="{Binding SetFilterCommand}"
                  CommandParameter="{x:Static vm:LibraryFilter.Week}">
            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource Space.8}">
              <Ellipse Classes="chipDot"
                       IsVisible="{Binding IsWeekFilter}" />
              <TextBlock Classes="t13 plain"
                         Foreground="{Binding $parent[ContentPresenter].Foreground}"
                         Text="{x:Static res:Strings.Library_FilterWeek}" />
            </StackPanel>
          </Button>
          <Button Classes="filter"
                  Classes.on="{Binding IsMonthFilter}"
                  Command="{Binding SetFilterCommand}"
                  CommandParameter="{x:Static vm:LibraryFilter.Month}">
            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource Space.8}">
              <Ellipse Classes="chipDot"
                       IsVisible="{Binding IsMonthFilter}" />
              <TextBlock Classes="t13 plain"
                         Foreground="{Binding $parent[ContentPresenter].Foreground}"
                         Text="{x:Static res:Strings.Library_FilterMonth}" />
            </StackPanel>
          </Button>
          <Button x:Name="PickDates"
                  Classes="filter"
                  Classes.on="{Binding IsRangeFilter}">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft"
                      FlyoutPresenterClasses="rangeFlyout">
                <StackPanel Spacing="{StaticResource Space.12}">
                  <controls:DateRangeCalendar RangeCommand="{Binding PickRangeCommand}"
                                              RangeStart="{Binding RangeStart}"
                                              RangeEnd="{Binding RangeEnd}" />
                  <Button Classes="outline compact"
                          HorizontalAlignment="Right"
                          Command="{Binding ClearRangeCommand}"
                          Content="{x:Static res:Strings.Library_RangeClear}" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource Space.6}">
              <Ellipse Classes="chipDot"
                       IsVisible="{Binding IsRangeFilter}" />
              <controls:IconControl Width="{StaticResource Size.FilterIcon}"
                                    Height="{StaticResource Size.FilterIcon}"
                                    Data="{StaticResource Icon.Calendar}" />
              <TextBlock Classes="t13 plain"
                         Foreground="{Binding $parent[ContentPresenter].Foreground}"
                         Text="{Binding RangeText}" />
            </StackPanel>
          </Button>
        </WrapPanel>
      </DataTemplate>

      <!-- A day heading -->
      <DataTemplate DataType="vm:LibraryGroupEntry">
        <TextBlock Classes="t13 muted"
                   Margin="{StaticResource Margin.GroupTop}"
                   Text="{Binding Title}" />
      </DataTemplate>

      <!-- An inline error or "Searching…" -->
      <DataTemplate DataType="vm:LibraryNoticeEntry">
        <TextBlock Classes="t14 muted"
                   Margin="{StaticResource Margin.FiltersTop}"
                   TextWrapping="Wrap"
                   Text="{Binding Text}" />
      </DataTemplate>

      <!-- Nothing recorded yet, or nothing matches -->
      <DataTemplate DataType="vm:LibraryEmptyEntry">
        <Border Classes="heroCard"
                Margin="{StaticResource Margin.GroupTop}">
          <StackPanel Spacing="{StaticResource Space.24}"
                      HorizontalAlignment="Center"
                      MaxWidth="{StaticResource Size.SettingsWrap}">
            <TextBlock Classes="headingSm"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Text="{Binding Title}" />
            <TextBlock Classes="body"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Graphite}"
                       Text="{Binding Text}" />
            <Button Classes="primary"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding CanRecord}"
                    Content="{x:Static res:Strings.Library_NewRecording}"
                    Command="{Binding Library.NewRecordingCommand}" />
          </StackPanel>
        </Border>
      </DataTemplate>

      <!-- A recording -->
      <DataTemplate DataType="vm:SessionItemViewModel">
        <Border Classes="rowCard"
                Classes.top="{Binding HasTopCorners}"
                Classes.bottom="{Binding HasBottomCorners}">
          <Button Classes="libraryRow"
                  Command="{Binding OpenCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                  ColumnSpacing="{StaticResource Space.16}">
              <Border Grid.Column="0"
                      Classes="rowTile">
                <Panel>
                  <controls:IconControl Width="{StaticResource Size.NavIcon}"
                                        Height="{StaticResource Size.NavIcon}"
                                        IsVisible="{Binding IsScreenIcon}"
                                        Data="{StaticResource Icon.Screen}" />
                  <controls:IconControl Width="{StaticResource Size.NavIcon}"
                                        Height="{StaticResource Size.NavIcon}"
                                        IsVisible="{Binding IsMicrophoneIcon}"
                                        Data="{StaticResource Icon.Mic}" />
                  <controls:IconControl Width="{StaticResource Size.NavIcon}"
                                        Height="{StaticResource Size.NavIcon}"
                                        IsVisible="{Binding IsSystemAudioIcon}"
                                        Data="{StaticResource Icon.Speaker}" />
                </Panel>
              </Border>

              <StackPanel Grid.Column="1"
                          VerticalAlignment="Center"
                          Spacing="{StaticResource Space.3}">
                <TextBlock Classes="t15 medium"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Title}" />
                <TextBlock Classes="t13 muted"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding MetaText}" />
                <TextBlock Classes="t13 muted"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding ShowSnippet}"
                           Text="{Binding Snippet}" />
                <StackPanel Orientation="Horizontal"
                            Spacing="{StaticResource Space.10}"
                            Margin="{StaticResource Margin.RowBar}"
                            IsVisible="{Binding ShowProgress}">
                  <ProgressBar Classes="rowBar"
                               Value="{Binding ProgressPercent}" />
                  <TextBlock Classes="t12 graphite"
                             VerticalAlignment="Center"
                             Text="{Binding ProgressText}" />
                </StackPanel>
              </StackPanel>

              <TextBlock Grid.Column="2"
                         Classes="monoMeta graphite"
                         VerticalAlignment="Center"
                         Text="{Binding ClockText}" />
              <controls:IconControl Grid.Column="3"
                                    Width="{StaticResource Size.RowChevron}"
                                    Height="{StaticResource Size.RowChevron}"
                                    TextElement.Foreground="{DynamicResource Brush.Ash}"
                                    Data="{StaticResource Icon.Chevron}" />
            </Grid>
          </Button>
        </Border>
      </DataTemplate>

      <!-- A transcript hit -->
      <DataTemplate DataType="vm:SearchResultViewModel">
        <Border Classes="rowCard"
                Classes.top="{Binding HasTopCorners}"
                Classes.bottom="{Binding HasBottomCorners}">
          <Button Classes="libraryRow"
                  Command="{Binding OpenCommand}">
            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="{StaticResource Space.16}">
              <StackPanel Grid.Column="0"
                          VerticalAlignment="Center"
                          Spacing="{StaticResource Space.3}">
                <TextBlock Classes="t15 medium"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Title}" />
                <TextBlock Classes="t13 muted"
                           TextWrapping="Wrap"
                           MaxLines="2"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Snippet}" />
              </StackPanel>
              <TextBlock Grid.Column="1"
                         Classes="monoMeta graphite"
                         VerticalAlignment="Center"
                         IsVisible="{Binding HasTime}"
                         Text="{Binding TimeText}" />
              <controls:IconControl Grid.Column="2"
                                    Width="{StaticResource Size.RowChevron}"
                                    Height="{StaticResource Size.RowChevron}"
                                    TextElement.Foreground="{DynamicResource Brush.Ash}"
                                    Data="{StaticResource Icon.Chevron}" />
            </Grid>
          </Button>
        </Border>
      </DataTemplate>
    </ItemsControl.DataTemplates>
  </ItemsControl>
</UserControl>
