<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hard rule: Murmur.App references Murmur.Core only. Enforced by ArchitectureTests. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Murmur.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Resources/Strings.resx is Ukrainian, the neutral language of the resources (see the EmbeddedResource items below). -->
    <NeutralLanguage>uk</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <!-- The window icon: the same orb as the installer and the exe (generated by installer/make-icon.py). -->
    <AvaloniaResource Include="..\..\installer\murmur.ico" Link="Assets\murmur.ico" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Both languages are embedded in Murmur.App.dll itself (Murmur.App.Resources.Strings.resources = Ukrainian,
      Murmur.App.Resources.Strings.en.resources = English); WithCulture="false" stops the SDK from turning Strings.en.resx
      into a satellite assembly. Native AOT cannot load satellite assemblies: the English texts would never be found.
      Strings.cs picks the resource set by the UI culture.
    -->
    <EmbeddedResource Update="Resources\Strings.resx" />
    <EmbeddedResource Update="Resources\Strings.en.resx" WithCulture="false" />
  </ItemGroup>

  <!--
    Strongly typed accessor: one `public static string <Key> => Get("<Key>")` per entry of Strings.resx, written at build
    time into obj/ (Strings.keys.g.cs, a partial of Resources/Strings.cs). No reflection and no runtime lookup by name
    from XAML: {x:Static res:Strings.Key} is compiled into a property read. A key that is in only one language fails
    LocalizationTests.
  -->
  <Target Name="MurmurGenerateStringsAccessor" Inputs="Resources\Strings.resx;$(MSBuildProjectFullPath)" Outputs="$(IntermediateOutputPath)Strings.keys.g.cs">
    <XmlPeek XmlInputPath="Resources\Strings.resx" Query="/root/data/@name">
      <Output TaskParameter="Result" ItemName="MurmurStringKey" />
    </XmlPeek>
    <ItemGroup>
      <MurmurStringLine Include="@(MurmurStringKey->'    public static string %(Identity) =&gt; Get(&quot;%(Identity)&quot;)%3B')" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)Strings.keys.g.cs" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// &lt;auto-generated/&gt; from Resources/Strings.resx by Murmur.App.csproj - do not edit;namespace Murmur.App.Resources%3B;public static partial class Strings;{;@(MurmurStringLine);}" />
    <!-- WriteOnlyWhenDifferent leaves the file alone when only a text (not a key) changed; touch it so the target stays up to date. -->
    <Touch Files="$(IntermediateOutputPath)Strings.keys.g.cs" />
  </Target>

  <Target Name="MurmurIncludeStringsAccessor" BeforeTargets="CoreCompile" DependsOnTargets="MurmurGenerateStringsAccessor">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)Strings.keys.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)Strings.keys.g.cs" />
    </ItemGroup>
  </Target>

  <!--
    Build-time version constant for "Про програму": `BuildInfo.Version` is written from $(Version) (Directory.Build.props) into
    obj/ (BuildInfo.g.cs), like the Strings accessor above. Reading the assembly attributes at run time would need reflection.
  -->
  <Target Name="MurmurGenerateBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <MurmurDisplayVersion>$([System.String]::Copy('$(Version)').Split('+')[0])</MurmurDisplayVersion>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.g.cs" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// &lt;auto-generated/&gt; from $(Version) by Murmur.App.csproj - do not edit;namespace Murmur.App%3B;/// &lt;summary&gt;Facts fixed at build time (no reflection).&lt;/summary&gt;;public static class BuildInfo;{;    /// &lt;summary&gt;The product version without any source revision suffix.&lt;/summary&gt;;    public const string Version = &quot;$(MurmurDisplayVersion)&quot;%3B;}" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Murmur.Core\Murmur.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Murmur.App.Tests" />
  </ItemGroup>

</Project>
