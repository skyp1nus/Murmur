<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hard rule: Murmur.App references Murmur.Core only. Enforced by ArchitectureTests. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Murmur.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Murmur.Core\Murmur.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Murmur.App.Tests" />
  </ItemGroup>

</Project>
