<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Murmur.App.Controls">

  <!--
    Styles of the floating recorder orb (#46), drawn in docs/design/features/Idea1Autopilot.dc.html ("Idea 1 / Floating recorder"):
    a 44 px circle with the orb inside, the pill with the four buttons to its left and the chip "Marked 12:41" under it. Colours,
    fonts, radii and the shadow are tokens; what is named here are the sizes of this window's own components. Every class starts with
    "orb" because the style files share one scope.
  -->

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Styles/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <ResourceDictionary.ThemeDictionaries>
        <!-- The circle and the pill are Canvas on the light desktop and Surface on the dark one; a hovered button is one step further. -->
        <ResourceDictionary x:Key="Light">
          <StaticResource x:Key="FloatingOrb.Fill" ResourceKey="Brush.Canvas" />
          <StaticResource x:Key="FloatingOrb.ChipFill" ResourceKey="Brush.Surface" />
          <StaticResource x:Key="FloatingOrb.ToolHover" ResourceKey="Brush.Surface" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <StaticResource x:Key="FloatingOrb.Fill" ResourceKey="Brush.Surface" />
          <StaticResource x:Key="FloatingOrb.ChipFill" ResourceKey="Brush.Stone" />
          <StaticResource x:Key="FloatingOrb.ToolHover" ResourceKey="Brush.Stone" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Sizes of the mockup: the circle 44 with a 28 orb, the pill 40 high with 32 buttons 2 apart, the chip 28 high. -->
      <x:Double x:Key="FloatingOrb.Circle">44</x:Double>
      <x:Double x:Key="FloatingOrb.Orb">28</x:Double>
      <x:Double x:Key="FloatingOrb.PillHeight">40</x:Double>
      <Thickness x:Key="FloatingOrb.PillPadding">4,0</Thickness>
      <x:Double x:Key="FloatingOrb.MarkIcon">14</x:Double>
      <x:Double x:Key="FloatingOrb.PauseIcon">12</x:Double>
      <x:Double x:Key="FloatingOrb.StopIcon">10</x:Double>
      <x:Double x:Key="FloatingOrb.OpenIcon">14</x:Double>
      <x:Double x:Key="FloatingOrb.ChipIcon">10</x:Double>
      <x:Double x:Key="FloatingOrb.PausedOrbOpacity">0.85</x:Double>
      <!-- Each shape takes clicks over this margin around it, which holds most of the soft shadow of Shadow.Subtle (Space.4: the less
           margin, the less transparent area that swallows clicks over other programs); the rest of the window lets clicks through. -->
      <StaticResource x:Key="FloatingOrb.ShadowMargin" ResourceKey="Inset.4" />
      <!-- Pill and orb are 6 apart; the chip hangs 8 under the circle. -->
      <Thickness x:Key="FloatingOrb.PillMargin">0,0,6,0</Thickness>
      <Thickness x:Key="FloatingOrb.ChipMargin">0,8,0,0</Thickness>

      <!-- Glyphs on the 24 x 24 grid of the mockup's SVGs; the mark flag is Icon.Mark. -->
      <StreamGeometry x:Key="FloatingOrb.Pause">M7 5h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z M15 5h2a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z</StreamGeometry>
      <StreamGeometry x:Key="FloatingOrb.Resume">M8 5v14l11-7z</StreamGeometry>
      <StreamGeometry x:Key="FloatingOrb.Stop">M7 5h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z</StreamGeometry>
      <StreamGeometry x:Key="FloatingOrb.OpenGlyph">M14 4h6v6M20 4l-8 8M10 20H4v-6</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- The white circle with the orb in it. -->
  <Style Selector="Border.orbCircle">
    <Setter Property="Width" Value="{StaticResource FloatingOrb.Circle}" />
    <Setter Property="Height" Value="{StaticResource FloatingOrb.Circle}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Background" Value="{DynamicResource FloatingOrb.Fill}" />
    <Setter Property="BoxShadow" Value="{StaticResource Shadow.Subtle}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- The pill of buttons. -->
  <Style Selector="Border.orbPill">
    <Setter Property="Height" Value="{StaticResource FloatingOrb.PillHeight}" />
    <Setter Property="Padding" Value="{StaticResource FloatingOrb.PillPadding}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Background" Value="{DynamicResource FloatingOrb.Fill}" />
    <Setter Property="BoxShadow" Value="{StaticResource Shadow.Subtle}" />
  </Style>

  <!-- A 32 px round button of the pill: no border, the fill appears under the pointer. Stop is the black one. -->
  <Style Selector="Button.orbTool">
    <Setter Property="Width" Value="{StaticResource Size.Button}" />
    <Setter Property="Height" Value="{StaticResource Size.Button}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="Button.orbTool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FloatingOrb.ToolHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="Button.orbTool:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.FillPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="Button.orbTool:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ash}" />
  </Style>
  <Style Selector="Button.orbTool.quiet">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
  </Style>
  <Style Selector="Button.orbTool.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
  </Style>
  <Style Selector="Button.orbTool.stop">
    <Setter Property="Background" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Canvas}" />
  </Style>
  <Style Selector="Button.orbTool.stop:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.InkHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Canvas}" />
  </Style>
  <Style Selector="Button.orbTool.stop:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Smoke}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Canvas}" />
  </Style>
  <Style Selector="Button.orbTool.stop:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Ash}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Canvas}" />
  </Style>

  <!-- The paused orb is grey: a wash of Ash over the gradient (the mockup greys it with a filter, which Avalonia has no brush for). -->
  <Style Selector="Ellipse.orbPausedWash">
    <Setter Property="Fill" Value="{DynamicResource Brush.Ash}" />
    <Setter Property="Opacity" Value="{StaticResource FloatingOrb.PausedOrbOpacity}" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- The chip "Marked 12:41": a Surface pill, 28 high; its time is Geist Mono. -->
  <Style Selector="Border.orbChip">
    <Setter Property="Height" Value="{StaticResource Size.Chip}" />
    <Setter Property="Padding" Value="{StaticResource Inset.Suggestion}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Background" Value="{DynamicResource FloatingOrb.ChipFill}" />
    <Setter Property="BoxShadow" Value="{StaticResource Shadow.Subtle}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="TextBlock.orbChipText">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Body}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="TextBlock.orbChipText.orbMono">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.MonoRow}" />
  </Style>
</Styles>
