<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Murmur.App.Controls">

  <!--
    The export dialog (Idea6Export.dc.html, "Idea 6 / Export sheet"): a 840 x 540 card with a 52 px header, a 300 px options column, the
    preview and a 56 px footer, on a scrim. Like the other style files this one holds no literal colours, fonts, radii or spacing: they are
    all token resources. The sizes below are the mockup's, named after the part they size.
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Styles/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <x:Double x:Key="Size.ExportSheetWidth">840</x:Double>
      <x:Double x:Key="Size.ExportSheetHeight">540</x:Double>
      <GridLength x:Key="Grid.ExportHeader">52</GridLength>
      <GridLength x:Key="Grid.ExportFooter">56</GridLength>
      <GridLength x:Key="Grid.ExportOptions">300</GridLength>
      <x:Double x:Key="Size.ExportClose">30</x:Double>
      <x:Double x:Key="Size.ExportCloseIcon">14</x:Double>
      <x:Double x:Key="Size.ExportFormat">48</x:Double>
      <x:Double x:Key="Size.ExportRow">32</x:Double>
      <x:Double x:Key="Size.ExportBox">16</x:Double>
      <x:Double x:Key="Size.ExportCheck">10</x:Double>
      <x:Double x:Key="Size.ExportDot">7</x:Double>
      <x:Double x:Key="Size.ExportCopyIcon">14</x:Double>
      <x:Double x:Key="Opacity.ExportLocked">0.45</x:Double>
      <!-- The stroke of the icons in the 24 x 24 grid: the close cross 1.8, the check mark 3.2. -->
      <x:Double x:Key="Stroke.ExportClose">1.8</x:Double>
      <x:Double x:Key="Stroke.ExportCheck">3.2</x:Double>

      <!-- Header: 20 px left, 14 px right. Panes: 20 px at the sides, 16 above and below. -->
      <Thickness x:Key="Margin.ExportHeader">20,0,14,0</Thickness>
      <Thickness x:Key="Margin.ExportPane">20,16</Thickness>
      <Thickness x:Key="Margin.ExportFormat">12,0</Thickness>
      <!-- An option row is 6 px wider than its text on each side, and pulled back out by the same 6 px so the box lines up with the heading. -->
      <Thickness x:Key="Margin.ExportRowPad">6,0</Thickness>
      <Thickness x:Key="Margin.ExportRow">-6,0</Thickness>
      <Thickness x:Key="Margin.ExportRowLabel">10,0,0,0</Thickness>
      <Thickness x:Key="Margin.ExportIncludeTitle">0,0,0,4</Thickness>
      <Thickness x:Key="Margin.ExportNote">0,4,0,0</Thickness>
      <Thickness x:Key="Margin.ExportPreview">16,14</Thickness>
      <Thickness x:Key="Margin.ExportSave">16,0</Thickness>
      <Thickness x:Key="Margin.ExportSubtitle">0,4,0,0</Thickness>
      <Thickness x:Key="Border.ExportEdgeBottom">0,0,0,1</Thickness>
      <Thickness x:Key="Border.ExportEdgeTop">0,1,0,0</Thickness>
      <Thickness x:Key="Border.ExportEdgeRight">0,0,1,0</Thickness>

      <!-- Paths of the icons that are only used here (the 24 x 24 grid of the canvas SVG). -->
      <StreamGeometry x:Key="Icon.Close">M6 6l12 12M18 6L6 18</StreamGeometry>
      <StreamGeometry x:Key="Icon.Copy">M10 8h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2z M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Text of the dialog. 13 px runs have no tracking in the mockup's buttons; the labels are 12 px / 500. -->
  <Style Selector="TextBlock.exportTitle">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Display}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.CardTitle}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.CardTitle}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.CardTitle}" />
  </Style>
  <Style Selector="TextBlock.exportSmall">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Body}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.SmallTight}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.SmallTight}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.SmallTight}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
  </Style>
  <Style Selector="TextBlock.exportStatus">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Body}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.SmallTight}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.SmallTight}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.SmallTight}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Graphite}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.exportLabel">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.SmallTight}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.SmallTight}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.SmallTight}" />
  </Style>
  <Style Selector="TextBlock.exportItem">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Body}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.MetaTight}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.MetaTight}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.MetaTight}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.exportItemStrong">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.MetaTight}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.MetaTight}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.MetaTight}" />
  </Style>
  <Style Selector="TextBlock.exportMono">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.MonoSmall}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.MonoSmall}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.MonoSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- The preview: Inter 13 for Markdown and Word, Geist Mono 12 for the plain formats. -->
  <Style Selector="SelectableTextBlock.exportPreview">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Body}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Message}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.Message}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.Message}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="SelectableTextBlock.exportPreview.mono">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Mono}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.Mono}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.MonoRow}" />
  </Style>

  <!-- The close cross: a 30 px round button that fills with Surface on hover. -->
  <Style Selector="Button.exportClose">
    <Setter Property="Width" Value="{StaticResource Size.ExportClose}" />
    <Setter Property="Height" Value="{StaticResource Size.ExportClose}" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="Button.exportClose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.FillHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="Button.exportClose:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.FillPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>

  <!-- Save keeps the primary pill but with the mockup's 16 px of padding. -->
  <Style Selector="Button.primary.exportSave">
    <Setter Property="Padding" Value="{StaticResource Margin.ExportSave}" />
  </Style>

  <!-- A format: a 48 px tile with the name and the extension; the chosen one has the 1.5 px Ink outline. -->
  <Style Selector="RadioButton.exportFormat">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Height" Value="{StaticResource Size.ExportFormat}" />
    <Setter Property="Padding" Value="{StaticResource Margin.ExportFormat}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root"
                CornerRadius="{StaticResource Radius.Panel}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.exportFormat /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline.Thickness}" />
  </Style>
  <Style Selector="RadioButton.exportFormat:pointerover /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource Brush.FillHover}" />
  </Style>
  <Style Selector="RadioButton.exportFormat:checked /template/ Border#PART_Root">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="BorderThickness" Value="{StaticResource Emphasis.Thickness}" />
  </Style>
  <Style Selector="RadioButton.exportFormat:focus-visible /template/ Border#PART_Root">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ink}" />
  </Style>

  <!-- A checkbox row: a 16 px box (Ink and a white tick when checked) and the label; a locked row is faded. -->
  <Style Selector="CheckBox.exportOption">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Height" Value="{StaticResource Size.ExportRow}" />
    <Setter Property="Margin" Value="{StaticResource Margin.ExportRow}" />
    <Setter Property="Padding" Value="{StaticResource Margin.ExportRowPad}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root"
                CornerRadius="{StaticResource Radius.Small}"
                Padding="{TemplateBinding Padding}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.10}">
            <Border Name="PART_Box"
                    Width="{StaticResource Size.ExportBox}"
                    Height="{StaticResource Size.ExportBox}"
                    VerticalAlignment="Center"
                    CornerRadius="{StaticResource Radius.Input}"
                    BorderThickness="{StaticResource Emphasis.Thickness}">
              <controls:IconControl Name="PART_Check"
                                    Width="{StaticResource Size.ExportCheck}"
                                    Height="{StaticResource Size.ExportCheck}"
                                    HorizontalAlignment="Center"
                                    Stroke="{StaticResource Stroke.ExportCheck}"
                                    TextElement.Foreground="{DynamicResource Brush.Canvas}"
                                    Data="{StaticResource Icon.Check}" />
            </Border>
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="CheckBox.exportOption /template/ Border#PART_Root">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="CheckBox.exportOption /template/ Border#PART_Box">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.DashedBorder}" />
  </Style>
  <Style Selector="CheckBox.exportOption /template/ controls|IconControl#PART_Check">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="CheckBox.exportOption:pointerover /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource Brush.FillHover}" />
  </Style>
  <Style Selector="CheckBox.exportOption:checked /template/ Border#PART_Box">
    <Setter Property="Background" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="CheckBox.exportOption:checked /template/ controls|IconControl#PART_Check">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="CheckBox.exportOption:disabled">
    <Setter Property="Opacity" Value="{StaticResource Opacity.ExportLocked}" />
  </Style>
  <Style Selector="CheckBox.exportOption:disabled /template/ Border#PART_Root">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="CheckBox.exportOption:focus-visible /template/ Border#PART_Box">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ink}" />
  </Style>

  <!-- A range row: a round 16 px ring (a dot inside when chosen), the label and the span in Geist Mono at the right. -->
  <Style Selector="RadioButton.exportRange">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Height" Value="{StaticResource Size.ExportRow}" />
    <Setter Property="Margin" Value="{StaticResource Margin.ExportRow}" />
    <Setter Property="Padding" Value="{StaticResource Margin.ExportRowPad}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root"
                CornerRadius="{StaticResource Radius.Small}"
                Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="Auto,*">
            <Border Name="PART_Ring"
                    Grid.Column="0"
                    Width="{StaticResource Size.ExportBox}"
                    Height="{StaticResource Size.ExportBox}"
                    VerticalAlignment="Center"
                    CornerRadius="{StaticResource Radius.Pill}"
                    BorderThickness="{StaticResource Emphasis.Thickness}">
              <Ellipse Name="PART_Dot"
                       Width="{StaticResource Size.ExportDot}"
                       Height="{StaticResource Size.ExportDot}"
                       Fill="{DynamicResource Brush.Ink}" />
            </Border>
            <ContentPresenter Name="PART_ContentPresenter"
                              Grid.Column="1"
                              Margin="{StaticResource Margin.ExportRowLabel}"
                              Content="{TemplateBinding Content}"
                              VerticalAlignment="Center" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.exportRange /template/ Border#PART_Root">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="RadioButton.exportRange /template/ Border#PART_Ring">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.DashedBorder}" />
  </Style>
  <Style Selector="RadioButton.exportRange /template/ Ellipse#PART_Dot">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="RadioButton.exportRange:pointerover /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource Brush.FillHover}" />
  </Style>
  <Style Selector="RadioButton.exportRange:checked /template/ Border#PART_Ring">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="RadioButton.exportRange:checked /template/ Ellipse#PART_Dot">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="RadioButton.exportRange:focus-visible /template/ Border#PART_Ring">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ink}" />
  </Style>
</Styles>
