<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Murmur.App.Controls">

  <!--
    Styles of the Ask AI screen as drawn on the canvas (Chat.dc.html / ChatDark.dc.html): the scope pills and the model chip of the top
    bar, the conversation column, the user bubble, the answer with its inline time chips, the Sources cards, the icon buttons and the
    composer. Like the other style files this one holds no literal colours, fonts or spacing of its own: colours are token brushes
    (DynamicResource), type steps and radii come from tokens.json, and the few sizes the canvas uses that the scale lacks are named
    Chat.* component resources. Every class starts with "chat" because the style files share one scope.
  -->

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Styles/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <ResourceDictionary.ThemeDictionaries>
        <!-- The time chips are Surface on the light page and Stone on the dark one; their hover is one step further. -->
        <ResourceDictionary x:Key="Light">
          <StaticResource x:Key="Chat.ChipFill" ResourceKey="Brush.Surface" />
          <StaticResource x:Key="Chat.ChipFillHover" ResourceKey="Brush.Stone" />
          <!-- The composer has the subtle shadow on the light page and a hairline on the dark one, where it is also Surface. -->
          <StaticResource x:Key="Chat.ComposerFill" ResourceKey="Brush.Canvas" />
          <StaticResource x:Key="Chat.ComposerShadow" ResourceKey="Shadow.Subtle" />
          <Thickness x:Key="Chat.ComposerBorder">0</Thickness>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <StaticResource x:Key="Chat.ChipFill" ResourceKey="Brush.Stone" />
          <StaticResource x:Key="Chat.ChipFillHover" ResourceKey="Brush.ButtonBorder" />
          <StaticResource x:Key="Chat.ComposerFill" ResourceKey="Brush.Surface" />
          <BoxShadows x:Key="Chat.ComposerShadow">0 0 0 0 Transparent</BoxShadows>
          <Thickness x:Key="Chat.ComposerBorder">1</Thickness>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Sizes of the canvas that the spacing scale does not hold. -->
      <x:Double x:Key="Chat.ColumnWidth">820</x:Double>
      <x:Double x:Key="Chat.ScopeHeight">34</x:Double>
      <x:Double x:Key="Chat.ModelChipHeight">30</x:Double>
      <x:Double x:Key="Chat.AvatarSize">24</x:Double>
      <x:Double x:Key="Chat.ActionSize">32</x:Double>
      <x:Double x:Key="Chat.ActionIcon">16</x:Double>
      <x:Double x:Key="Chat.PlayIcon">9</x:Double>
      <x:Double x:Key="Chat.SendIcon">18</x:Double>
      <x:Double x:Key="Chat.StopGlyph">12</x:Double>
      <x:Double x:Key="Chat.SourceMinWidth">220</x:Double>
      <x:Double x:Key="Chat.InputMinHeight">58</x:Double>
      <x:Double x:Key="Chat.InputMaxHeight">168</x:Double>
      <x:Double x:Key="Chat.NoticeWidth">480</x:Double>
      <Thickness x:Key="Chat.ColumnInset">0,24,0,0</Thickness>
      <Thickness x:Key="Chat.ItemSides">32,0</Thickness>
      <Thickness x:Key="Chat.ItemInset">0,0,0,32</Thickness>
      <Thickness x:Key="Chat.ComposerArea">32,0,32,32</Thickness>
      <Thickness x:Key="Chat.BubbleInset">18,12</Thickness>
      <Thickness x:Key="Chat.ChipInset">8,0,8,2</Thickness>
      <!--
        An embedded control rests on the baseline and a taller one pushes the text of its line down. The canvas draws the 22 px chip from 17 px
        above the baseline to 5 px below it (vertical-align: 1px): it is laid out 18 px high (2 px down, 6 px short at the bottom) and drawn in full.
      -->
      <Thickness x:Key="Chat.ChipMargin">-1.5,2,0,-6</Thickness>
      <!-- Avalonia sets a 26.4 px line of Inter 16 about 2 px lower than the canvas does; the chips above are laid out against the shifted text. -->
      <Thickness x:Key="Chat.AnswerShift">0,-2,0,2</Thickness>
      <Thickness x:Key="Chat.ModelChipInset">12,0</Thickness>
      <Thickness x:Key="Chat.SourceInset">16,14</Thickness>
      <Thickness x:Key="Chat.ComposerInset">20,10,10,10</Thickness>
      <Thickness x:Key="Chat.InputInset">0,6</Thickness>
      <StreamGeometry x:Key="Chat.Icon.Play">M8 5v14l11-7z</StreamGeometry>
      <StreamGeometry x:Key="Chat.Icon.Copy">M10 8h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2z M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2</StreamGeometry>
      <StreamGeometry x:Key="Chat.Icon.Retry">M20 12a8 8 0 1 1-2.3-5.7M20 4v5h-5</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ==== Page ================================================================================================================== -->
  <!-- The message list is one virtualised column of the canvas's width, centred, with its 32 px at the sides. -->
  <Style Selector="ItemsControl.chatMessages">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="{StaticResource Chat.ColumnInset}" />
  </Style>
  <Style Selector="ItemsControl.chatMessages > ContentPresenter">
    <Setter Property="MaxWidth" Value="{StaticResource Chat.ColumnWidth}" />
    <Setter Property="Padding" Value="{StaticResource Chat.ItemSides}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.chatComposerArea">
    <Setter Property="MaxWidth" Value="{StaticResource Chat.ColumnWidth}" />
    <Setter Property="Padding" Value="{StaticResource Chat.ComposerArea}" />
  </Style>

  <!-- ==== Top bar: scope pills and the model chip ==================================================================================== -->
  <!-- A scope pill: a pill with a hairline, Canvas inside, 13 px medium; the dot marks the active scope. -->
  <Style Selector="Button.chatScope">
    <Setter Property="Height" Value="{StaticResource Chat.ScopeHeight}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="{StaticResource Inset.Toggle}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Meta}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.ButtonBorder}" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline.Thickness}" />
  </Style>
  <Style Selector="Button.chatScope:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.FillHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.ButtonBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="Button.chatScope:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.FillPressed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.ButtonBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>

  <Style Selector="Border.chatModel">
    <Setter Property="Height" Value="{StaticResource Chat.ModelChipHeight}" />
    <Setter Property="Padding" Value="{StaticResource Chat.ModelChipInset}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
  </Style>

  <!-- ==== Messages ============================================================================================================== -->
  <Style Selector="Border.chatBubble">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
    <Setter Property="Padding" Value="{StaticResource Chat.BubbleInset}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="TextBlock.chatBubbleText">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Bubble}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.Bubble}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.Bubble}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- The answer: 16 px / 1.65 ink text; its blocks are 16 px apart (12 px when there are no sources under it). -->
  <Style Selector="StackPanel.chatAnswer">
    <Setter Property="Spacing" Value="{StaticResource Space.12}" />
  </Style>
  <Style Selector="StackPanel.chatAnswer.sourced">
    <Setter Property="Spacing" Value="{StaticResource Space.16}" />
  </Style>
  <Style Selector="StackPanel.chatParagraphs">
    <Setter Property="Spacing" Value="{StaticResource Space.12}" />
  </Style>
  <Style Selector="StackPanel.chatAnswer.sourced StackPanel.chatParagraphs">
    <Setter Property="Spacing" Value="{StaticResource Space.16}" />
  </Style>
  <Style Selector="TextBlock.chatAnswerText">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Answer}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.Answer}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.Answer}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="{StaticResource Chat.AnswerShift}" />
  </Style>

  <!-- A time chip: a Geist Mono pill with the play glyph; it sits inside a line of the answer. -->
  <Style Selector="Button.chatChip">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="{StaticResource Chat.ChipInset}" />
    <Setter Property="Margin" Value="{StaticResource Chat.ChipMargin}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Background" Value="{DynamicResource Chat.ChipFill}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.chatChip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Chat.ChipFillHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="Button.chatChip:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Chat.ChipFillHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <!-- The chip of a deleted recording stays as text: it is no longer a link, and does not dim or react. -->
  <Style Selector="Button.chatChip:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Chat.ChipFill}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="TextBlock.chatChipText">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Chip}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.Chip}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.Chip}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Sources: a card per cited moment, a hairline around it, Surface under the pointer. -->
  <Style Selector="Button.chatSource">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="{StaticResource Chat.SourceInset}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Note}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline.Thickness}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="Button.chatSource:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="Button.chatSource:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.FillPressed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="Button.chatSource:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Hairline}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="TextBlock.chatSourceTime">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.MonoSmall}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.MonoSmall}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.MonoSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
  </Style>

  <!-- The round icon buttons under an answer (Copy answer, Regenerate). -->
  <Style Selector="Button.chatIcon">
    <Setter Property="Width" Value="{StaticResource Chat.ActionSize}" />
    <Setter Property="Height" Value="{StaticResource Chat.ActionSize}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.chatIcon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.FillHover}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
  </Style>
  <Style Selector="Button.chatIcon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.FillPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
  </Style>
  <Style Selector="Button.chatIcon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ash}" />
  </Style>

  <!-- ==== Composer ============================================================================================================== -->
  <Style Selector="Border.chatComposer">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.CardLarge}" />
    <Setter Property="Background" Value="{DynamicResource Chat.ComposerFill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.ButtonBorder}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Chat.ComposerBorder}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Chat.ComposerShadow}" />
    <Setter Property="Padding" Value="{StaticResource Chat.ComposerInset}" />
  </Style>
  <!-- The question: two lines to start with, growing with the text; a form control, so no tracking. -->
  <Style Selector="TextBox.bare.chatInput">
    <Setter Property="Padding" Value="{StaticResource Chat.InputInset}" />
    <Setter Property="MinHeight" Value="{StaticResource Chat.InputMinHeight}" />
    <Setter Property="MaxHeight" Value="{StaticResource Chat.InputMaxHeight}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.RowTitle}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.RowTitle}" />
    <Setter Property="LetterSpacing" Value="0" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <!-- Stop while an answer is generating: the outline circle in the place of the send button. -->
  <Style Selector="Button.chatStop">
    <Setter Property="Width" Value="{StaticResource Size.AskSend}" />
    <Setter Property="Height" Value="{StaticResource Size.AskSend}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.ButtonBorder}" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline.Thickness}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.chatStop:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.FillHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.ButtonBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="Button.chatStop:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.FillPressed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.ButtonBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>

  <!-- ==== Sidebar: renaming a chat in place ======================================================================================= -->
  <Style Selector="TextBox.chatRename">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="{StaticResource Size.NavSubItem}" />
    <Setter Property="Padding" Value="{StaticResource Inset.Toggle}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Meta}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.Meta}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
</Styles>
