<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Per-theme resources of the Settings screen (Settings.dc.html / SettingsDark.dc.html). The segmented control of the Acceleration card has
    an inset hairline in the light canvas (it takes no room) and a 1 px border in the dark one; the app draws the border of the dark canvas
    in both themes' hairline colour and takes no room in the light one. They live here, not in the view, so that every themed key resolves
    at application level.
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <Thickness x:Key="Settings.SegmentBorder">0</Thickness>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Thickness x:Key="Settings.SegmentBorder">1</Thickness>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
</Styles>
