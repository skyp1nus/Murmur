<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Murmur.App.Controls"
        xmlns:coll="using:Avalonia.Collections">

  <!--
    Styles of the first-run onboarding (Onb1..Onb5 mockups). Like Controls.axaml this file holds no literal colours, fonts,
    radii or spacing: everything is a token resource, and every colour lookup is a DynamicResource (the one static lookup of
    a colour sits inside a ThemeDictionaries element, which resolves per theme). Accent colours stay in the orb.
  -->

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Styles/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <ResourceDictionary.ThemeDictionaries>
        <!-- The off knob of the switch: Canvas on Stone in the light theme, Graphite on Stone in the dark one (Onb4 / Onb4Dark). -->
        <ResourceDictionary x:Key="Light">
          <StaticResource x:Key="Brush.SwitchKnobOff" ResourceKey="Brush.Canvas" />
          <!-- Fill of the pickers and the hotkey field: Canvas in the light mockups, Surface in the dark ones. -->
          <StaticResource x:Key="Brush.OnbField" ResourceKey="Brush.Canvas" />
          <StaticResource x:Key="Brush.OnbCap" ResourceKey="Brush.Surface" />
          <StaticResource x:Key="Shadow.OnbKnob" ResourceKey="Shadow.Subtle" />
          <!-- The open device list: its outline and the chosen row. -->
          <StaticResource x:Key="Brush.OnbListBorder" ResourceKey="Brush.Stone" />
          <StaticResource x:Key="Shadow.OnbList" ResourceKey="Shadow.Subtle" />
          <StaticResource x:Key="Brush.OnbItemSelected" ResourceKey="Brush.Surface" />
          <!-- The canvas orbs: standard deviation of the halo's blur, opacity of the voice halo, strength of the inner glow. -->
          <x:Double x:Key="Onb.Orb.WelcomeHaloBlur">30</x:Double>
          <x:Double x:Key="Onb.Orb.WelcomeGlow">0.35</x:Double>
          <x:Double x:Key="Onb.Orb.VoiceHaloBlur">20</x:Double>
          <x:Double x:Key="Onb.Orb.VoiceHaloOpacity">0.3</x:Double>
          <x:Double x:Key="Onb.Orb.VoiceGlow">0.35</x:Double>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <StaticResource x:Key="Brush.SwitchKnobOff" ResourceKey="Brush.Graphite" />
          <StaticResource x:Key="Brush.OnbField" ResourceKey="Brush.Surface" />
          <StaticResource x:Key="Brush.OnbCap" ResourceKey="Brush.Stone" />
          <BoxShadows x:Key="Shadow.OnbKnob">none</BoxShadows>
          <StaticResource x:Key="Brush.OnbListBorder" ResourceKey="Brush.ButtonBorder" />
          <!-- TODO(D-044): the dark mockup's list shadow is "0 8 24 rgba(0,0,0,0.5)"; it needs a shadow token (a literal colour is not allowed here). -->
          <StaticResource x:Key="Shadow.OnbList" ResourceKey="Shadow.Subtle" />
          <StaticResource x:Key="Brush.OnbItemSelected" ResourceKey="Brush.Stone" />
          <x:Double x:Key="Onb.Orb.WelcomeHaloBlur">34</x:Double>
          <x:Double x:Key="Onb.Orb.WelcomeGlow">0.25</x:Double>
          <x:Double x:Key="Onb.Orb.VoiceHaloBlur">22</x:Double>
          <x:Double x:Key="Onb.Orb.VoiceHaloOpacity">0.45</x:Double>
          <x:Double x:Key="Onb.Orb.VoiceGlow">0.25</x:Double>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Page frame: 48 at the sides, 32 above, 40 below (the mockups' padding), all from the spacing scale. -->
      <Thickness x:Key="Inset.Onboarding">48,32,48,40</Thickness>
      <Thickness x:Key="Inset.TextButton">16,0</Thickness>
      <Thickness x:Key="Inset.OnbPrimary">24,0</Thickness>
      <Thickness x:Key="Inset.OnbField">12,0</Thickness>
      <Thickness x:Key="Inset.OnbItem">10,0</Thickness>
      <Thickness x:Key="Inset.OnbRadio">0,2,0,0</Thickness>
      <Thickness x:Key="Inset.OnbRadioFlat">0</Thickness>
      <!-- The chosen card's content sits half a pixel further in than the others' (the mockup's 1.5 px border in layout). -->
      <Thickness x:Key="Inset.ChoiceOn">22.5,20.5,21.5,19.5</Thickness>
      <Thickness x:Key="Inset.OnbTranscript">20,18</Thickness>
      <Thickness x:Key="Inset.OnbChip">8,0</Thickness>
      <Thickness x:Key="Inset.OnbSmall">12,0</Thickness>
      <Thickness x:Key="Inset.OnbDashed">0.5</Thickness>
      <Thickness x:Key="Inset.OnbOption">14,0</Thickness>
      <Thickness x:Key="Inset.OnbModel">24,20</Thickness>
      <Thickness x:Key="Inset.OnbCardExtra">0,6,0,0</Thickness>
      <Thickness x:Key="Inset.OnbOptionRow">4,0</Thickness>
      <Thickness x:Key="Inset.OnbOptionPull">-14,0,0,0</Thickness>
      <Thickness x:Key="Inset.OnbStatus">10,0</Thickness>
      <Thickness x:Key="Inset.OnbTag">8,2</Thickness>
      <!-- Avalonia keeps the baseline at the font's ascent when the line height is smaller than the font's own height; CSS shares the
           difference above and below the text. Lifting the text by that half keeps the baseline where the canvas has it and the box the same. -->
      <Thickness x:Key="Inset.OnbH1Lift">-32,-2.3,-32,-1.7</Thickness>
      <Thickness x:Key="Inset.OnbDescender">0,0,0,4</Thickness>
      <Thickness x:Key="Inset.OnbDisplayLift">-32,-3.4,-32,-0.6</Thickness>
      <Thickness x:Key="Inset.OnbOutline">20,0</Thickness>
      <Thickness x:Key="Inset.Choice">22,20</Thickness>
      <Thickness x:Key="Inset.Banner">24,20</Thickness>
      <Thickness x:Key="Inset.CardLabel">4,6,4,0</Thickness>
      <Thickness x:Key="Inset.Hotkey">8,0</Thickness>
      <Thickness x:Key="Inset.HotkeyText">4,0</Thickness>
      <Thickness x:Key="Inset.Row">24,20</Thickness>
      <Thickness x:Key="Inset.Cap">8,3</Thickness>
      <Thickness x:Key="Inset.OnbKnob">3</Thickness>
      <CornerRadius x:Key="Onb.Radius.Cap">6</CornerRadius>
      <CornerRadius x:Key="Onb.Radius.Badge">10</CornerRadius>
      <!-- The mockups write 1.5 px for the chosen card, the radio ring and the focused hotkey field; Chromium floors border widths to
           whole device pixels, so the canvas shows (and these styles use) the 1 px hairline. -->

      <!-- TODO(D-044): every Onb.* key in this file (FontSize, LineHeight, LetterSpacing, FontWeight, Radius, Space, Stroke, Dash, Orb, OrbBody) is
           a canvas value that tokens.json lacks; switch to the generated tokens once the shell task adds them.
           Type of the canvas that the scale of tokens.json lacks (the mockups use 11, 12, 13 and 15 px next to the 14 / 16 px steps);
           the line heights are the "normal" ones of Inter, the tracking is the root's 0.14 px that the mockups inherit. -->
      <x:Double x:Key="Onb.FontSize.H1">44</x:Double>
      <x:Double x:Key="Onb.LineHeight.H1">48.4</x:Double>
      <x:Double x:Key="Onb.LetterSpacing.H1">-0.88</x:Double>
      <x:Double x:Key="Onb.FontSize.Title">15</x:Double>
      <x:Double x:Key="Onb.LineHeight.Title">19</x:Double>
      <x:Double x:Key="Onb.FontSize.Note">13</x:Double>
      <x:Double x:Key="Onb.LineHeight.Note">16</x:Double>
      <x:Double x:Key="Onb.FontSize.Label">12</x:Double>
      <x:Double x:Key="Onb.LineHeight.Label">15</x:Double>
      <x:Double x:Key="Onb.FontSize.Tag">11</x:Double>
      <x:Double x:Key="Onb.LineHeight.Tag">14</x:Double>
      <x:Double x:Key="Onb.LineHeight.Body">17</x:Double>
      <x:Double x:Key="Onb.LineHeight.CardTitle">20</x:Double>
      <x:Double x:Key="Onb.LineHeight.Transcript">24.8</x:Double>
      <x:Double x:Key="Onb.LineHeight.Mono">17</x:Double>
      <x:Double x:Key="Onb.LetterSpacing.Base">0.14</x:Double>
      <x:Double x:Key="Onb.LetterSpacing.Wordmark">-0.15</x:Double>
      <FontWeight x:Key="Onb.FontWeight.Semibold">SemiBold</FontWeight>

      <!-- Component sizes (illustration sizes of the mockups, not layout tokens). -->
      <x:Double x:Key="Size.OnbButton">44</x:Double>
      <x:Double x:Key="Size.OnbBar">40</x:Double>
      <x:Double x:Key="Size.OnbFooter">48</x:Double>
      <x:Double x:Key="Size.OnbChevron">16</x:Double>
      <x:Double x:Key="Onb.Space.Step">14</x:Double>
      <x:Double x:Key="Onb.Space.Segment">6</x:Double>
      <x:Double x:Key="Onb.Space.Icon">6</x:Double>
      <x:Double x:Key="Onb.Space.Recorder">18</x:Double>
      <x:Double x:Key="Onb.Space.HairTight">6</x:Double>
      <x:Double x:Key="Size.OnbWaitingCard">92</x:Double>
      <x:Double x:Key="Size.OnbConsent">15</x:Double>
      <x:Double x:Key="Size.OnbChip">22</x:Double>
      <x:Double x:Key="Size.OnbSmallButton">36</x:Double>
      <x:Double x:Key="Onb.Space.Models">36</x:Double>
      <x:Double x:Key="Onb.Space.Compact">20</x:Double>
      <x:Double x:Key="Size.OnbOrbCompact">220</x:Double>
      <x:Double x:Key="Size.OnbVoiceOrbCompact">132</x:Double>
      <x:Double x:Key="Onb.Space.Cards">14</x:Double>
      <x:Double x:Key="Onb.Space.Tight">3</x:Double>
      <x:Double x:Key="Size.OnbCheck">13</x:Double>
      <x:Double x:Key="Size.OnbNoteCheck">14</x:Double>
      <x:Double x:Key="Onb.Stroke.Check">2.2</x:Double>
      <x:Double x:Key="Onb.Stroke.Chevron">1.6</x:Double>
      <x:Double x:Key="Onb.Radius.DashedCard">19.5</x:Double>
      <!-- Dash and gap of the waiting card outline, in multiples of its stroke. -->
      <coll:AvaloniaList x:Key="Onb.Dash.Outline"
                         x:TypeArguments="x:Double">
        <x:Double>3</x:Double>
        <x:Double>3</x:Double>
      </coll:AvaloniaList>
      <x:Double x:Key="Onb.Stroke.NoteCheck">2</x:Double>
      <x:Double x:Key="Size.OnbStatus">28</x:Double>
      <x:Double x:Key="Size.OnbStatusCard">26</x:Double>
      <x:Double x:Key="Onb.Space.Badge">10</x:Double>
      <x:Double x:Key="Onb.Space.Hair">2</x:Double>
      <x:Double x:Key="Onb.Space.WelcomeText">14</x:Double>
      <x:Double x:Key="Size.StepSegmentWidth">32</x:Double>
      <x:Double x:Key="Size.StepSegmentHeight">3</x:Double>
      <x:Double x:Key="Size.Meter">32</x:Double>
      <x:Double x:Key="Size.OnbField">40</x:Double>
      <x:Double x:Key="Size.Radio">18</x:Double>
      <x:Double x:Key="Size.RadioDot">8</x:Double>
      <x:Double x:Key="Size.SwitchWidth">44</x:Double>
      <x:Double x:Key="Size.SwitchHeight">26</x:Double>
      <x:Double x:Key="Size.SwitchKnob">20</x:Double>
      <x:Double x:Key="Size.HotkeyField">260</x:Double>
      <x:Double x:Key="Size.IconBadge">32</x:Double>
      <x:Double x:Key="Size.BannerIcon">40</x:Double>
      <x:Double x:Key="Size.Avatar">28</x:Double>
      <x:Double x:Key="Size.OnbOrb">300</x:Double>
      <x:Double x:Key="Onb.OrbBody.Welcome">0.77333</x:Double>
      <x:Double x:Key="Size.WordmarkOrb">18</x:Double>
      <x:Double x:Key="Size.OnbVoiceOrb">168</x:Double>
      <x:Double x:Key="Onb.OrbBody.Voice">0.78571</x:Double>
      <x:Double x:Key="Onb.Orb.GlowBlurWelcome">40</x:Double>
      <x:Double x:Key="Onb.Orb.GlowBlurVoice">28</x:Double>
      <x:Double x:Key="Size.OnbAudioWidth">840</x:Double>
      <x:Double x:Key="Size.OnbModelsWidth">760</x:Double>
      <x:Double x:Key="Size.OnbPreferencesWidth">720</x:Double>
      <x:Double x:Key="Size.OnbTranscriptWidth">640</x:Double>
      <x:Double x:Key="Size.OnbPickerWidth">260</x:Double>
      <!-- A locked model card: the mockups dim disabled content to 45 %. -->
      <x:Double x:Key="Opacity.Dimmed">0.45</x:Double>


      <!-- Line icons of the mockups' SVGs (24 x 24 grid), drawn by controls:IconControl. -->
      <StreamGeometry x:Key="Icon.ChevronLeft">M15 6l-6 6 6 6</StreamGeometry>
      <!-- 16 px grid (the picker draws it without scaling). -->
      <StreamGeometry x:Key="Icon.OnbChevronDown">M4 6l4 4 4-4</StreamGeometry>
      <StreamGeometry x:Key="Icon.OnbChevronUp">M4 10l4-4 4 4</StreamGeometry>
      <StreamGeometry x:Key="Icon.Microphone">M12 3a3 3 0 0 1 3 3v5a3 3 0 0 1-6 0V6a3 3 0 0 1 3-3z M5 11a7 7 0 0 0 14 0 M12 18v3</StreamGeometry>
      <StreamGeometry x:Key="Icon.Speaker">M4 9v6h4l5 4V5L8 9z M16.5 8.5a5 5 0 0 1 0 7</StreamGeometry>
      <StreamGeometry x:Key="Icon.Lock">M7 11h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2z M8 11V7a4 4 0 0 1 8 0v4</StreamGeometry>
      <StreamGeometry x:Key="Icon.Info">M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0 M12 11v5 M12 8h.01</StreamGeometry>
      <StreamGeometry x:Key="Icon.Play">M8 5v14l11-7z</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Text button (Back, Skip, Try again): a pill with no border; Surface when hovered. -->
  <Style Selector="Button.text">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Padding" Value="{StaticResource Inset.TextButton}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.BodySm}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.text.muted">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
  </Style>
  <Style Selector="Button.text:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="Button.text:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Stone}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="Button.text:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ash}" />
  </Style>

  <!-- The footer's primary and outline buttons use the mockups' 14 px label. -->
  <Style Selector="Button.primary.onb, Button.outline.onb">
    <Setter Property="FontSize" Value="{StaticResource FontSize.BodySm}" />
  </Style>

  <!-- Progress segments of the step indicator. -->
  <Style Selector="Border.segment">
    <Setter Property="Width" Value="{StaticResource Size.StepSegmentWidth}" />
    <Setter Property="Height" Value="{StaticResource Size.StepSegmentHeight}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Stone}" />
  </Style>
  <Style Selector="Border.segment.on">
    <Setter Property="Background" Value="{DynamicResource Brush.Ink}" />
  </Style>

  <!-- Selectable card (an AI model): hairline outline, Ink border when chosen. -->
  <Style Selector="Button.choice">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
    <Setter Property="Padding" Value="{StaticResource Inset.Choice}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stone}" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline.Thickness}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="Button.choice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stone}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="Button.choice:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="Button.choice.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Padding" Value="{StaticResource Inset.ChoiceOn}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline.Thickness}" />
  </Style>
  <Style Selector="Button.choice:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="{StaticResource Opacity.Dimmed}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stone}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>

  <!-- The option row "Skip AI for now": a text button with a radio mark. -->
  <Style Selector="Button.option">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Height" Value="{StaticResource Size.OnbField}" />
    <Setter Property="Padding" Value="{StaticResource Inset.OnbOption}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.BodySm}" />
  </Style>
  <Style Selector="Button.option:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>

  <!-- Radio mark: a ring, filled with a dot when chosen. -->
  <Style Selector="Border.radio">
    <Setter Property="Width" Value="{StaticResource Size.Radio}" />
    <Setter Property="Height" Value="{StaticResource Size.Radio}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.DashedBorder}" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline.Thickness}" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="{StaticResource Inset.OnbRadio}" />
  </Style>
  <Style Selector="Border.radio.on">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="Border.radio > Ellipse">
    <Setter Property="Width" Value="{StaticResource Size.RadioDot}" />
    <Setter Property="Height" Value="{StaticResource Size.RadioDot}" />
    <Setter Property="Fill" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.radio.on > Ellipse">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- Icon plate (microphone / speaker) and the round icon of the banners. -->
  <Style Selector="Border.iconBadge">
    <Setter Property="Width" Value="{StaticResource Size.IconBadge}" />
    <Setter Property="Height" Value="{StaticResource Size.IconBadge}" />
    <Setter Property="CornerRadius" Value="{StaticResource Onb.Radius.Badge}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
  </Style>
  <Style Selector="Border.bannerIcon">
    <Setter Property="Width" Value="{StaticResource Size.BannerIcon}" />
    <Setter Property="Height" Value="{StaticResource Size.BannerIcon}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.bannerIcon.ok">
    <Setter Property="Background" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="Border.avatar">
    <Setter Property="Width" Value="{StaticResource Size.Avatar}" />
    <Setter Property="Height" Value="{StaticResource Size.Avatar}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <!-- Key cap of the hotkey field. -->
  <Style Selector="Border.cap">
    <Setter Property="CornerRadius" Value="{StaticResource Onb.Radius.Cap}" />
    <Setter Property="Padding" Value="{StaticResource Inset.Cap}" />
    <Setter Property="Background" Value="{DynamicResource Brush.OnbCap}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Hotkey field: a 4 px field with the key caps inside; Ink border while it waits for a combination. -->
  <Style Selector="Button.hotkeyField">
    <Setter Property="Width" Value="{StaticResource Size.HotkeyField}" />
    <Setter Property="Height" Value="{StaticResource Size.OnbField}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Input}" />
    <Setter Property="Padding" Value="{StaticResource Inset.Hotkey}" />
    <Setter Property="Background" Value="{DynamicResource Brush.OnbField}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stone}" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline.Thickness}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.hotkeyField:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.OnbField}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ash}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="Button.hotkeyField.capturing /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline.Thickness}" />
  </Style>

  <!-- Switch (record the screen by default): Stone track with a knob, Ink track when on. -->
  <Style Selector="ToggleButton.switch">
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Track"
                Width="{StaticResource Size.SwitchWidth}"
                Height="{StaticResource Size.SwitchHeight}"
                Padding="{StaticResource Inset.OnbKnob}"
                CornerRadius="{StaticResource Radius.Pill}"
                Background="{DynamicResource Brush.Stone}">
          <Border x:Name="PART_Knob"
                  Width="{StaticResource Size.SwitchKnob}"
                  Height="{StaticResource Size.SwitchKnob}"
                  HorizontalAlignment="Left"
                  CornerRadius="{StaticResource Radius.Pill}"
                  Background="{DynamicResource Brush.SwitchKnobOff}"
                  BoxShadow="{DynamicResource Shadow.OnbKnob}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ToggleButton.switch:checked /template/ Border#PART_Track">
    <Setter Property="Background" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="ToggleButton.switch:checked /template/ Border#PART_Knob">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
  </Style>
  <Style Selector="ToggleButton.switch:disabled /template/ Border#PART_Track">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
  </Style>

  <!-- Step frames. Below 720 px of window height the page is "compact" (set by OnboardingView): smaller gaps and orbs, so the
       steps still fit the 900 x 600 minimum window without scrolling. The headlines may use the page margin (negative side
       margin), so a 48 px headline stays on one line in 900 px. -->
  <Style Selector="StackPanel.onbStep">
    <Setter Property="Spacing" Value="{StaticResource Onb.Space.Models}" />
  </Style>
  <Style Selector="StackPanel.onbStep.audio">
    <Setter Property="Spacing" Value="{StaticResource Space.40}" />
  </Style>
  <Style Selector="StackPanel.onbStep.voice">
    <Setter Property="Spacing" Value="{StaticResource Space.32}" />
  </Style>
  <Style Selector="StackPanel.onbWelcome">
    <Setter Property="Spacing" Value="{StaticResource Space.48}" />
  </Style>
  <!-- The canvas halo is absolutely positioned, so it paints over the (static) siblings that follow it: ZIndex 1. -->
  <Style Selector="controls|GlassOrbControl.welcome">
    <Setter Property="ZIndex" Value="1" />
    <Setter Property="Width" Value="{StaticResource Size.OnbOrb}" />
    <Setter Property="Height" Value="{StaticResource Size.OnbOrb}" />
  </Style>
  <Style Selector="controls|GlassOrbControl.voice">
    <Setter Property="ZIndex" Value="1" />
    <Setter Property="Width" Value="{StaticResource Size.OnbVoiceOrb}" />
    <Setter Property="Height" Value="{StaticResource Size.OnbVoiceOrb}" />
  </Style>
  <Style Selector=":is(UserControl).compact StackPanel.onbStep, :is(UserControl).compact StackPanel.onbStep.audio, :is(UserControl).compact StackPanel.onbStep.voice, :is(UserControl).compact StackPanel.onbWelcome">
    <Setter Property="Spacing" Value="{StaticResource Onb.Space.Compact}" />
  </Style>
  <Style Selector=":is(UserControl).compact controls|GlassOrbControl.welcome">
    <Setter Property="Width" Value="{StaticResource Size.OnbOrbCompact}" />
    <Setter Property="Height" Value="{StaticResource Size.OnbOrbCompact}" />
  </Style>
  <Style Selector=":is(UserControl).compact controls|GlassOrbControl.voice">
    <Setter Property="Width" Value="{StaticResource Size.OnbVoiceOrbCompact}" />
    <Setter Property="Height" Value="{StaticResource Size.OnbVoiceOrbCompact}" />
  </Style>

  <!-- Type of the onboarding (sizes of the canvas, see the resources above). -->
  <Style Selector="TextBlock.onbH1">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Display}" />
    <Setter Property="FontSize" Value="{StaticResource Onb.FontSize.H1}" />
    <Setter Property="LineHeight" Value="{StaticResource Onb.LineHeight.H1}" />
    <Setter Property="LetterSpacing" Value="{StaticResource Onb.LetterSpacing.H1}" />
    <Setter Property="Margin" Value="{StaticResource Inset.OnbH1Lift}" />
    <Setter Property="Padding" Value="{StaticResource Inset.OnbDescender}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.onbSub">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Body}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.Body}" />
    <Setter Property="LetterSpacing" Value="{StaticResource Onb.LetterSpacing.Base}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.onbWordmark">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource Onb.FontWeight.Semibold}" />
    <Setter Property="FontSize" Value="{StaticResource Onb.FontSize.Title}" />
    <Setter Property="LineHeight" Value="{StaticResource Onb.LineHeight.Title}" />
    <Setter Property="LetterSpacing" Value="{StaticResource Onb.LetterSpacing.Wordmark}" />
  </Style>
  <Style Selector="TextBlock.onbTitle">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
    <Setter Property="FontSize" Value="{StaticResource Onb.FontSize.Title}" />
    <Setter Property="LineHeight" Value="{StaticResource Onb.LineHeight.Title}" />
    <Setter Property="LetterSpacing" Value="{StaticResource Onb.LetterSpacing.Base}" />
  </Style>
  <Style Selector="TextBlock.onbBody">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Body}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.BodySm}" />
    <Setter Property="LineHeight" Value="{StaticResource Onb.LineHeight.Body}" />
    <Setter Property="LetterSpacing" Value="{StaticResource Onb.LetterSpacing.Base}" />
  </Style>
  <Style Selector="TextBlock.onbBodyMedium">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.BodySm}" />
    <Setter Property="LineHeight" Value="{StaticResource Onb.LineHeight.Body}" />
    <Setter Property="LetterSpacing" Value="{StaticResource Onb.LetterSpacing.Base}" />
  </Style>
  <Style Selector="TextBlock.onbNote">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Body}" />
    <Setter Property="FontSize" Value="{StaticResource Onb.FontSize.Note}" />
    <Setter Property="LineHeight" Value="{StaticResource Onb.LineHeight.Note}" />
    <Setter Property="LetterSpacing" Value="{StaticResource Onb.LetterSpacing.Base}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.onbNoteMedium">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
    <Setter Property="FontSize" Value="{StaticResource Onb.FontSize.Note}" />
    <Setter Property="LineHeight" Value="{StaticResource Onb.LineHeight.Note}" />
    <Setter Property="LetterSpacing" Value="{StaticResource Onb.LetterSpacing.Base}" />
  </Style>
  <Style Selector="TextBlock.onbLabel">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Body}" />
    <Setter Property="FontSize" Value="{StaticResource Onb.FontSize.Label}" />
    <Setter Property="LineHeight" Value="{StaticResource Onb.LineHeight.Label}" />
    <Setter Property="LetterSpacing" Value="{StaticResource Onb.LetterSpacing.Base}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
  </Style>
  <Style Selector="TextBlock.onbLabelMedium">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
    <Setter Property="FontSize" Value="{StaticResource Onb.FontSize.Label}" />
    <Setter Property="LineHeight" Value="{StaticResource Onb.LineHeight.Label}" />
    <Setter Property="LetterSpacing" Value="{StaticResource Onb.LetterSpacing.Base}" />
  </Style>
  <Style Selector="TextBlock.onbTag">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
    <Setter Property="FontSize" Value="{StaticResource Onb.FontSize.Tag}" />
    <Setter Property="LineHeight" Value="{StaticResource Onb.LineHeight.Tag}" />
    <Setter Property="LetterSpacing" Value="{StaticResource Onb.LetterSpacing.Base}" />
  </Style>
  <Style Selector="TextBlock.onbMono">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Mono}" />
    <Setter Property="LineHeight" Value="{StaticResource Onb.LineHeight.Mono}" />
    <Setter Property="LetterSpacing" Value="{StaticResource Onb.LetterSpacing.Base}" />
  </Style>

  <Style Selector="TextBlock.onbCardTitle">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="LineHeight" Value="{StaticResource Onb.LineHeight.CardTitle}" />
    <Setter Property="LetterSpacing" Value="{StaticResource Onb.LetterSpacing.Base}" />
  </Style>

  <!-- Device picker: 40 px tall, 12 px inside, 14 px text. -->
  <Style Selector="ComboBox.onb /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Brush.OnbField}" />
  </Style>
  <Style Selector="ComboBox.onb:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Brush.OnbField}" />
  </Style>
  <Style Selector="ComboBox.onb:pressed /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Brush.OnbField}" />
  </Style>
  <Style Selector="ComboBox.onb">
    <Setter Property="Height" Value="{StaticResource Size.OnbField}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="{StaticResource Inset.OnbField}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- The open picker (OnbComponents "Device dropdown - open"): Ink outline on the field, a 10 px list with 36 px rows. -->
  <!-- The picker's chevron: the mockup's 16 px line chevron (Smoke, round caps), not the Fluent filled one. -->
  <Style Selector="ComboBox.onb /template/ Path#DropDownGlyph">
    <Setter Property="Data" Value="{StaticResource Icon.OnbChevronDown}" />
    <Setter Property="Width" Value="{StaticResource Size.OnbChevron}" />
    <Setter Property="Height" Value="{StaticResource Size.OnbChevron}" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{DynamicResource Brush.Smoke}" />
    <Setter Property="StrokeThickness" Value="{StaticResource Onb.Stroke.Chevron}" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="ComboBox.onb:dropdownopen /template/ Path#DropDownGlyph">
    <Setter Property="Stroke" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="Data" Value="{StaticResource Icon.OnbChevronUp}" />
  </Style>
  <Style Selector="ComboBox.onb:dropdownopen /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="ComboBox.onb /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource Brush.OnbField}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.OnbListBorder}" />
    <Setter Property="CornerRadius" Value="{StaticResource Onb.Radius.Badge}" />
    <Setter Property="Padding" Value="{StaticResource Inset.4}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow.OnbList}" />
  </Style>
  <Style Selector="ComboBox.onb ComboBoxItem">
    <Setter Property="Height" Value="{StaticResource Size.NavSubItem}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="{StaticResource Inset.OnbItem}" />
    <Setter Property="CornerRadius" Value="{StaticResource Onb.Radius.Cap}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Item"
                Background="Transparent"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="*,Auto">
            <ContentPresenter x:Name="PART_ItemContent"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
            <!-- The chosen row ends with a check mark (OnbComponents "Device dropdown / Item - selected"). -->
            <controls:IconControl x:Name="PART_Check"
                                  Grid.Column="1"
                                  IsVisible="False"
                                  Width="{StaticResource Size.OnbNoteCheck}"
                                  Height="{StaticResource Size.OnbNoteCheck}"
                                  Stroke="{StaticResource Onb.Stroke.NoteCheck}"
                                  Data="{StaticResource Icon.Check}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ComboBox.onb ComboBoxItem /template/ ContentPresenter#PART_ItemContent">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ComboBox.onb ComboBoxItem:pointerover /template/ Border#PART_Item">
    <Setter Property="Background" Value="{DynamicResource Brush.OnbItemSelected}" />
  </Style>
  <Style Selector="ComboBox.onb ComboBoxItem:selected /template/ Border#PART_Item">
    <Setter Property="Background" Value="{DynamicResource Brush.OnbItemSelected}" />
  </Style>
  <Style Selector="ComboBox.onb ComboBoxItem:selected /template/ controls|IconControl#PART_Check">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- Buttons inside the banners: 40 px tall pills with the 14 px label. -->
  <Style Selector="Button.primary.onbBanner, Button.outline.onbBanner">
    <Setter Property="Height" Value="{StaticResource Size.OnbField}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="{StaticResource Inset.OnbOutline}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.BodySm}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Tag ("Required") and status chip ("Ready"). -->
  <Style Selector="Border.onbTagBox">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.ButtonBorder}" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline.Thickness}" />
    <Setter Property="Padding" Value="{StaticResource Inset.OnbTag}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.onbStatus">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Padding" Value="{StaticResource Inset.OnbStatus}" />
    <Setter Property="Height" Value="{StaticResource Size.OnbStatus}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.onbStatus.inCard">
    <Setter Property="Height" Value="{StaticResource Size.OnbStatusCard}" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <!-- "Change" next to the folder: a 36 px pill with the 13 px label. -->
  <Style Selector="Button.outline.onbChange">
    <Setter Property="Height" Value="{StaticResource Size.Compact}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="{StaticResource Inset.TextButton}" />
    <Setter Property="FontSize" Value="{StaticResource Onb.FontSize.Note}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.onbTranscript">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Body}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="LineHeight" Value="{StaticResource Onb.LineHeight.Transcript}" />
    <Setter Property="LetterSpacing" Value="{StaticResource Onb.LetterSpacing.Base}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Time chip of the transcript: a Surface pill, no outline. -->
  <Style Selector="Border.onbChip">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Height" Value="{StaticResource Size.OnbChip}" />
    <Setter Property="Padding" Value="{StaticResource Inset.OnbChip}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- "Try again" in the transcript card: 36 px, 13 px label. -->
  <Style Selector="Button.text.onbSmall">
    <Setter Property="Height" Value="{StaticResource Size.OnbSmallButton}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="{StaticResource Inset.OnbSmall}" />
    <Setter Property="FontSize" Value="{StaticResource Onb.FontSize.Note}" />
  </Style>

  <!-- Dashed outline of the waiting card. -->
  <Style Selector="Rectangle.dashedOutline">
    <Setter Property="Margin" Value="{StaticResource Inset.OnbDashed}" />
    <Setter Property="RadiusX" Value="{StaticResource Onb.Radius.DashedCard}" />
    <Setter Property="RadiusY" Value="{StaticResource Onb.Radius.DashedCard}" />
    <Setter Property="Stroke" Value="{DynamicResource Brush.DashedBorder}" />
    <Setter Property="StrokeThickness" Value="{StaticResource Hairline.Width}" />
    <Setter Property="StrokeDashArray" Value="{StaticResource Onb.Dash.Outline}" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- The canvas orb: wordmark (plain sphere), welcome orb and voice orb (sphere, inner glow, blurred halo). -->
  <Style Selector="controls|GlassOrbControl.welcome">
    <Setter Property="BodyFraction" Value="{StaticResource Onb.OrbBody.Welcome}" />
    <Setter Property="HaloBlur" Value="{DynamicResource Onb.Orb.WelcomeHaloBlur}" />
    <Setter Property="InnerGlowBlur" Value="{StaticResource Onb.Orb.GlowBlurWelcome}" />
    <Setter Property="InnerGlowOpacity" Value="{DynamicResource Onb.Orb.WelcomeGlow}" />
  </Style>
  <Style Selector="controls|GlassOrbControl.voice">
    <Setter Property="BodyFraction" Value="{StaticResource Onb.OrbBody.Voice}" />
    <Setter Property="HaloBlur" Value="{DynamicResource Onb.Orb.VoiceHaloBlur}" />
    <Setter Property="HaloOpacity" Value="{DynamicResource Onb.Orb.VoiceHaloOpacity}" />
    <Setter Property="InnerGlowBlur" Value="{StaticResource Onb.Orb.GlowBlurVoice}" />
    <Setter Property="InnerGlowOpacity" Value="{DynamicResource Onb.Orb.VoiceGlow}" />
  </Style>

  <!-- The footer's buttons: 44 px tall pills. Disabled primary = Stone with Ash text (OnbComponents). -->
  <Style Selector="Button.onbFoot">
    <Setter Property="Height" Value="{StaticResource Size.OnbButton}" />
    <Setter Property="Padding" Value="{StaticResource Inset.TextButton}" />
  </Style>
  <Style Selector="Button.primary.onb">
    <Setter Property="Height" Value="{StaticResource Size.OnbButton}" />
    <Setter Property="Padding" Value="{StaticResource Inset.OnbPrimary}" />
  </Style>
  <Style Selector="Button.outline.onb">
    <Setter Property="Height" Value="{StaticResource Size.OnbButton}" />
    <Setter Property="Padding" Value="{StaticResource Inset.OnbOutline}" />
  </Style>
  <Style Selector="Button.primary.onb:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Stone}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stone}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ash}" />
  </Style>


  <!-- Level meter. -->
  <Style Selector="controls|LevelMeterControl">
    <Setter Property="Height" Value="{StaticResource Size.Meter}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- Countdown pill: a Surface pill with the state word and the mono clock. -->
  <Style Selector="Border.countdown">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Padding" Value="{StaticResource Inset.Input}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
</Styles>
