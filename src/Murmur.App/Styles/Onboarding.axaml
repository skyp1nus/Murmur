<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Murmur.App.Controls"
        xmlns:coll="using:Avalonia.Collections">

  <!--
    Styles of the first-run onboarding (Onb1..Onb5 mockups). Like Controls.axaml this file holds no literal colours, fonts,
    radii or spacing: everything is a token resource, and every colour lookup is a DynamicResource (the one static lookup of
    a colour sits inside a ThemeDictionaries element, which resolves per theme). Accent colours stay in the orb.
  -->

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Styles/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <ResourceDictionary.ThemeDictionaries>
        <!-- The off knob of the switch: Canvas on Stone in the light theme, Graphite on Stone in the dark one (Onb4 / Onb4Dark). -->
        <ResourceDictionary x:Key="Light">
          <StaticResource x:Key="Brush.SwitchKnobOff" ResourceKey="Brush.Canvas" />
          <!-- Fill of the pickers and the hotkey field: Canvas in the light mockups, Surface in the dark ones. -->
          <StaticResource x:Key="Brush.OnbField" ResourceKey="Brush.Canvas" />
          <StaticResource x:Key="Brush.OnbCap" ResourceKey="Brush.Surface" />
          <StaticResource x:Key="Onb.Shadow.Knob" ResourceKey="Shadow.Subtle" />
          <!-- The open device list: its outline, its shadow and the chosen row. -->
          <StaticResource x:Key="Brush.OnbListBorder" ResourceKey="Brush.Stone" />
          <StaticResource x:Key="Onb.Shadow.List" ResourceKey="Shadow.Subtle" />
          <StaticResource x:Key="Brush.OnbItemSelected" ResourceKey="Brush.Surface" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <StaticResource x:Key="Brush.SwitchKnobOff" ResourceKey="Brush.Graphite" />
          <StaticResource x:Key="Brush.OnbField" ResourceKey="Brush.Surface" />
          <StaticResource x:Key="Brush.OnbCap" ResourceKey="Brush.Stone" />
          <BoxShadows x:Key="Onb.Shadow.Knob">none</BoxShadows>
          <StaticResource x:Key="Brush.OnbListBorder" ResourceKey="Brush.ButtonBorder" />
          <StaticResource x:Key="Onb.Shadow.List" ResourceKey="Shadow.PopoverDark" />
          <StaticResource x:Key="Brush.OnbItemSelected" ResourceKey="Brush.Stone" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Component paddings and offsets of the onboarding (Margin.*, like Styles/Shell.axaml; Inset.* is generated from tokens.json).
           Page frame: 28 at the sides (24 on the two last steps, which the canvas draws that way), the bars fix the height. -->
      <Thickness x:Key="Margin.OnbPage">28,0</Thickness>
      <Thickness x:Key="Margin.OnbPageDense">24,0</Thickness>
      <!-- The welcome orb sits one pixel lower than the stack puts it: the canvas centres a fractional height and Avalonia snaps the orb up. -->
      <Thickness x:Key="Margin.OnbOrbLift">0,1,0,0</Thickness>
      <Thickness x:Key="Margin.OnbBack">10,0,14,0</Thickness>
      <Thickness x:Key="Margin.OnbBackDense">12,0</Thickness>
      <Thickness x:Key="Margin.OnbSkip">14,0</Thickness>
      <Thickness x:Key="Margin.OnbSkipDense">12,0</Thickness>
      <!-- The canvas CTA has no border: 16 / 18 px of padding. The primary button of the app has a 1 px border of its own, so the padding is one less. -->
      <Thickness x:Key="Margin.OnbPrimary">15,0</Thickness>
      <Thickness x:Key="Margin.OnbBannerPrimary">13,0</Thickness>
      <Thickness x:Key="Margin.OnbPrimaryDense">17,0</Thickness>
      <Thickness x:Key="Margin.OnbField">10,0</Thickness>
      <Thickness x:Key="Margin.OnbItem">10,0</Thickness>
      <Thickness x:Key="Margin.OnbRadio">0,1,0,0</Thickness>
      <Thickness x:Key="Margin.OnbRadioFlat">0</Thickness>
      <Thickness x:Key="Margin.OnbChip">7,0</Thickness>
      <Thickness x:Key="Margin.OnbSmall">10,0</Thickness>
      <Thickness x:Key="Margin.OnbDashed">0.5</Thickness>
      <Thickness x:Key="Margin.OnbOption">12,0</Thickness>
      <Thickness x:Key="Margin.OnbCardExtra">0,6,0,0</Thickness>
      <Thickness x:Key="Margin.OnbOptionRow">2,0</Thickness>
      <Thickness x:Key="Margin.OnbOptionPull">-12,0,0,0</Thickness>
      <Thickness x:Key="Margin.OnbStatus">8,0</Thickness>
      <Thickness x:Key="Margin.OnbTag">7,1</Thickness>
      <Thickness x:Key="Margin.OnbChange">12,0</Thickness>
      <Thickness x:Key="Margin.OnbCardLabel">2,4,2,0</Thickness>
      <Thickness x:Key="Margin.OnbHotkey">4,0</Thickness>
      <Thickness x:Key="Margin.OnbHotkeyText">6,0</Thickness>
      <Thickness x:Key="Margin.OnbCap">7,0</Thickness>
      <Thickness x:Key="Margin.OnbKnob">3</Thickness>
      <!-- The mockups write 1.5 px for the chosen card, the radio ring and the focused hotkey field; Chromium floors border widths to
           whole device pixels, so the canvas shows (and these styles use) the 1 px hairline. -->

      <!-- Component sizes and drawing geometry of the onboarding (illustration sizes, icon strokes, the dash pattern and the radius of the
           dashed card = the card radius minus half a hairline): the geometry of single drawings, not tokens. The sizes of the two
           orbs (welcome, voice) are tokens ("glassOrbs"); the brand's 16 px orb is layout and stays here. -->
      <x:Double x:Key="Size.OnbCta">36</x:Double>
      <x:Double x:Key="Size.OnbBar">48</x:Double>
      <x:Double x:Key="Size.OnbFooter">56</x:Double>
      <x:Double x:Key="Size.OnbChevron">14</x:Double>
      <x:Double x:Key="Size.OnbWaitingCard">72</x:Double>
      <x:Double x:Key="Size.OnbConsent">13</x:Double>
      <x:Double x:Key="Size.OnbChip">20</x:Double>
      <x:Double x:Key="Size.OnbCheck">12</x:Double>
      <x:Double x:Key="Size.OnbNoteCheck">13</x:Double>
      <x:Double x:Key="Size.OnbBannerGlyph">15</x:Double>
      <x:Double x:Key="Size.OnbPlay">7</x:Double>
      <x:Double x:Key="Onb.Stroke.Check">2.2</x:Double>
      <x:Double x:Key="Onb.Stroke.Chevron">0.93</x:Double>
      <x:Double x:Key="Onb.Radius.DashedCard">15.5</x:Double>
      <!-- Dash and gap of the waiting card outline, in multiples of its stroke. -->
      <coll:AvaloniaList x:Key="Onb.Dash.Outline"
                         x:TypeArguments="x:Double">
        <x:Double>3</x:Double>
        <x:Double>3</x:Double>
      </coll:AvaloniaList>
      <x:Double x:Key="Onb.Stroke.NoteCheck">2</x:Double>
      <x:Double x:Key="Size.OnbStatus">24</x:Double>
      <x:Double x:Key="Size.OnbStatusCard">22</x:Double>
      <x:Double x:Key="Size.StepSegmentWidth">24</x:Double>
      <x:Double x:Key="Size.StepSegmentHeight">3</x:Double>
      <x:Double x:Key="Size.Meter">24</x:Double>
      <x:Double x:Key="Size.SwitchWidth">36</x:Double>
      <x:Double x:Key="Size.SwitchHeight">20</x:Double>
      <x:Double x:Key="Size.SwitchKnob">14</x:Double>
      <x:Double x:Key="Size.Radio">16</x:Double>
      <x:Double x:Key="Size.RadioDot">7</x:Double>
      <x:Double x:Key="Size.HotkeyField">200</x:Double>
      <x:Double x:Key="Size.IconBadge">28</x:Double>
      <x:Double x:Key="Size.BannerIcon">32</x:Double>
      <x:Double x:Key="Size.Avatar">24</x:Double>
      <x:Double x:Key="Size.OnbKey">24</x:Double>
      <x:Double x:Key="Size.OnbWordmarkOrb">16</x:Double>
      <x:Double x:Key="Size.OnbTextWidth">560</x:Double>
      <x:Double x:Key="Size.OnbAudioWidth">580</x:Double>
      <x:Double x:Key="Size.OnbModelsWidth">580</x:Double>
      <x:Double x:Key="Size.OnbPreferencesWidth">560</x:Double>
      <x:Double x:Key="Size.OnbTranscriptWidth">560</x:Double>
      <x:Double x:Key="Size.OnbPickerWidth">200</x:Double>
      <!-- A locked model card: the mockups dim disabled content to 45 %. -->
      <x:Double x:Key="Opacity.Dimmed">0.45</x:Double>


      <!-- Line icons of the mockups' SVGs (24 x 24 grid), drawn by controls:IconControl. -->
      <StreamGeometry x:Key="Icon.ChevronLeft">M15 6l-6 6 6 6</StreamGeometry>
      <!-- 14 px grid (the picker draws it without scaling; the canvas scales its 24 px chevron to 14). -->
      <StreamGeometry x:Key="Icon.OnbChevronDown">M3.5 5.25l3.5 3.5 3.5-3.5</StreamGeometry>
      <StreamGeometry x:Key="Icon.OnbChevronUp">M3.5 8.75l3.5-3.5 3.5 3.5</StreamGeometry>
      <StreamGeometry x:Key="Icon.Microphone">M12 3a3 3 0 0 1 3 3v5a3 3 0 0 1-6 0V6a3 3 0 0 1 3-3z M5 11a7 7 0 0 0 14 0 M12 18v3</StreamGeometry>
      <StreamGeometry x:Key="Icon.Lock">M7 11h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2z M8 11V7a4 4 0 0 1 8 0v4</StreamGeometry>
      <StreamGeometry x:Key="Icon.Info">M3 12a9 9 0 1 0 18 0a9 9 0 1 0 -18 0 M12 11v5 M12 8h.01</StreamGeometry>
      <StreamGeometry x:Key="Icon.Play">M8 5v14l11-7z</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Text button (Back, Skip, Try again): a pill with no border; Surface when hovered. -->
  <Style Selector="Button.text">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Padding" Value="{StaticResource Inset.Button}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Meta}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.text.muted">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
  </Style>
  <Style Selector="Button.text:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="Button.text.muted:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
  </Style>
  <Style Selector="Button.text:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Stone}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="Button.text:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ash}" />
  </Style>

  <!-- Progress segments of the step indicator: 24 x 3, 4 apart. -->
  <Style Selector="Border.segment">
    <Setter Property="Width" Value="{StaticResource Size.StepSegmentWidth}" />
    <Setter Property="Height" Value="{StaticResource Size.StepSegmentHeight}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Stone}" />
  </Style>
  <Style Selector="Border.segment.on">
    <Setter Property="Background" Value="{DynamicResource Brush.Ink}" />
  </Style>

  <!-- The frame of the page: the bars and the step indicator. The canvas draws the last two steps with a 24 px frame, a 12 px
       gap in the step indicator and tighter footer buttons ("dense", set by OnboardingView from the step). -->
  <Style Selector="Grid.onbFrame">
    <Setter Property="Margin" Value="{StaticResource Margin.OnbPage}" />
  </Style>
  <Style Selector=":is(UserControl).dense Grid.onbFrame">
    <Setter Property="Margin" Value="{StaticResource Margin.OnbPageDense}" />
  </Style>
  <Style Selector="StackPanel.onbIndicator">
    <Setter Property="Spacing" Value="{StaticResource Space.10}" />
  </Style>
  <Style Selector=":is(UserControl).dense StackPanel.onbIndicator">
    <Setter Property="Spacing" Value="{StaticResource Space.12}" />
  </Style>
  <Style Selector="StackPanel.onbFootLeft">
    <Setter Property="Spacing" Value="{StaticResource Space.4}" />
  </Style>
  <Style Selector=":is(UserControl).dense StackPanel.onbFootLeft">
    <Setter Property="Spacing" Value="{StaticResource Space.2}" />
  </Style>

  <!-- The footer's buttons: 32 px text buttons, 36 px calls to action. Disabled primary = Stone with Ash text (OnbComponents). -->
  <Style Selector="Button.text.onbBack">
    <Setter Property="Height" Value="{StaticResource Size.Button}" />
    <Setter Property="Padding" Value="{StaticResource Margin.OnbBack}" />
  </Style>
  <Style Selector=":is(UserControl).dense Button.text.onbBack">
    <Setter Property="Padding" Value="{StaticResource Margin.OnbBackDense}" />
  </Style>
  <Style Selector="Button.text.onbSkip">
    <Setter Property="Height" Value="{StaticResource Size.Button}" />
    <Setter Property="Padding" Value="{StaticResource Margin.OnbSkip}" />
  </Style>
  <Style Selector=":is(UserControl).dense Button.text.onbSkip">
    <Setter Property="Padding" Value="{StaticResource Margin.OnbSkipDense}" />
  </Style>
  <Style Selector="Button.primary.onb, Button.outline.onb">
    <Setter Property="Height" Value="{StaticResource Size.OnbCta}" />
    <Setter Property="Padding" Value="{StaticResource Margin.OnbPrimary}" />
  </Style>
  <Style Selector=":is(UserControl).dense Button.primary.onb, :is(UserControl).dense Button.outline.onb">
    <Setter Property="Padding" Value="{StaticResource Margin.OnbPrimaryDense}" />
  </Style>
  <Style Selector="Button.primary.onb:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Stone}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stone}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ash}" />
  </Style>

  <!-- Selectable card (an AI model): hairline outline, Ink border when chosen. -->
  <Style Selector="Button.choice">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
    <Setter Property="Padding" Value="{StaticResource Inset.CardList}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stone}" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline.Thickness}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="Button.choice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stone}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="Button.choice:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="Button.choice.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline.Thickness}" />
  </Style>
  <Style Selector="Button.choice:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="{StaticResource Opacity.Dimmed}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stone}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>

  <!-- The option row "Skip AI for now": a text button with a radio mark. -->
  <Style Selector="Button.option">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Height" Value="{StaticResource Size.Button}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="{StaticResource Margin.OnbOption}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Meta}" />
  </Style>
  <Style Selector="Button.option:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>

  <!-- Radio mark: a ring, filled with a dot when chosen. -->
  <Style Selector="Border.radio">
    <Setter Property="Width" Value="{StaticResource Size.Radio}" />
    <Setter Property="Height" Value="{StaticResource Size.Radio}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.DashedBorder}" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline.Thickness}" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="{StaticResource Margin.OnbRadio}" />
  </Style>
  <Style Selector="Border.radio.on">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="Border.radio > Ellipse">
    <Setter Property="Width" Value="{StaticResource Size.RadioDot}" />
    <Setter Property="Height" Value="{StaticResource Size.RadioDot}" />
    <Setter Property="Fill" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.radio.on > Ellipse">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- Icon plate (microphone / speaker) and the round icon of the banners. -->
  <Style Selector="Border.iconBadge">
    <Setter Property="Width" Value="{StaticResource Size.IconBadge}" />
    <Setter Property="Height" Value="{StaticResource Size.IconBadge}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Tile}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
  </Style>
  <Style Selector="Border.bannerIcon">
    <Setter Property="Width" Value="{StaticResource Size.BannerIcon}" />
    <Setter Property="Height" Value="{StaticResource Size.BannerIcon}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.bannerIcon.ok">
    <Setter Property="Background" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="Border.avatar">
    <Setter Property="Width" Value="{StaticResource Size.Avatar}" />
    <Setter Property="Height" Value="{StaticResource Size.Avatar}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <!-- Key cap of the hotkey field: 24 px tall. -->
  <Style Selector="Border.cap">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Key}" />
    <Setter Property="Padding" Value="{StaticResource Margin.OnbCap}" />
    <Setter Property="Height" Value="{StaticResource Size.OnbKey}" />
    <Setter Property="Background" Value="{DynamicResource Brush.OnbCap}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Hotkey field: a 4 px field with the key caps inside; Ink border while it waits for a combination. -->
  <Style Selector="Button.hotkeyField">
    <Setter Property="Width" Value="{StaticResource Size.HotkeyField}" />
    <Setter Property="Height" Value="{StaticResource Size.Field}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Input}" />
    <Setter Property="Padding" Value="{StaticResource Margin.OnbHotkey}" />
    <Setter Property="Background" Value="{DynamicResource Brush.OnbField}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stone}" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline.Thickness}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.hotkeyField:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.OnbField}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ash}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="Button.hotkeyField.capturing /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline.Thickness}" />
  </Style>

  <!-- Switch (record the screen by default): Stone track with a knob, Ink track when on. -->
  <Style Selector="ToggleButton.switch">
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Track"
                Width="{StaticResource Size.SwitchWidth}"
                Height="{StaticResource Size.SwitchHeight}"
                Padding="{StaticResource Margin.OnbKnob}"
                CornerRadius="{StaticResource Radius.Pill}"
                Background="{DynamicResource Brush.Stone}">
          <Border x:Name="PART_Knob"
                  Width="{StaticResource Size.SwitchKnob}"
                  Height="{StaticResource Size.SwitchKnob}"
                  HorizontalAlignment="Left"
                  CornerRadius="{StaticResource Radius.Pill}"
                  Background="{DynamicResource Brush.SwitchKnobOff}"
                  BoxShadow="{DynamicResource Onb.Shadow.Knob}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ToggleButton.switch:checked /template/ Border#PART_Track">
    <Setter Property="Background" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="ToggleButton.switch:checked /template/ Border#PART_Knob">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
  </Style>
  <Style Selector="ToggleButton.switch:disabled /template/ Border#PART_Track">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
  </Style>

  <!-- Step frames. Below 720 px of window height the page is "compact" (set by OnboardingView): smaller gaps, so the steps still
       fit the 900 x 600 minimum window without scrolling. -->
  <Style Selector="StackPanel.onbStep">
    <Setter Property="Spacing" Value="{StaticResource Space.24}" />
  </Style>
  <Style Selector="StackPanel.onbStep.voice">
    <Setter Property="Spacing" Value="{StaticResource Space.20}" />
  </Style>
  <Style Selector="StackPanel.onbWelcome">
    <Setter Property="Spacing" Value="{StaticResource Space.28}" />
  </Style>
  <!-- The headline and the line under it. -->
  <Style Selector="StackPanel.onbText">
    <Setter Property="Spacing" Value="{StaticResource Space.8}" />
    <Setter Property="MaxWidth" Value="{StaticResource Size.OnbTextWidth}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <!-- The canvas orbs (welcome, voice: sphere, inner glow, blurred halo; sizes and look are the Glass.* tokens). The halo is absolutely positioned, so it paints over the (static) siblings that follow it: ZIndex 1. -->
  <Style Selector="controls|GlassOrbControl.welcome">
    <Setter Property="ZIndex" Value="1" />
    <Setter Property="Width" Value="{StaticResource Glass.Welcome.Size}" />
    <Setter Property="Height" Value="{StaticResource Glass.Welcome.Size}" />
    <Setter Property="BodyFraction" Value="{StaticResource Glass.Welcome.Body}" />
    <Setter Property="HaloBlur" Value="{DynamicResource Glass.Welcome.HaloBlur}" />
    <Setter Property="HaloOpacity" Value="{DynamicResource Glass.Welcome.HaloOpacity}" />
    <Setter Property="InnerGlowBlur" Value="{StaticResource Glass.Welcome.GlowBlur}" />
    <Setter Property="InnerGlowOpacity" Value="{DynamicResource Glass.Welcome.Glow}" />
  </Style>
  <Style Selector="controls|GlassOrbControl.voice">
    <Setter Property="ZIndex" Value="1" />
    <Setter Property="Width" Value="{StaticResource Glass.Voice.Size}" />
    <Setter Property="Height" Value="{StaticResource Glass.Voice.Size}" />
    <Setter Property="BodyFraction" Value="{StaticResource Glass.Voice.Body}" />
    <Setter Property="HaloBlur" Value="{DynamicResource Glass.Voice.HaloBlur}" />
    <Setter Property="HaloOpacity" Value="{DynamicResource Glass.Voice.HaloOpacity}" />
    <Setter Property="InnerGlowBlur" Value="{StaticResource Glass.Voice.GlowBlur}" />
    <Setter Property="InnerGlowOpacity" Value="{DynamicResource Glass.Voice.Glow}" />
  </Style>
  <Style Selector=":is(UserControl).compact StackPanel.onbStep, :is(UserControl).compact StackPanel.onbStep.voice, :is(UserControl).compact StackPanel.onbWelcome">
    <Setter Property="Spacing" Value="{StaticResource Space.16}" />
  </Style>

  <!-- Type of the onboarding: steps of the type scale in tokens.json (the "Tight" ones have the line height Inter would use on its own, the canvas's). -->
  <Style Selector="TextBlock.onbH1">
    <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Display}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.OnbTitle}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.OnbTitle}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.OnbTitle}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.onbSub">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Body}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.BodySm}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.BodySm}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.BodySm}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.onbWordmark">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodySemiBold}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.WordmarkSm}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.WordmarkSm}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.WordmarkSm}" />
  </Style>
  <!-- 13 / 500: the title of a model card, of a banner and of a settings row. -->
  <Style Selector="TextBlock.onbTitle">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.MetaTight}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.MetaTight}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.MetaTight}" />
  </Style>
  <Style Selector="TextBlock.onbBody">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Body}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.MetaTight}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.MetaTight}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.MetaTight}" />
  </Style>
  <Style Selector="TextBlock.onbBodyMedium">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.MetaTight}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.MetaTight}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.MetaTight}" />
  </Style>
  <Style Selector="TextBlock.onbNote">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Body}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.SmallTight}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.SmallTight}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.SmallTight}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.onbNoteMedium">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.SmallTight}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.SmallTight}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.SmallTight}" />
  </Style>
  <Style Selector="TextBlock.onbLabel">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Body}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Tag}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.Tag}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.Tag}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Smoke}" />
  </Style>
  <Style Selector="TextBlock.onbLabelMedium">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Tag}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.Tag}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.Tag}" />
  </Style>
  <Style Selector="TextBlock.onbTag">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Tag}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.Tag}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.Tag}" />
  </Style>
  <!-- The "You" in the avatar of the transcript card: 10 / 500. -->
  <Style Selector="TextBlock.onbAvatar">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.Caption}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.Caption}" />
  </Style>
  <Style Selector="TextBlock.onbMono">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.MonoRow}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.MonoRow}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.MonoRow}" />
  </Style>
  <Style Selector="TextBlock.onbMonoSmall">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.MonoSmall}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.MonoSmall}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.MonoSmall}" />
  </Style>

  <!-- 14 / 500: the title of a device card. -->
  <Style Selector="TextBlock.onbCardTitle">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.BodyMedium}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.BodySmTight}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.BodySmTight}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.BodySmTight}" />
  </Style>

  <!-- Device picker: 32 px tall, 10 px inside, 13 px text. -->
  <Style Selector="ComboBox.onb /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Brush.OnbField}" />
  </Style>
  <Style Selector="ComboBox.onb:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Brush.OnbField}" />
  </Style>
  <Style Selector="ComboBox.onb:pressed /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Brush.OnbField}" />
  </Style>
  <Style Selector="ComboBox.onb">
    <Setter Property="Height" Value="{StaticResource Size.Field}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="{StaticResource Margin.OnbField}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- The open picker (OnbComponents "Device dropdown - open"): Ink outline on the field, a 10 px list with 28 px rows. -->
  <!-- The picker's chevron: the mockup's line chevron (Smoke, round caps), not the Fluent filled one. -->
  <Style Selector="ComboBox.onb /template/ Path#DropDownGlyph">
    <Setter Property="Data" Value="{StaticResource Icon.OnbChevronDown}" />
    <Setter Property="Width" Value="{StaticResource Size.OnbChevron}" />
    <Setter Property="Height" Value="{StaticResource Size.OnbChevron}" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{DynamicResource Brush.Smoke}" />
    <Setter Property="StrokeThickness" Value="{StaticResource Onb.Stroke.Chevron}" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="ComboBox.onb:dropdownopen /template/ Path#DropDownGlyph">
    <Setter Property="Stroke" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="Data" Value="{StaticResource Icon.OnbChevronUp}" />
  </Style>
  <Style Selector="ComboBox.onb:dropdownopen /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ink}" />
  </Style>
  <Style Selector="ComboBox.onb /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource Brush.OnbField}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.OnbListBorder}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Tile}" />
    <Setter Property="Padding" Value="{StaticResource Inset.4}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Onb.Shadow.List}" />
  </Style>
  <Style Selector="ComboBox.onb ComboBoxItem">
    <Setter Property="Height" Value="{StaticResource Size.NavSubItem}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="{StaticResource Margin.OnbItem}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Key}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Item"
                Background="Transparent"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="*,Auto">
            <ContentPresenter x:Name="PART_ItemContent"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
            <!-- The chosen row ends with a check mark (OnbComponents "Device dropdown / Item - selected"). -->
            <controls:IconControl x:Name="PART_Check"
                                  Grid.Column="1"
                                  IsVisible="False"
                                  Width="{StaticResource Size.OnbNoteCheck}"
                                  Height="{StaticResource Size.OnbNoteCheck}"
                                  Stroke="{StaticResource Onb.Stroke.NoteCheck}"
                                  Data="{StaticResource Icon.Check}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ComboBox.onb ComboBoxItem /template/ ContentPresenter#PART_ItemContent">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ComboBox.onb ComboBoxItem:pointerover /template/ Border#PART_Item">
    <Setter Property="Background" Value="{DynamicResource Brush.OnbItemSelected}" />
  </Style>
  <Style Selector="ComboBox.onb ComboBoxItem:selected /template/ Border#PART_Item">
    <Setter Property="Background" Value="{DynamicResource Brush.OnbItemSelected}" />
  </Style>
  <Style Selector="ComboBox.onb ComboBoxItem:selected /template/ controls|IconControl#PART_Check">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- Buttons inside the banners: the 32 px pills of the page. -->
  <Style Selector="Button.primary.onbBanner, Button.outline.onbBanner">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.primary.onbBanner">
    <Setter Property="Padding" Value="{StaticResource Margin.OnbBannerPrimary}" />
  </Style>

  <!-- Tag ("Required") and status chip ("Ready"). -->
  <Style Selector="Border.onbTagBox">
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.ButtonBorder}" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline.Thickness}" />
    <Setter Property="Padding" Value="{StaticResource Margin.OnbTag}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.onbStatus">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Padding" Value="{StaticResource Margin.OnbStatus}" />
    <Setter Property="Height" Value="{StaticResource Size.OnbStatus}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.onbStatus.inCard">
    <Setter Property="Height" Value="{StaticResource Size.OnbStatusCard}" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <!-- "Change" next to the folder: a 28 px pill with the 12 px label. -->
  <Style Selector="Button.outline.onbChange">
    <Setter Property="Height" Value="{StaticResource Size.Compact}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="{StaticResource Margin.OnbChange}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.onbTranscript">
    <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
    <Setter Property="FontWeight" Value="{StaticResource FontWeight.Body}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.OnbTranscript}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight.OnbTranscript}" />
    <Setter Property="LetterSpacing" Value="{StaticResource LetterSpacing.OnbTranscript}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Time chip of the transcript: a Surface pill, no outline. -->
  <Style Selector="Border.onbChip">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Height" Value="{StaticResource Size.OnbChip}" />
    <Setter Property="Padding" Value="{StaticResource Margin.OnbChip}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- "Try again" in the transcript card: 28 px, 12 px label. -->
  <Style Selector="Button.text.onbSmall">
    <Setter Property="Height" Value="{StaticResource Size.Compact}" />
    <Setter Property="Padding" Value="{StaticResource Margin.OnbSmall}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
  </Style>

  <!-- Dashed outline of the waiting card. -->
  <Style Selector="Rectangle.onbDashedOutline">
    <Setter Property="Margin" Value="{StaticResource Margin.OnbDashed}" />
    <Setter Property="RadiusX" Value="{StaticResource Onb.Radius.DashedCard}" />
    <Setter Property="RadiusY" Value="{StaticResource Onb.Radius.DashedCard}" />
    <Setter Property="Stroke" Value="{DynamicResource Brush.DashedBorder}" />
    <Setter Property="StrokeThickness" Value="{StaticResource Hairline.Width}" />
    <Setter Property="StrokeDashArray" Value="{StaticResource Onb.Dash.Outline}" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- Level meter: 24 px tall. -->
  <Style Selector="controls|LevelMeterControl">
    <Setter Property="Height" Value="{StaticResource Size.Meter}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- Countdown pill: a 28 px Surface pill with the state word and the mono clock. -->
  <Style Selector="Border.countdown">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
    <Setter Property="Height" Value="{StaticResource Size.Compact}" />
    <Setter Property="Padding" Value="{StaticResource Inset.Compact}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
</Styles>
