<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Line icons of the mockups (24 x 24 grid, round 1.6 stroke), drawn by controls:IconControl. They carry no colour: the
    control strokes with the foreground it inherits.
  -->
  <StreamGeometry x:Key="Icon.Library">M4 5h16M4 12h16M4 19h10</StreamGeometry>
  <StreamGeometry x:Key="Icon.Ai">M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z M19 16v4M17 18h4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Settings">M4 7h10M18 7h2M4 17h4M12 17h8 M14 7a2 2 0 1 0 4 0a2 2 0 1 0 -4 0 M8 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0</StreamGeometry>
  <StreamGeometry x:Key="Icon.Shield">M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Check">M5 12l5 5L20 7</StreamGeometry>
  <StreamGeometry x:Key="Icon.Download">M12 4v11M7 10l5 5 5-5M5 20h14</StreamGeometry>
  <StreamGeometry x:Key="Icon.Folder">M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z</StreamGeometry>
</ResourceDictionary>
