<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows application manifest of the ASR worker. Native AOT embeds it into the win-* executable.
  activeCodePage=UTF-8 makes the process ANSI code page UTF-8 (Windows 10 1903+), so sherpa-onnx, which opens
  model files through narrow std::string / std::ifstream paths, reads the UTF-8 paths we pass correctly even for
  non-ASCII profile directories such as C:\Users\Владислав\AppData\... (UNVERIFIED-ON-WINDOWS).
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="Murmur.Transcription" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
