<Project Sdk="Microsoft.NET.Sdk">

  <!-- ASR worker process: runs out of process so models never live in the recorder's memory. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Murmur.Transcription</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Murmur.Core\Murmur.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Murmur.Transcription.Tests" />
  </ItemGroup>

</Project>
