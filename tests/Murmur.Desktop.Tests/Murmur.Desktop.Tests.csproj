<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      The portable build (no WINDOWS symbol) runs every test here. The Windows build only compiles Windows/**: the tests of the real
      Win32 window of the floating orb, which need Murmur.Capture.Windows. On Linux they are skipped.
    -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>$(MurmurTargetFramework);$(MurmurWindowsTargetFramework)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Murmur.Desktop.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == '$(MurmurWindowsTargetFramework)'">
    <SupportedOSPlatformVersion>$(MurmurWindowsMinVersion)</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == '$(MurmurWindowsTargetFramework)'">
    <Compile Remove="**/*.cs" />
    <Compile Include="Windows/**/*.cs" Exclude="bin/**;obj/**" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != '$(MurmurWindowsTargetFramework)'">
    <Compile Remove="Windows/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Murmur.Desktop\Murmur.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The log fake of the Core tests (#100). -->
    <Compile Include="..\Murmur.Core.Tests\Fakes\RecordingAppLog.cs" Link="Fakes\RecordingAppLog.cs" />
  </ItemGroup>

</Project>
