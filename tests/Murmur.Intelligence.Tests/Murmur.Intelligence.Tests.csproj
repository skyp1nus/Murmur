<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Murmur.Intelligence.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Desktop has no test project: its small, Core-only wiring helpers are compiled into this one. -->
  <ItemGroup>
    <Compile Include="..\..\src\Murmur.Desktop\AiAwareModelManager.cs" Link="Desktop\AiAwareModelManager.cs" />
    <Compile Include="..\..\src\Murmur.Desktop\AiReindexScheduler.cs" Link="Desktop\AiReindexScheduler.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Murmur.Intelligence\Murmur.Intelligence.csproj" />
  </ItemGroup>

</Project>
