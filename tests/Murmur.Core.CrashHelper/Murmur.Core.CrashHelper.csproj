<Project Sdk="Microsoft.NET.Sdk">

  <!-- Child process for the crash test in Murmur.Core.Tests: records with SyntheticCapture until it is killed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Murmur.Core.CrashHelper</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Murmur.Core\Murmur.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Murmur.Core.Tests\Fakes\InMemorySessionStore.cs" Link="InMemorySessionStore.cs" />
    <Compile Include="..\Murmur.Core.Tests\Fakes\ManualTimeProvider.cs" Link="ManualTimeProvider.cs" />
    <Compile Include="..\Murmur.Core.Tests\Fakes\SampleClock.cs" Link="SampleClock.cs" />
  </ItemGroup>

</Project>
