<Project Sdk="Microsoft.NET.Sdk">

  <!-- JIT-only: BenchmarkDotNet relies on reflection and runtime code generation. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Murmur.Benchmarks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Murmur.Core\Murmur.Core.csproj" />
    <ProjectReference Include="..\..\src\Murmur.Storage\Murmur.Storage.csproj" />
  </ItemGroup>

  <!-- Pure timing math of the screen recorder (no Windows APIs), linked so it runs on the net11.0 benchmark TFM. -->
  <ItemGroup>
    <Compile Include="..\..\src\Murmur.Capture.Windows\Screen\FrameTiming.cs" Link="Linked\FrameTiming.cs" />
    <Compile Include="..\..\src\Murmur.Capture.Windows\Screen\EncoderGeometry.cs" Link="Linked\EncoderGeometry.cs" />
  </ItemGroup>

</Project>
