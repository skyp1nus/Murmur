<Project Sdk="Microsoft.NET.Sdk">

  <!-- JIT-only: BenchmarkDotNet relies on reflection and runtime code generation. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Murmur.Benchmarks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Murmur.Core\Murmur.Core.csproj" />
    <ProjectReference Include="..\..\src\Murmur.Storage\Murmur.Storage.csproj" />
  </ItemGroup>

  <!-- Pure timing math of the screen recorder (no Windows APIs), linked so it runs on the net11.0 benchmark TFM. -->
  <ItemGroup>
    <Compile Include="..\..\src\Murmur.Capture.Windows\Screen\FrameTiming.cs" Link="Linked\FrameTiming.cs" />
    <Compile Include="..\..\src\Murmur.Capture.Windows\Screen\KeyFrameSchedule.cs" Link="Linked\KeyFrameSchedule.cs" />
    <Compile Include="..\..\src\Murmur.Capture.Windows\Screen\EncoderGeometry.cs" Link="Linked\EncoderGeometry.cs" />
    <!-- The WSOLA time stretcher of the Windows player (pure C#, the render-callback hot path at speeds other than 1). -->
    <Compile Include="..\..\src\Murmur.Capture.Windows\Playback\WsolaStretcher.cs" Link="Linked\WsolaStretcher.cs" />
    <!-- The position-to-word lookup of the transcript's follow-along highlight (pure C#, run at the player's poll rate). -->
    <Compile Include="..\..\src\Murmur.App\ViewModels\TranscriptTimeline.cs" Link="Linked\TranscriptTimeline.cs" />
    <!-- The per-frame code of the level bars that scroll on the render thread (pure C#, no Avalonia types). -->
    <Compile Include="..\..\src\Murmur.App\Controls\LevelBars.cs" Link="Linked\LevelBars.cs" />
  </ItemGroup>

</Project>
