<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Murmur.Core.Tests</RootNamespace>
    <!--
      The app ships as Native AOT (no JIT tiering). With tiering on, the runtime occasionally allocates on whichever
      thread triggers a tier-up (e.g. re-creating the tiering background worker), which the zero-allocation assertions
      on hot paths would blame on our code. Fully optimized JIT from the first call matches AOT behaviour.
    -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Murmur.Core\Murmur.Core.csproj" />
    <!-- Child process of the crash test; referenced so it is built and copied next to the tests. -->
    <ProjectReference Include="..\Murmur.Core.CrashHelper\Murmur.Core.CrashHelper.csproj" />
  </ItemGroup>

</Project>
