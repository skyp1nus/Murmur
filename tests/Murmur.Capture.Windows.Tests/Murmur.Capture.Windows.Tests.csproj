<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(MurmurWindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>$(MurmurWindowsMinVersion)</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Murmur.Capture.Windows.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Same as Murmur.Core.Tests: the app ships as Native AOT (no JIT tiering). With tiering on, a tier-up can allocate
      on the thread that triggers it, which the zero-allocation assertions (capture pump, sample conversion, playback
      mixer, GPU frame copier) would blame on our code — seen as flaky failures under parallel test load.
    -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The MP4 reader of scripts/check-recording.ps1: the recorded files must pass the same duration check. -->
    <Compile Include="..\..\scripts\MurmurMp4Scan.cs" Link="MurmurMp4Scan.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Murmur.Capture.Windows\Murmur.Capture.Windows.csproj" />
  </ItemGroup>

</Project>
